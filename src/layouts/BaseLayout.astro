---
const {
  title = "Visio Nova Mundi",
  description = "Visio Nova Mundi CIC — Innovation, research and systems reform for long-term community impact.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} | Visio Nova Mundi` : "Visio Nova Mundi CIC"}</title>
  <meta name="description" content={description} />
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="bg-glow"></div>

  <header class="nav">
    <div class="container">
      <a class="brand" href="/" aria-label="Visio Nova Mundi home">
        <span class="brand-mark" aria-hidden="true">
          <span class="brand-star star-one"></span>
          <span class="brand-star star-two"></span>
          <span class="brand-star star-three"></span>
          <span class="brand-star star-four"></span>
          <span class="brand-star star-core"></span>
        </span>
        <span class="brand-name">Visio Nova Mundi</span>
      </a>

      <button
        class="mobile-nav-toggle"
        data-mobile-nav-toggle
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span class="mobile-nav-icon" aria-hidden="true"></span>
        <span data-mobile-nav-label>Menu</span>
      </button>

      <nav id="primary-navigation" data-site-nav aria-label="Main navigation">
        <span class="nav-indicator" aria-hidden="true"></span>
        <a href="/">Home</a>
        <a href="/impact">Impact</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/projects">Projects</a>
        <a href="/unity-house">Unity House</a>
        <a href="/timeline">Timeline</a>
        <a href="/circular-justice">Circular Justice</a>
        <a href="/tree-of-life">Tree of Life</a>
        <a href="/project-clandestinus">Clandestinus</a>
        <a href="/admintrace">AdminTrace</a>
        <a href="/tradevault">TradeVault</a>
        <a href="/contact" class="nav-btn">Contact</a>
      </nav>
    </div>
  </header>

  <main class="container" id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer class="footer">
    © {new Date().getFullYear()} Visio Nova Mundi CIC
  </footer>

<style>
  :root {
    --bg: #f8fafc;
    --glass: rgba(255, 255, 255, 0.78);
    --border: rgba(15, 23, 42, 0.14);
    --text: #0f172a;
    --muted: #334155;
    --primary: #2563eb;
    --radius: 22px;
  }

  * {
    box-sizing: border-box;
  }

  :where(a, button, input, textarea, select):focus-visible {
    outline: 3px solid #0f766e;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(15, 118, 110, 0.22);
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  /* Samsung-style soft glow background */
  .bg-glow {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(37, 99, 235, 0.18), transparent 45%),
      radial-gradient(circle at 80% 30%, rgba(16, 185, 129, 0.15), transparent 45%),
      radial-gradient(circle at 50% 80%, rgba(59, 130, 246, 0.12), transparent 50%);
    z-index: -1;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  /* Navigation */
  .nav {
    /* Navigation should never cover reading content: it scrolls with every layout. */
    position: static;
    top: auto;
    backdrop-filter: blur(14px);
    background: var(--glass);
    border-bottom: 1px solid var(--border);
    z-index: 10;
  }

  .nav .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 10px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 5px 12px 5px 5px;
    border: 1px solid rgba(37, 99, 235, 0.14);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    background:
      radial-gradient(circle at 12% 52%, rgba(16, 185, 129, 0.25), transparent 29%),
      radial-gradient(circle at 48% 22%, rgba(37, 99, 235, 0.22), transparent 34%),
      radial-gradient(circle at 90% 72%, rgba(16, 185, 129, 0.18), transparent 31%),
      linear-gradient(115deg, rgba(255, 255, 255, 0.68), rgba(231, 245, 255, 0.58), rgba(238, 255, 250, 0.62));
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .brand::before,
  .brand::after {
    content: "";
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .brand::before {
    inset: 0;
    opacity: 0.52;
    background-image:
      radial-gradient(circle at 12% 35%, rgba(255, 255, 255, 0.95) 0 1px, transparent 1.7px),
      radial-gradient(circle at 34% 72%, rgba(255, 255, 255, 0.72) 0 1px, transparent 1.6px),
      radial-gradient(circle at 69% 24%, rgba(255, 255, 255, 0.86) 0 1px, transparent 1.8px),
      radial-gradient(circle at 91% 68%, rgba(255, 255, 255, 0.78) 0 1px, transparent 1.7px);
    animation: vnm-galaxy-drift 10s ease-in-out infinite alternate;
  }

  .brand::after {
    inset: -85% -18%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 25% 58%, rgba(16, 185, 129, 0.18), transparent 28%),
      radial-gradient(ellipse at 57% 34%, rgba(37, 99, 235, 0.18), transparent 34%),
      radial-gradient(ellipse at 84% 66%, rgba(16, 185, 129, 0.14), transparent 25%);
    filter: blur(8px);
    transform: scale(0.86) rotate(-5deg);
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .brand-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    overflow: visible;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0 7%, rgba(16, 185, 129, 0.36) 21%, rgba(37, 99, 235, 0.25) 48%, transparent 72%);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .brand-mark::before {
    content: "";
    position: absolute;
    width: 29px;
    height: 11px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 50%;
    transform: rotate(-26deg);
    box-shadow: 0 0 12px rgba(37, 99, 235, 0.28);
  }

  .brand-mark::after {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1px solid rgba(16, 185, 129, 0.5);
    border-radius: 50%;
    transform: rotate(36deg) scaleY(0.46);
  }

  .brand-star {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.95), 0 0 15px rgba(37, 99, 235, 0.38);
    animation: vnm-star-twinkle 2.8s ease-in-out infinite;
  }

  .star-one { width: 3px; height: 3px; top: 5px; right: 4px; }
  .star-two { width: 2px; height: 2px; bottom: 5px; left: 5px; animation-delay: -0.9s; }
  .star-three { width: 2px; height: 2px; top: 9px; left: 3px; animation-delay: -1.6s; }
  .star-four { width: 2px; height: 2px; right: 6px; bottom: 8px; animation-delay: -2.2s; }
  .star-core { width: 5px; height: 5px; animation-duration: 2.2s; }

  .brand:hover .brand-mark,
  .brand:focus-visible .brand-mark,
  .brand:active .brand-mark {
    transform: scale(1.16) rotate(7deg);
    filter: drop-shadow(0 0 10px rgba(37, 99, 235, 0.5));
  }

  .brand:hover,
  .brand:focus-visible,
  .brand:active {
    border-color: rgba(16, 185, 129, 0.36);
    box-shadow: 0 8px 22px rgba(37, 99, 235, 0.13);
  }

  .brand:hover::after,
  .brand:focus-visible::after,
  .brand:active::after {
    transform: scale(1.08) rotate(5deg);
    opacity: 0.95;
  }

  .brand:hover .brand-star,
  .brand:focus-visible .brand-star,
  .brand:active .brand-star {
    animation: vnm-star-bloom 0.7s ease-out both;
  }

  .brand-name {
    position: relative;
    z-index: 1;
    white-space: nowrap;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 18px;
    color: #102741;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.72), 0 0 14px rgba(37, 99, 235, 0.2);
  }

  nav {
    display: flex;
    gap: 24px;
    align-items: center;
    position: relative;
  }

  nav a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 10px 12px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--muted);
    font-size: 16px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  nav a[aria-current="page"] {
    font-weight: 700;
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(16, 185, 129, 0.15));
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.28s ease, width 0.28s ease, height 0.28s ease, opacity 0.2s ease;
  }

  .nav-btn {
    font-weight: 600;
  }

  .mobile-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 88px;
    min-height: 44px;
    margin-left: auto;
    padding: 0 14px;
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 999px;
    color: #102741;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.92), rgba(232, 246, 255, 0.9), rgba(238, 255, 250, 0.92));
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.09);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .mobile-nav-icon {
    position: relative;
    display: inline-block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-nav-icon::before,
  .mobile-nav-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-nav-icon::before { top: -5px; }
  .mobile-nav-icon::after { top: 5px; }

  /* Glass Cards */
  .card {
    background: var(--glass);
    backdrop-filter: blur(16px);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .motion-ready [data-tilt-card] {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --tilt-glow-x: 50%;
    --tilt-glow-y: 50%;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transform-style: preserve-3d;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .motion-ready [data-tilt-card]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--tilt-glow-x) var(--tilt-glow-y), rgba(255, 255, 255, 0.3), transparent 36%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .motion-ready [data-tilt-card] > * {
    position: relative;
    z-index: 1;
  }

  .motion-ready [data-tilt-card]:hover,
  .motion-ready [data-tilt-card]:focus-within {
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-4px) scale(1.008);
    box-shadow: 0 18px 44px rgba(8, 34, 45, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.64);
    border-color: rgba(15, 118, 110, 0.32);
  }

  .motion-ready [data-tilt-card]:hover::before,
  .motion-ready [data-tilt-card]:focus-within::before {
    opacity: 1;
  }

  /* Buttons */
  .btn {
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid rgba(37, 99, 235, 0.25);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(16, 185, 129, 0.15));
    backdrop-filter: blur(8px);
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    transition: all 0.25s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.2);
  }

  .footer {
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
    font-size: 14px;
  }

  @keyframes vnm-galaxy-drift {
    from { transform: translateX(-3px); opacity: 0.38; }
    to { transform: translateX(3px); opacity: 0.7; }
  }

  @keyframes vnm-star-twinkle {
    0%, 100% { transform: scale(0.72); opacity: 0.55; }
    50% { transform: scale(1.18); opacity: 1; }
  }

  @keyframes vnm-star-bloom {
    0% { transform: scale(0.8); opacity: 0.65; }
    55% { transform: scale(2.7); opacity: 1; }
    100% { transform: scale(1.15); opacity: 0.92; }
  }

  @media (max-width: 768px) {
    .nav .container {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 12px 16px 10px;
    }

    nav {
      width: 100%;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 4px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      scroll-snap-type: x proximity;
    }

    nav a {
      flex: 0 0 auto;
      font-size: 14px;
      scroll-snap-align: start;
    }

    .brand-name {
      font-size: 16px;
    }

  }

  @media (max-width: 360px) {
    .brand {
      gap: 7px;
      padding-right: 7px;
    }

    .brand-name {
      font-size: 15px;
    }
  }

  @media (max-width: 700px) {
    .nav {
      position: relative;
      z-index: 20;
    }

    .nav .container {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: nowrap;
      gap: 12px;
      padding: 12px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style is:global>
  .skip-link { position: absolute; top: -100px; left: 16px; z-index: 100; padding: 12px; background: white; color: #0f172a; }
  .skip-link:focus { top: 12px; }
  main { overflow-wrap: anywhere; }
  .nav .container { flex-wrap: nowrap; gap: 12px; }
  nav[data-site-nav] { flex: 1 1 auto; justify-content: flex-end; flex-wrap: nowrap; gap: 4px; }
  @media (min-width: 1101px) {
    header.nav nav[data-site-nav] { gap: 2px; }
    header.nav nav[data-site-nav] > a { flex: 0 0 auto; padding: 8px 5px; font-size: 14px; white-space: nowrap; }
  }
  main .meta, main .top { flex-wrap: wrap; }
  main .note, main .eyebrow, main .tag, main .status, main .label, main .statusPill { font-size: .875rem; }
  .vnm-glass-card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background-image: linear-gradient(135deg, rgba(37,99,235,.11), rgba(16,185,129,.09));
    background-color: var(--glass);
    border: 1px solid rgba(37,99,235,.2);
    box-shadow: 0 10px 40px rgba(37,99,235,.12), inset 0 1px 0 rgba(255,255,255,.64);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
    backdrop-filter: blur(20px) saturate(130%);
    color: var(--text);
  }
  .vnm-glass-card h1, .vnm-glass-card h2, .vnm-glass-card h3 { color: var(--text); }
  .vnm-glass-card p { color: var(--muted); }
  .vnm-tech-badge {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #1d4ed8;
    background: rgba(37,99,235,.07);
    border: 1px solid rgba(37,99,235,.22);
    padding: 4px 10px;
    border-radius: 6px;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  @media (max-width: 1300px) {
    .nav .container { flex-wrap: wrap; }
    nav[data-site-nav] { flex-basis: 100%; justify-content: flex-start; flex-wrap: wrap; }
  }
  @media (max-width: 768px) { nav[data-site-nav] { flex-basis: auto; overflow: visible; } }
  @media (max-width: 700px) {
    header.nav {
      position: relative;
      z-index: 20;
    }

    .nav .container {
      position: relative;
    }

    .nav .container > .mobile-nav-toggle { display: inline-flex; }

    .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-icon { background: transparent; }
    .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-icon::before { top: 0; transform: rotate(45deg); }
    .mobile-nav-toggle[aria-expanded="true"] .mobile-nav-icon::after { top: 0; transform: rotate(-45deg); }

    nav[data-site-nav] {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 16px;
      right: 16px;
      z-index: 21;
      width: auto;
      max-height: min(70vh, 34rem);
      overflow-x: hidden;
      overflow-y: auto;
      flex-basis: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
      padding: 8px;
      border: 1px solid rgba(37, 99, 235, 0.2);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.98);
      box-shadow: 0 18px 44px rgba(15, 23, 42, 0.18);
      -webkit-backdrop-filter: blur(18px) saturate(135%);
      backdrop-filter: blur(18px) saturate(135%);
    }

    nav[data-site-nav][data-open="true"] { display: grid; }
    nav[data-site-nav] > .nav-indicator { display: none; }

    nav[data-site-nav] > a {
      min-width: 0;
      min-height: 44px;
      justify-content: flex-start;
      padding: 10px;
      border-radius: 12px;
      font-size: 14px;
      line-height: 1.25;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    nav[data-site-nav] > a:hover,
    nav[data-site-nav] > a:focus-visible,
    nav[data-site-nav] > a[aria-current="page"] {
      background: linear-gradient(120deg, rgba(37, 99, 235, 0.09), rgba(16, 185, 129, 0.09));
    }

    nav[data-site-nav] > a.nav-btn {
      grid-column: 1 / -1;
      justify-content: center;
      margin-top: 4px;
      border: 1px solid rgba(37, 99, 235, 0.18);
    }
  }
  .bg-glow {
    background-size: 125% 125%;
    animation: vnm-ambient-drift 18s ease-in-out infinite alternate;
  }

  main {
    animation: vnm-page-arrive 0.55s ease-out both;
  }

  .motion-ready .vnm-reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.56s ease-out var(--vnm-reveal-delay, 0ms),
      transform 0.56s cubic-bezier(0.22, 1, 0.36, 1) var(--vnm-reveal-delay, 0ms);
  }

  .motion-ready .vnm-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .motion-ready .flow > div,
  .motion-ready .pilotFlow > div,
  .motion-ready .branchGrid span {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .motion-ready .flow > div:hover,
  .motion-ready .pilotFlow > div:hover,
  .motion-ready .branchGrid span:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 118, 110, 0.3);
    box-shadow: 0 12px 26px rgba(15, 118, 110, 0.1);
  }

  .motion-ready .card,
  .motion-ready .smallCard,
  .motion-ready .pathways article {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .motion-ready .card::after,
  .motion-ready .smallCard::after,
  .motion-ready .pathways article::after {
    content: "";
    position: absolute;
    inset: -35%;
    z-index: 0;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.78) 50%, transparent 58%);
    opacity: 0;
    transform: translateX(-42%);
    pointer-events: none;
  }

  .motion-ready .card > *,
  .motion-ready .smallCard > *,
  .motion-ready .pathways article > * {
    position: relative;
    z-index: 1;
  }

  .motion-ready .card:hover::after,
  .motion-ready .smallCard:hover::after,
  .motion-ready .pathways article:hover::after {
    opacity: 1;
    animation: vnm-card-sheen 0.85s ease-out both;
  }

  .motion-ready .tag,
  .motion-ready .label,
  .motion-ready .statusPill,
  .motion-ready .pathways span {
    animation: vnm-label-breathe 3.8s ease-in-out infinite;
  }

  .motion-ready .card a,
  .motion-ready .link,
  .motion-ready .btn {
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background-position 0.35s ease;
  }

  .motion-ready .card a:hover,
  .motion-ready .link:hover,
  .motion-ready .btn:hover {
    transform: translateX(3px);
  }

  .motion-ready .btn:hover {
    background-size: 170% 170%;
    background-position: 100% 0;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.14);
  }

  .motion-ready .flowArrow {
    animation: vnm-flow-nudge 1.7s ease-in-out infinite;
  }

  @keyframes vnm-ambient-drift {
    from {
      background-position: 20% 20%, 80% 30%, 50% 80%;
    }
    to {
      background-position: 26% 15%, 74% 36%, 55% 74%;
    }
  }

  @keyframes vnm-page-arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes vnm-card-sheen {
    from { transform: translateX(-42%); }
    to { transform: translateX(42%); }
  }

  @keyframes vnm-label-breathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(15, 118, 110, 0); }
    50% { box-shadow: 0 0 0 5px rgba(15, 118, 110, 0.06); }
  }

  @keyframes vnm-flow-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-glow,
    main,
    .motion-ready .vnm-reveal,
    .motion-ready .flow > div,
    .motion-ready .pilotFlow > div,
    .motion-ready .branchGrid span {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }

    .motion-ready .card::after,
    .motion-ready .smallCard::after,
    .motion-ready .pathways article::after {
      display: none;
    }

    .motion-ready .vnm-reveal {
      opacity: 1;
    }
  }
</style>

<script>
  const navigation = document.querySelector<HTMLElement>("[data-site-nav]");

  if (navigation) {
    const indicator = navigation.querySelector<HTMLElement>(".nav-indicator");
    const links = Array.from(navigation.querySelectorAll<HTMLAnchorElement>("a"));
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
    const currentLink = links.find((link) => {
      const linkPath = new URL(link.href).pathname.replace(/\/$/, "") || "/";
      return linkPath === currentPath;
    });

    const positionIndicator = (link?: HTMLAnchorElement) => {
      if (!indicator || !link) return;

      const navigationBounds = navigation.getBoundingClientRect();
      const linkBounds = link.getBoundingClientRect();
      indicator.style.width = `${linkBounds.width}px`;
      indicator.style.height = `${linkBounds.height}px`;
      indicator.style.transform = `translate(${linkBounds.left - navigationBounds.left}px, ${linkBounds.top - navigationBounds.top}px)`;
      indicator.style.opacity = "1";
    };

    if (currentLink) {
      currentLink.setAttribute("aria-current", "page");
    }

    const resetIndicator = () => positionIndicator(currentLink);
    requestAnimationFrame(resetIndicator);
    window.addEventListener("resize", resetIndicator);

    links.forEach((link) => {
      link.addEventListener("pointerenter", () => positionIndicator(link));
      link.addEventListener("pointerdown", () => positionIndicator(link));
      link.addEventListener("focus", () => positionIndicator(link));
    });

    navigation.addEventListener("pointerleave", resetIndicator);
  }

  const mobileNavToggle = document.querySelector<HTMLButtonElement>("[data-mobile-nav-toggle]");
  const mobileNavQuery = window.matchMedia("(max-width: 700px)");

  if (navigation && mobileNavToggle) {
    const mobileNavLabel = mobileNavToggle.querySelector<HTMLElement>("[data-mobile-nav-label]");
    const header = mobileNavToggle.closest<HTMLElement>("header");
    const isMenuOpen = () => mobileNavToggle.getAttribute("aria-expanded") === "true";

    const setMenuOpen = (open: boolean, restoreFocus = false) => {
      navigation.dataset.open = String(open);
      mobileNavToggle.setAttribute("aria-expanded", String(open));
      mobileNavToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      if (mobileNavLabel) mobileNavLabel.textContent = open ? "Close" : "Menu";
      if (restoreFocus) mobileNavToggle.focus();
    };

    mobileNavToggle.addEventListener("click", () => {
      const wasOpen = isMenuOpen();
      setMenuOpen(!wasOpen, wasOpen);
    });

    navigation.addEventListener("click", (event) => {
      const target = event.target;
      if (mobileNavQuery.matches && target instanceof Element && target.closest("a")) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNavQuery.matches && isMenuOpen()) {
        setMenuOpen(false, true);
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!mobileNavQuery.matches || !isMenuOpen() || !(target instanceof Node)) return;
      if (navigation.contains(target) || mobileNavToggle.contains(target)) return;
      setMenuOpen(false, navigation.contains(document.activeElement));
    });

    header?.addEventListener("focusout", (event) => {
      const nextTarget = event.relatedTarget;
      if (!mobileNavQuery.matches || !isMenuOpen()) return;
      if (!(nextTarget instanceof Node) || !header.contains(nextTarget)) setMenuOpen(false);
    });

    mobileNavQuery.addEventListener("change", () => setMenuOpen(false));
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!prefersReducedMotion.matches) {
    document.documentElement.classList.add("motion-ready");

    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>([
      "main > section",
      "main > .heroBlock",
      "main > .controlNote",
      "main .card",
      "main .smallCard",
      "main .flow > div",
      "main .pilotFlow > div",
      "main .branchGrid span",
    ].join(", ")));

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -32px" });

    revealTargets.forEach((element, index) => {
      element.classList.add("vnm-reveal");
      element.style.setProperty("--vnm-reveal-delay", `${Math.min(index % 6, 5) * 45}ms`);
      revealObserver.observe(element);
    });

    if (window.matchMedia("(pointer: fine)").matches) {
      const tiltTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-tilt-card]"));

      tiltTargets.forEach((element) => {
        const resetTilt = () => {
          element.style.setProperty("--tilt-x", "0deg");
          element.style.setProperty("--tilt-y", "0deg");
          element.style.setProperty("--tilt-glow-x", "50%");
          element.style.setProperty("--tilt-glow-y", "50%");
        };

        element.addEventListener("pointermove", (event) => {
          const bounds = element.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          element.style.setProperty("--tilt-x", `${Math.max(-1, Math.min(1, y)) * -4}deg`);
          element.style.setProperty("--tilt-y", `${Math.max(-1, Math.min(1, x)) * 5}deg`);
          element.style.setProperty("--tilt-glow-x", `${(x + 0.5) * 100}%`);
          element.style.setProperty("--tilt-glow-y", `${(y + 0.5) * 100}%`);
        });

        element.addEventListener("pointerleave", resetTilt);
        element.addEventListener("blur", resetTilt, true);
      });
    }
  }
</script>

</body>
</html>
