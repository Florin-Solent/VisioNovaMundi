---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusGovernance from "../components/StatusGovernance.astro";

const benefits = [
  {
    number: "01",
    title: "Move more easily",
    text: "Designed around the reality of moving equipment between jobs and working areas.",
  },
  {
    number: "02",
    title: "Keep tools organised",
    text: "Help keep frequently used equipment together and easier to access.",
  },
  {
    number: "03",
    title: "Work more efficiently",
    text: "Reduce unnecessary movement and time spent searching for equipment.",
  },
  {
    number: "04",
    title: "Designed from experience",
    text: "Product concepts informed by real construction and decorating workflows.",
  },
];
---

<BaseLayout
  title="TradeVault"
  description="TradeVault is a founder-led product innovation venture being developed alongside the wider Visio Nova Mundi ecosystem, exploring practical tools for painters, decorators and construction professionals."
>
  <section class="tradevaultHero">
    <div class="heroCopy">
      <p class="eyebrow">Founder-led venture · In development</p>
      <h1>TradeVault</h1>
      <p class="heroMessage">Practical tools designed around real working life.</p>
      <p class="lead">Product concepts for painters, decorators and construction professionals.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current focus</p>
      <h2>Painter Pro pre-prototype development</h2>
      <p>The first TradeVault product concept is being shaped around everyday equipment, mobility and workflow needs.</p>
      <span class="stagePill">Pre-prototype development</span>
    </aside>
  </section>

  <StatusGovernance stage="Pre-prototype development" operator="Separate founder-led venture; trading entity and product-liability arrangements require confirmation." delivery="Painter Pro concept validation; not a product currently available for sale." funding="Separate ownership, IP and finances; CIC grants or sponsorship do not automatically finance it." boundary="TradeVault is not a CIC programme or commissioned CIC service. Future manufacturing and sales need their own responsible operator and agreements." />

  <section class="section introSection" aria-labelledby="about-tradevault">
    <div class="sectionHead">
      <p class="eyebrow">What is TradeVault?</p>
      <h2 id="about-tradevault">Practical ideas for the realities of working in the trades.</h2>
      <p>TradeVault is a founder-led product innovation project exploring practical storage, mobility and workflow solutions for people working in the trades. The aim is to design products around the realities of moving between jobs, transporting equipment and keeping essential tools organised and accessible.</p>
    </div>
  </section>

  <section class="section painterSection" aria-labelledby="painter-pro">
    <article class="painterCard">
      <div class="painterCopy">
        <p class="eyebrow">Pre-prototype development — Painter Pro</p>
        <h2 id="painter-pro">A mobile storage and workflow concept for painters and decorators.</h2>
        <p>TradeVault Painter Pro is being developed as a professional mobile storage and workflow concept for painters and decorators. The aim is to make it easier to transport, organise and access the tools and materials needed throughout a working day.</p>
        <p class="conceptNote">This is a developing concept, not a product currently available for sale. Its final design and features remain subject to validation.</p>
      </div>
      <span class="productStatus">Pre-prototype development</span>
    </article>
  </section>

  <section class="section benefitsSection" aria-labelledby="built-around-trade">
    <div class="sectionHead">
      <p class="eyebrow">Built around the trade</p>
      <h2 id="built-around-trade">Useful by design. Grounded in the working day.</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section futureSection" aria-labelledby="future-range">
    <div class="sectionHead">
      <p class="eyebrow">Future TradeVault range</p>
      <h2 id="future-range">One practical starting point, with room to grow.</h2>
      <p>Painter Pro is intended to be the starting point for a wider family of practical products for construction and skilled trades. Future concepts may explore storage, transport and workflow challenges faced by other professionals on site, with individual products announced only as they move through validation.</p>
    </div>
  </section>

  <section class="section developmentSection" aria-labelledby="development-approach">
    <div>
      <p class="eyebrow">Development approach</p>
      <h2 id="development-approach">Thoughtful progress, step by step.</h2>
      <p>TradeVault products are being developed through staged concept validation, prototyping and professional feedback before manufacturing decisions are made.</p>
    </div>
    <a class="btn primary" href="/timeline">View the project timeline</a>
  </section>

  <section class="closingNote">
    <p class="eyebrow">The long-term vision</p>
    <p>The longer-term ambition is to develop a family of practical products that help tradespeople organise, move and use their equipment more effectively.</p>
    <p class="closingLine">Designed around the job, not around the toolbox.</p>
  </section>

  <style>
    .tradevaultHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 9px;color:#b45309;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:850}
    h1{margin:0 0 10px;color:var(--text);font-size:clamp(44px,7vw,68px);letter-spacing:-.045em}
    .heroMessage{margin:0 0 12px;color:var(--text);font-size:clamp(22px,3vw,30px);font-weight:750;letter-spacing:-.025em;line-height:1.25}
    .lead{margin:0;max-width:70ch;color:var(--muted);font-size:18px;line-height:1.8}
    .stageCard,.painterCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:20px;background:linear-gradient(135deg,rgba(245,158,11,.09),rgba(148,163,184,.12));border-color:rgba(180,83,9,.2)}
    .stageLabel{margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:12px;font-weight:850}
    .stageCard h2{margin:0 0 9px;color:var(--text);font-size:21px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.7}
    .stagePill,.productStatus{display:inline-flex;align-items:center;padding:7px 10px;border:1px solid rgba(180,83,9,.24);border-radius:999px;background:rgba(245,158,11,.08);color:#92400e;font-size:12px;font-weight:850}
    .stagePill{margin-top:14px}
    .ownershipNote{margin:22px 0 0;padding:13px 16px;border-left:3px solid #d97706;background:rgba(245,158,11,.07);color:var(--muted);line-height:1.7}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .sectionHead>p:not(.eyebrow),.developmentSection>div>p:not(.eyebrow){margin:0;max-width:82ch;color:var(--muted);line-height:1.8}
    .painterCard{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding:22px;background:linear-gradient(135deg,rgba(245,158,11,.055),rgba(148,163,184,.06) 70%,white)}
    .painterCopy{max-width:76ch}
    .painterCopy h2{margin:0 0 10px;color:var(--text);font-size:26px;letter-spacing:-.025em;line-height:1.3}
    .painterCopy>p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.8}
    .painterCopy .conceptNote{margin-top:12px;color:#475569;font-size:14px}
    .productStatus{white-space:nowrap}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:17px}
    .benefitCard{min-height:166px;padding:19px;background:linear-gradient(135deg,rgba(245,158,11,.045),rgba(148,163,184,.055))}
    .benefitNumber{display:grid;place-items:center;width:34px;height:34px;margin-bottom:12px;border:1px solid rgba(180,83,9,.2);border-radius:50%;background:rgba(245,158,11,.08);color:#92400e;font-size:12px;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:18px;letter-spacing:-.015em}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .futureSection{padding:21px 22px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(148,163,184,.07),rgba(245,158,11,.055))}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;padding:22px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(245,158,11,.07),rgba(148,163,184,.07))}
    .developmentSection>div{max-width:76ch}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(180,83,9,.24);border-radius:999px;background:linear-gradient(135deg,rgba(245,158,11,.11),rgba(148,163,184,.12));color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn:hover{text-decoration:none;border-color:rgba(180,83,9,.4)}
    .closingNote{margin-top:20px;padding:18px 20px;border-left:3px solid #d97706;background:rgba(245,158,11,.07)}
    .closingNote .eyebrow{margin-bottom:7px}
    .closingNote>p:not(.eyebrow){margin:0;color:var(--text);font-size:19px;font-weight:650;line-height:1.7}
    .closingNote .closingLine{margin-top:9px;font-size:21px;font-weight:800;letter-spacing:-.015em}
    @media(max-width:800px){.tradevaultHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.painterCard{flex-direction:column;padding:18px}.painterCopy h2{font-size:22px}.productStatus{white-space:normal}.futureSection{padding:18px}.developmentSection{padding:18px}.btn{width:100%;white-space:normal;text-align:center}.closingNote{padding:16px}.closingNote>p:not(.eyebrow){font-size:17px}.closingNote .closingLine{font-size:19px}}
  </style>
</BaseLayout>
