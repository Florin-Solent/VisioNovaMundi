---
import BaseLayout from "../layouts/BaseLayout.astro";

const benefits = [
  {
    number: "01",
    title: "A simpler routine",
    text: "Exploring whether several everyday toilet-care tasks could fit into one convenient routine.",
  },
  {
    number: "02",
    title: "Everyday care",
    text: "Considering freshness, odour management and routine bowl care without making unvalidated performance claims.",
  },
  {
    number: "03",
    title: "Less switching",
    text: "Intended to reduce the need to move between several everyday toilet-care products.",
  },
  {
    number: "04",
    title: "Validation first",
    text: "Any future formulation, safety and performance claims would need professional validation before release.",
  },
];
---

<BaseLayout
  title="OneLoo Total"
  description="OneLoo Total is a founder-led household-care concept currently in early concept and feasibility development."
>
  <section class="conceptHero">
    <div class="heroCopy">
      <p class="eyebrow">Founder-led concept · Early development</p>
      <h1>ONELOO TOTAL</h1>
      <p class="heroMessage">One product. A simpler toilet-care routine.</p>
      <p class="lead">OneLoo Total is currently in early concept and feasibility development, exploring whether several everyday toilet-care tasks could be brought together into one simpler product and routine. The concept remains in development and would require professional formulation, safety and performance validation before any release.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current stage</p>
      <h2>Exploring a more convenient routine</h2>
      <p>The concept is at an early stage. No formulation or product performance is presented as proven.</p>
      <span class="stagePill">Early development</span>
    </aside>
  </section>

  <p class="ownershipNote">Founder-led innovation concept developed alongside the wider Visio Nova Mundi ecosystem.</p>

  <section class="section introSection" aria-labelledby="routine-heading">
    <div class="sectionHead">
      <p class="eyebrow">The everyday routine</p>
      <h2 id="routine-heading">Could toilet care feel simpler?</h2>
      <p>Everyday household care can involve several products and steps. OneLoo Total explores whether a simpler routine could bring selected toilet-care tasks together in one convenient concept.</p>
    </div>
  </section>

  <section class="section benefitsSection" aria-labelledby="benefits-heading">
    <div class="sectionHead">
      <p class="eyebrow">What the concept explores</p>
      <h2 id="benefits-heading">Designed around everyday convenience</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard vnm-glass-card">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section futureSection" aria-labelledby="future-heading">
    <div class="sectionHead">
      <p class="eyebrow">The wider vision</p>
      <h2 id="future-heading">A clearer approach to toilet care</h2>
      <p>The ambition is to explore a more convenient everyday routine. Any future product or claim would depend on professional formulation, safety and performance validation.</p>
    </div>
  </section>

  <section class="developmentSection">
    <div>
      <p class="eyebrow">In development</p>
      <h2>Validation comes before release.</h2>
      <p>OneLoo Total is a developing concept, not a product currently available for sale.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href="/timeline">View the project timeline</a>
      <a class="btn" href="/projects">Back to Projects</a>
    </div>
  </section>

  <style>
    .conceptHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 9px;color:#0f766e;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:850}
    h1{margin:0 0 10px;color:var(--text);font-size:clamp(42px,7vw,66px);letter-spacing:-.045em}
    .heroMessage{margin:0 0 13px;color:var(--text);font-size:clamp(22px,3vw,30px);font-weight:750;letter-spacing:-.025em;line-height:1.25}
    .lead{margin:0;max-width:76ch;color:var(--muted);font-size:18px;line-height:1.8}
    .stageCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:20px;background:linear-gradient(135deg,rgba(16,185,129,.09),rgba(37,99,235,.07));border-color:rgba(15,118,110,.2)}
    .stageLabel{margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:12px;font-weight:850}
    .stageCard h2{margin:0 0 9px;color:var(--text);font-size:21px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.7}
    .stagePill{display:inline-flex;margin-top:14px;padding:7px 10px;border:1px solid rgba(15,118,110,.22);border-radius:999px;background:rgba(16,185,129,.08);color:#0f766e;font-size:12px;font-weight:850}
    .ownershipNote{margin:22px 0 0;padding:13px 16px;border-left:3px solid #0f766e;background:rgba(16,185,129,.07);color:var(--muted);line-height:1.7}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .sectionHead>p:not(.eyebrow),.developmentSection>div>p:not(.eyebrow){margin:0;max-width:82ch;color:var(--muted);line-height:1.8}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
    .benefitCard{min-height:170px;padding:20px;background:linear-gradient(135deg,rgba(16,185,129,.045),rgba(37,99,235,.045))}
    .benefitNumber{display:grid;place-items:center;width:34px;height:34px;margin-bottom:13px;border:1px solid rgba(15,118,110,.2);border-radius:50%;background:rgba(16,185,129,.08);color:#0f766e;font-size:12px;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:18px;letter-spacing:-.015em}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .futureSection,.developmentSection{padding:21px 22px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(16,185,129,.06),rgba(37,99,235,.05))}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-top:20px}
    .developmentSection>div:first-child{max-width:76ch}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(15,118,110,.22);border-radius:999px;background:white;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn.primary{background:linear-gradient(135deg,rgba(16,185,129,.12),rgba(37,99,235,.1))}
    .btn:hover{text-decoration:none;border-color:rgba(15,118,110,.4)}
    @media(max-width:800px){.conceptHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.futureSection,.developmentSection{padding:18px}.actions{flex-direction:column}.btn{width:100%;white-space:normal;text-align:center}}
  </style>
</BaseLayout>
