---
import BaseLayout from "../layouts/BaseLayout.astro";
import routeMap from "../data/journey-map.json";
import journeyImageVariants from "../data/journey-image-variants.json";

const responsiveImage = (src: string) => {
  const image = journeyImageVariants[src as keyof typeof journeyImageVariants];
  return image
    ? { src: image.src, srcset: image.variants.map((variant) => `${variant.src} ${variant.width}w`).join(", "), sizes: "(max-width: 760px) 100vw, 82vw" }
    : { src };
};

// Short captions sit on the photographs; the full provenance stays in each "Archive note".
const img = "/images/journey";
const chapters = [
  {
    id: "journey-2012", coord: [45.75, 21.23], years: "2012", countries: "ro", continents: "europe",
    year: "2012", region: "Caraș-Severin · Timiș", place: "Romania",
    tagline: "Where the journey began",
    text: "Clear rivers, limestone gorges and the first outdoor days around Timișoara and Caraș-Severin: a first dated chapter in the story.",
    layout: "full",
    media: [{ src: `${img}/cinematic/romania-stream-wide.webp`, alt: "A clear stream winding through a wooded limestone gorge in Romania", cap: "Romania · album dated 22 October 2012", pos: "center 55%" }],
  },
  {
    id: "journey-2013", coord: [46.25, 20.15], years: "2013", countries: "hu", continents: "europe",
    year: "2013", region: "Hungary", place: "Szeged",
    tagline: "A first international album",
    text: "A late-summer visit to Szeged, on the banks of the Tisza.",
    layout: "panorama",
    media: [{ src: `${img}/editorial/szeged-garden-2013-scenery.webp`, alt: "A flower garden in Szeged, photographed from close range", cap: "Szeged · photographed 30 August 2013", pos: "center 60%" }],
    contexts: [{ title: "City context", text: "After the 1879 Great Flood, residents pledged to build Szeged’s Votive Church. This is city-history context; it does not identify any particular photograph.", href: "https://szegedtourism.hu/en/votive-church-2/" }],
  },
  {
    id: "journey-2014", coord: [44.85, 21.75], years: "2014", countries: "ro gb", continents: "europe",
    year: "2014", region: "Romania · United Kingdom", place: "Open country",
    tagline: "A wider horizon",
    text: "Rolling hills above Cărbunari and Șopotu Nou, and, the same year, a remembered visit to the Tower of London.",
    layout: "split",
    media: [{ src: `${img}/cinematic/carbunari-wide.webp`, alt: "Rolling hills and open countryside in Romania", cap: "Cărbunari–Șopotu Nou · photographed 30 August 2014", pos: "center 50%" }],
  },
  {
    id: "journey-2016", coord: [48.4, 9.99], years: "2016 2017", countries: "de", continents: "europe",
    year: "2016–17", region: "Germany", place: "Ulm",
    tagline: "A city seen from the Minster",
    text: "Ulm Minster rises over the Danube city: a civic project of more than five centuries, begun in 1377 and completed in 1890.",
    layout: "titlecard", theme: "dark",
    numerals: ["1377", "1890"],
    list: ["Ulm", "Neu-Ulm"],
    contexts: [{ title: "Ulm Minster", text: "Construction began in 1377 and the Minster was completed in 1890, a long civic project that became a defining part of Ulm’s cityscape.", href: "https://gruppen.ulm.de/entdecken/sehen-und-erleben/sehenswuerdigkeiten/historisches/muenster-ulm?accessibility_font=sm" }],
  },
  {
    id: "journey-2018", coord: [48.86, 2.35], years: "2018", countries: "fr nl de", continents: "europe",
    year: "2018", region: "France · Netherlands", place: "Paris & Amsterdam",
    tagline: "Autumn light, winter water",
    text: "Paris in November, Amsterdam in December: two cities shaped by centuries of planning, stone and water.",
    layout: "diptych",
    media: [
      { src: `${img}/cinematic/paris-wide.webp`, alt: "The upper sculpted fountain framed by autumn trees in Paris", cap: "Paris · photographed 24 November 2018", pos: "center 70%" },
      { src: `${img}/editorial/amsterdam-pond-2018-scenery.webp`, alt: "Dark water and flat stepping stones beneath winter trees in Amsterdam", cap: "Amsterdam · photographed 12 December 2018", pos: "center 50%" },
    ],
    contexts: [{ title: "Amsterdam canal ring", text: "Amsterdam’s canal ring reflects large-scale hydraulic and urban planning developed across the 16th and 17th centuries.", href: "https://whc.unesco.org/en/list/1349" }],
  },
  {
    id: "journey-2019", coord: [55.95, -3.19], years: "2019", countries: "gb ro", continents: "europe",
    year: "2019", region: "Scotland · Romania · England", place: "Three horizons",
    tagline: "Between city streets and Romanian landscapes",
    text: "Edinburgh in March, the Țara Hațegului museum and nearby landscapes in September, Cambridge in November.",
    layout: "titlecard", theme: "light",
    list: ["Edinburgh", "Hațeg", "Cambridge"],
    listMeta: ["March", "September", "November"],
  },
  {
    id: "journey-2020", coord: [51.48, -0.01], years: "2020", countries: "gb ie", continents: "europe",
    year: "2020", region: "England · Scotland · Northern Ireland · Ireland", place: "Greenwich to Dublin",
    tagline: "From the Earth installation to the winter cities",
    text: "A self portrait beside a giant Earth at the Old Royal Naval College in September; in December, Glasgow, Belfast and Dublin.",
    layout: "portrait",
    media: [{ src: `${img}/london-earth-2020.webp`, alt: "Self portrait of Florin with a large Earth installation behind him at the Old Royal Naval College in London", cap: "Greenwich, London · 6 September 2020", pos: "center 42%" }],
    list: ["London", "Glasgow", "Belfast", "Dublin"],
    listMeta: ["6 Sep", "21 Dec", "23 Dec", "27 Dec"],
  },
  {
    id: "journey-2021", coord: [51.75, -1.26], years: "2021", countries: "gb", continents: "europe",
    year: "2021", region: "United Kingdom", place: "Britain",
    tagline: "Closer journeys, carefully observed",
    text: "Oxford, the Isle of Wight, Portsmouth, Margate, Southend-on-Sea, Stonehenge and the Dorset coast.",
    layout: "titlecard", theme: "light",
    list: ["Oxford", "Stonehenge", "Dorset coast", "Margate", "Portsmouth"],
    contexts: [
      { title: "Stonehenge landscape", text: "Stonehenge and Avebury form a wider prehistoric landscape of monuments built and used between about 3700 and 1600 BCE.", href: "https://whc.unesco.org/en/list/373" },
      { title: "Dorset coast", text: "The Dorset and East Devon coast preserves rock formations spanning the Triassic, Jurassic and Cretaceous periods, about 185 million years of Earth history.", href: "https://whc.unesco.org/en/list/1029" },
    ],
  },
  {
    id: "journey-2022", coord: [55.68, 12.57], years: "2022", countries: "gb dk at si it de cz pl us", continents: "europe america_north",
    year: "2022", region: "Europe · North America", place: "Longer routes",
    tagline: "New points of reference",
    text: "Copenhagen, then a Central European journey through Austria, Slovenia and Trieste; a September post in New York; Warsaw and Prague as the year closed.",
    layout: "titlecard", theme: "dark",
    list: ["Copenhagen", "Austria", "Slovenia", "Trieste", "New York", "Warsaw", "Prague"],
  },
  {
    id: "journey-2023", coord: [33.57, -7.59], years: "2022 2023", countries: "ma tr al gr es pt cz", continents: "europe asia africa",
    year: "2022–23", region: "Africa · Asia · Europe", place: "Morocco & the Mediterranean",
    tagline: "Tiles, water and many horizons",
    text: "Morocco, Istanbul, Albania, Greece, Spain and Portugal: a year of movement around the Mediterranean world.",
    layout: "full",
    media: [{ src: `${img}/cinematic/morocco-courtyard-wide.webp`, alt: "Blue mosaic tiles and a quiet fountain pool in a Moroccan courtyard", cap: "Morocco · photographed 5 February 2023", pos: "center 50%" }],
  },
  {
    id: "journey-2024", coord: [29.98, 31.13], years: "2024", countries: "ma eg ae cy nl mt gb", continents: "europe asia africa",
    year: "2024", region: "Egypt · United Arab Emirates · Malta", place: "Ancient stone, island streets",
    tagline: "From the pyramid fields to the Mediterranean",
    text: "Morocco, Egypt and the United Arab Emirates early in the year; Cyprus, Amsterdam and Malta later on.",
    layout: "feature",
    media: [
      { src: `${img}/cinematic/giza-wide.webp`, alt: "The pyramids rising from the desert at Giza against a clear blue sky", cap: "Giza, Egypt · photographed 17 January 2024", pos: "center 70%" },
      { src: `${img}/editorial/valletta-2024-scenery.webp`, alt: "A garden fountain and classical pavilion in Valletta", cap: "Valletta, Malta · photographed 29 December 2024", pos: "center 50%" },
    ],
    contexts: [{ title: "Giza and the pyramid fields", text: "The Giza pyramids sit within the wider Memphis and its Necropolis property, where tombs and pyramids trace the development of ancient Egyptian funerary monuments.", href: "https://whc.unesco.org/en/list/86" }],
  },
  {
    id: "journey-2025", coord: [36.8, 10.18], years: "2025", countries: "it sm de fr mc hr ba me tn", continents: "europe africa",
    year: "2025", region: "Europe · North Africa", place: "Coastlines & shared heritage",
    tagline: "From Mediterranean gardens to a northern winter",
    text: "A year of journeys through Italy, the Adriatic and North Africa, ending beside the winter waterfront at Flensburg.",
    layout: "panorama",
    media: [


      { src: `${img}/flensburg-night-2025.webp`, alt: "Quiet night waterfront in Flensburg, with city lights reflected on the water and no people in view", cap: "Flensburg · 27 December 2025", pos: "center 62%" },
    ],
  },
  {
    id: "journey-2026", coord: [28.49, -16.31], years: "2026", countries: "es", continents: "europe",
    year: "2026", region: "Spain", place: "Canary Islands",
    tagline: "Island light in the Atlantic",
    text: "Volcanic stone, palms and quiet historic squares in Gran Canaria and Tenerife carry the story onward into the Atlantic.",
    layout: "split", reverse: true, tall: true,
    media: [{ src: `${img}/editorial/tenerife-church-square-2026.webp`, alt: "A historic Tenerife bell tower framed by palm branches and a quiet square", cap: "Tenerife · photographed 5 February 2026", pos: "center 40%" }],
    contexts: [{ title: "La Laguna, Tenerife", text: "UNESCO describes La Laguna’s historic plan as two town nuclei, including a grid-planned lower town, with architecture from several periods still active in everyday city life.", href: "https://whc.unesco.org/en/list/929" }],
  },
];

const heroSlides = [
  { src: `${img}/cinematic/carbunari-wide.webp`, pos: "center 50%" },
  { src: `${img}/cinematic/morocco-courtyard-wide.webp`, pos: "center 55%" },
  { src: `${img}/cinematic/giza-wide.webp`, pos: "center 65%" },
  { src: `${img}/cinematic/flensburg-night-wide.webp`, pos: "center 60%" },
];

const clips = [
  { name: "edinburgh-06", title: "Edinburgh", cap: "Still water beneath bare winter branches" },
  { name: "edinburgh-10", title: "Edinburgh", cap: "A garden stream moving over stone" },
  { name: "richmond-pond", title: "Richmond Park", cap: "From a post dated 14 September 2020" },
  { name: "richmond-grassland", title: "Richmond Park", cap: "From a post dated 14 September 2020" },
  { name: "morocco-minaret", title: "Morocco", cap: "A minaret against the sky · original clip, date to be confirmed" },
  { name: "morocco-garden", title: "Morocco", cap: "Palms and shade in a garden · original clip, date to be confirmed" },
  { name: "istanbul-16", title: "Istanbul", cap: "A waterfront and crossing over the water" },
  { name: "dubai-23", title: "Dubai", cap: "Burj Khalifa above reflecting water" },
];

const routeChapters = routeMap.chapters;
const fullRoute = routeChapters.map((chapter) => chapter.d).join("");
const prague = routeMap.prague;
const newYork = routeMap.newYork;
const chapterByYear: Record<number, string> = {
  2012: "journey-2012",
  2013: "journey-2013",
  2014: "journey-2014",
  2016: "journey-2016",
  2017: "journey-2016",
  2018: "journey-2018",
  2019: "journey-2019",
  2020: "journey-2020",
  2021: "journey-2021",
  2022: "journey-2022",
  2023: "journey-2023",
  2024: "journey-2024",
  2025: "journey-2025",
  2026: "journey-2026",
};
const yearNotes: Record<number, string> = {
  2010: "The timeline begins here; no dated travel chapter is included for this year.",
  2011: "No dated travel chapter is included for this year.",
  2015: "No dated travel chapter is included for this year.",
};
const timelineStartYear = 2010;
const timelineEndYear = Math.max(2026, new Date().getFullYear());
const timelineYears = Array.from({ length: timelineEndYear - timelineStartYear + 1 }, (_, index) => {
  const year = timelineStartYear + index;
  const target = chapterByYear[year];
  const note = year === 2017
    ? "The Germany chapter includes dated material from 2016 and 2017."
    : year === 2022
      ? "The 2022–23 Mediterranean story spans both years."
      : year === 2023
        ? "The Mediterranean story spans late 2022 and 2023."
        : target
          ? "Select to open this year’s destination chapter."
          : yearNotes[year] || "No dated travel chapter is included for this year.";
  return { year, target, note };
});
---

<BaseLayout title="The World Through My Eyes — Beyond Borders" description="A personal journey through places, perspectives and the curiosity behind Visio Nova Mundi.">
<div class="film" data-film>
  <script is:inline>if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.currentScript.parentElement.classList.add("film-pre");</script>
  <div class="film-progress" aria-hidden="true"></div>

  <!-- Title sequence -->
  <section class="title-sequence" aria-labelledby="journey-page-title" data-title-sequence>
    <div class="ts-slides" aria-hidden="true">
      {heroSlides.map((slide, index) => (
        <div class:list={["ts-slide", { "is-active": index === 0 }]}>
          <img {...(index === 0 ? responsiveImage(slide.src) : { "data-src": slide.src, "data-srcset": responsiveImage(slide.src).srcset })} alt="" style={`object-position:${slide.pos}`} decoding="async" fetchpriority={index === 0 ? "high" : "low"} />
        </div>
      ))}
    </div>
    <div class="ts-shade" aria-hidden="true"></div>
    <div class="ts-light" aria-hidden="true"></div>
    <div class="ts-grain" aria-hidden="true"></div>
    <div class="ts-letterbox ts-letterbox--top" aria-hidden="true"></div>
    <div class="ts-inner">
      <div class="ts-copy">
        <p class="ts-kicker">Visio Nova Mundi presents · Beyond Borders</p>
        <h1 id="journey-page-title"><span>The World</span> <span>Through My Eyes</span></h1>
        <p class="ts-lines"><span>Travel opened my eyes.</span> <span>Education expanded my horizons.</span> <span>Compassion gave my dreams a purpose.</span></p>
        <div class="ts-actions">
          <a class="ts-begin" href="#prologue">Begin the journey <span aria-hidden="true">↓</span></a>
          <a class="ts-secondary" href="#journey-map">Explore the map</a>
        </div>
      </div>
    </div>
    <div class="ts-letterbox ts-letterbox--bottom">
      <p class="ts-span" aria-hidden="true"><span>{timelineStartYear}</span><i></i><span>{timelineEndYear}</span></p>
      <p class="ts-regions">Europe · North Africa · The Gulf · North America</p>
      <button class="ts-pause" type="button" data-ts-pause aria-pressed="false">Pause background</button>
    </div>
  </section>

  <!-- Prologue -->
  <section class="prologue" id="prologue" aria-labelledby="prologue-title">
    <div class="prologue-copy">
      <p class="jlabel">Prologue · The dream</p>
      <h2 id="prologue-title">A curious mind, looking outward</h2>
      <p class="prologue-quote">My journey began in modest circumstances, where opportunity was limited but imagination was not.</p>
      <p class="prologue-text">I kept a quiet dream of discovering the world and one day helping others. Work and education widened the horizon. Travel gave that curiosity somewhere to go.</p>
    </div>
    <figure class="prologue-photo">
      <img {...responsiveImage(`${img}/london-walk-2016.webp`)} alt="Florin walking between London buildings, with The Shard in the distance" loading="eager" decoding="async" />
      <figcaption>London · a moment between buildings</figcaption>
    </figure>
  </section>

  <!-- Keep every calendar year visible, including quieter years. -->
  <section class="yearline" id="yearline" aria-labelledby="yearline-title" data-yearline>
    <div class="yearline-head">
      <p class="jlabel">A living timeline · {timelineStartYear}–{timelineEndYear}</p>
      <h2 id="yearline-title">A year-by-year story, still unfolding</h2>
      <p>Choose a year to follow its journey chapter. Quieter years stay open for future discoveries.</p>
    </div>
    <nav class="yearline-nav" aria-label={`Select a year from ${timelineStartYear} to ${timelineEndYear}`}>
      <ol>
        {timelineYears.map(({ year, target, note }) => (
          <li class:list={{ "yearline-item--documented": Boolean(target), "yearline-item--open": !target }}>
            <a href={target ? `#${target}` : "#yearline-status"} data-year-select data-year={year} data-note={note} aria-label={`${year}${target ? " · documented travel chapter" : " · no dated travel chapter published"}`}>
              <span class="yearline-dot" aria-hidden="true"></span><span>{year}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <p class="yearline-scroll-hint" aria-hidden="true">Swipe to discover later years <span>→</span></p>
    <p class="yearline-status" id="yearline-status" role="status" aria-live="polite">Select any year. The quieter years are kept in the timeline without filling gaps with assumptions.</p>
  </section>

  <!-- The route -->
  <section class="route" id="journey-map" aria-labelledby="route-title" data-route>
    <div class="route-head">
      <p class="jlabel">Destination chapters · 2012–2026</p>
      <h2 id="route-title">A journey drawn across the map</h2>
      <p>Follow the line in order, or choose any chapter.</p>
    </div>
    <div class="route-stage">
      <div class="route-map">
        <svg class="route-overlay" viewBox={`0 0 ${routeMap.w} ${routeMap.h}`} preserveAspectRatio="xMidYMid slice" role="group" aria-labelledby="route-map-title">
          <title id="route-map-title">Map of the destination chapters, from Romania in 2012 to the Canary Islands in 2026</title>
          <image class="route-land" href={`${img}/cinematic/route-map.svg`} x="0" y="0" width={routeMap.w} height={routeMap.h} preserveAspectRatio="none" aria-hidden="true" />
          <path class="route-line" d={fullRoute} pathLength="1" aria-hidden="true" />
          <circle class="route-comet" r="7" cx="-50" cy="-50" aria-hidden="true" />
          <path class="route-ny" d={`M${prague[0]} ${prague[1]} Q${(prague[0] + newYork[0]) / 2} ${newYork[1] - 120} ${newYork[0] + 8} ${newYork[1]}`} aria-hidden="true" />
          <text class="route-ny-label" x={newYork[0] + 16} y={newYork[1] - 10} aria-hidden="true">← New York · 2022</text>
          {routeChapters.map((chapter) => (
            <g class="route-chapter" data-chapter={chapter.id} data-bbox={JSON.stringify(chapter.points.map((point) => point.xy))}>
              <path class="route-seg" d={chapter.d} aria-hidden="true" />
              {chapter.points.map((point, index) => (
                <a href={`#${chapter.id}`} aria-label={`${chapter.year} · ${point.name}`} tabindex={index === 0 ? undefined : "-1"}>
                  <circle class="route-halo" cx={point.xy[0]} cy={point.xy[1]} r="13" />
                  <circle class="route-dot" cx={point.xy[0]} cy={point.xy[1]} r="4.5" />
                </a>
              ))}
              <text class="route-tag" x={chapter.points[0].xy[0] > 560 ? chapter.points[0].xy[0] - 12 : chapter.points[0].xy[0] + 12} y={chapter.points[0].xy[1] - 12} text-anchor={chapter.points[0].xy[0] > 560 ? "end" : "start"} aria-hidden="true">{chapter.year} · {chapter.points.map((point) => point.name).join(" · ")}</text>
            </g>
          ))}
        </svg>
      </div>
      <ol class="route-index" aria-label="Chapters in chronological order">
        {chapters.map((chapter) => (
          <li data-route-item={chapter.id}>
            <a href={`#${chapter.id}`} data-chapter-link={chapter.id}><span class="route-year">{chapter.year}</span><span class="route-name">{chapter.place}</span></a>
          </li>
        ))}
      </ol>
    </div>
    <div class="route-controls">
      <button class="route-play" type="button" data-route-play aria-pressed="false"><span class="route-play-icon" aria-hidden="true"></span><span data-route-play-label>Fly the route</span></button>
      <p class="route-now" data-route-now aria-live="polite"></p>
    </div>
    <details class="route-explore">
      <summary>Explore by year, country or continent</summary>
      <div class="journey-filters">
        <label class="journey-filter-control" for="journey-year-filter">
          <span>Year</span>
          <select id="journey-year-filter">
            <option value="all">All documented years</option>
            {["2012", "2013", "2014", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025", "2026"].map((year) => <option value={year}>{year}</option>)}
          </select>
        </label>
        <label class="journey-filter-control" for="journey-country-filter">
          <span>Country</span>
          <select id="journey-country-filter">
            <option value="all">All recorded countries</option>
            {[["de", "Germany"], ["nl", "Netherlands"], ["ro", "Romania"], ["gb", "United Kingdom"], ["ie", "Ireland"], ["dk", "Denmark"], ["at", "Austria"], ["si", "Slovenia"], ["it", "Italy"], ["hu", "Hungary"], ["tr", "Türkiye"], ["ma", "Morocco"], ["al", "Albania"], ["pt", "Portugal"], ["eg", "Egypt"], ["ae", "United Arab Emirates"], ["gr", "Greece"], ["pl", "Poland"], ["us", "United States"], ["sm", "San Marino"], ["fr", "France"], ["mc", "Monaco"], ["hr", "Croatia"], ["ba", "Bosnia and Herzegovina"], ["me", "Montenegro"], ["tn", "Tunisia"], ["es", "Spain"], ["mt", "Malta"], ["cy", "Cyprus"]].map(([code, name]) => <option value={code}>{name}</option>)}
          </select>
        </label>
        <label class="journey-filter-control" for="journey-continent-filter">
          <span>Continent</span>
          <select id="journey-continent-filter">
            <option value="all">All recorded continents</option>
            <option value="africa">Africa</option>
            <option value="asia">Asia</option>
            <option value="europe">Europe</option>
            <option value="america_north">North America</option>
          </select>
        </label>
        <p class="journey-filter-status" id="journey-filter-status" role="status" aria-live="polite">Showing all dated chapters. The record is selective; a missing match does not mean no travel occurred.</p>
      </div>
    </details>
    <p class="route-disclaimer">The map line is a visual cue between chapters, not a recorded route.</p>
  </section>

  <!-- Chapters -->
  <nav class="chapter-rail" aria-label="Travel chapters" data-chapter-rail>
    <ol>
      {chapters.map((chapter) => (
        <li data-rail-item={chapter.id}><a href={`#${chapter.id}`} data-chapter-link={chapter.id}><span class="rail-dot" aria-hidden="true"></span><span class="rail-year">{chapter.year}</span></a></li>
      ))}
    </ol>
  </nav>

  <ol class="journey" aria-label="Travel chapters" data-journey>
    {chapters.map((chapter, index) => (
      <li
        class:list={["journey-stop", "scene", `scene--${chapter.layout}`, chapter.theme && `scene--${chapter.theme}`, { "scene--reverse": chapter.reverse, "scene--narrow": chapter.narrow, "scene--tall": chapter.tall }]}
        id={chapter.id}
        data-years={chapter.years}
        data-countries={chapter.countries}
        data-continents={chapter.continents}
        data-scene
      >
        {chapter.media && (
          <div class="scene-visual">
            {chapter.media.map((media, mediaIndex) => (
              <figure class:list={["scene-photo", `scene-photo--${mediaIndex + 1}`]}>
                <img {...responsiveImage(media.src)} alt={media.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" style={`object-position:${media.pos}`} />
                <figcaption>{media.cap}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {chapter.layout === "titlecard" && (
          <div class="scene-type" aria-hidden="true">
            {chapter.numerals && (
              <p class="scene-numerals"><span>{chapter.numerals[0]}</span><i></i><span>{chapter.numerals[1]}</span></p>
            )}
            <ul class="scene-places">
              {chapter.list.map((place, placeIndex) => (
                <li style={`--i:${placeIndex}`}>{place}{chapter.listMeta && <small>{chapter.listMeta[placeIndex]}</small>}</li>
              ))}
            </ul>
          </div>
        )}
        <div class="scene-copy">
          <p class="scene-year"><span class="scene-num">{String(index + 1).padStart(2, "0")}</span><span>{chapter.year}</span><span class="scene-region">{chapter.region}</span><span class="scene-coord" aria-hidden="true" data-lat={chapter.coord[0]} data-lon={chapter.coord[1]}>{Math.abs(chapter.coord[0]).toFixed(2)}° {chapter.coord[0] >= 0 ? "N" : "S"} · {Math.abs(chapter.coord[1]).toFixed(2)}° {chapter.coord[1] >= 0 ? "E" : "W"}</span></p>
          <h3 class="scene-place">{chapter.place}</h3>
          <p class="scene-tagline">{chapter.tagline}</p>
          <p class="scene-text">{chapter.text}</p>
          {chapter.layout === "portrait" && chapter.list && (
            <ul class="scene-stops">
              {chapter.list.map((place, placeIndex) => <li><span>{place}</span><small>{chapter.listMeta?.[placeIndex]}</small></li>)}
            </ul>
          )}
        </div>
        <div class="scene-foot">
          {chapter.contexts?.map((context) => (
            <aside class="scene-context" aria-label={`${context.title}: cultural and historical context`}>
              <strong>{context.title}</strong>
              <p>{context.text} <a href={context.href} rel="external">Official context<span class="visually-hidden"> for {context.title}</span></a></p>
            </aside>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <!-- Moments in motion -->
  <section class="motion" aria-labelledby="motion-title" data-motion>
    <div class="motion-head">
      <p class="jlabel">Interlude · Moments in motion</p>
      <h2 id="motion-title">Moments in motion</h2>
      <p>Quiet water, garden movement and city reflections across Edinburgh, Istanbul, Dubai, Morocco and Richmond Park.</p>
      <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">Play clips</button>
    </div>
    <div class="motion-reel">
      {clips.map((clip, index) => (
        <figure class="motion-window" style={`--i:${index}`}>
          <video muted loop playsinline preload="none" poster={`${img}/cinematic/${clip.name}-poster.webp`} aria-label={`${clip.title}: ${clip.cap}. Silent clip.`} data-clip>
            <source data-src={`/media/journey/cinematic/${clip.name}.webm`} type="video/webm" />
            <source data-src={`/media/journey/cinematic/${clip.name}.mp4`} type="video/mp4" />
          </video>
          <p class="clip-status" data-clip-status role="status" aria-live="polite" hidden>This clip could not be played. The still image remains available.</p>
          <button class="clip-retry" data-clip-retry type="button" hidden>Try this clip again</button>
          <figcaption><strong>{clip.title}</strong><span>{clip.cap}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- From journey to vision -->
  <section class="vision" aria-labelledby="vision-title">
    <div class="vision-inner">
      <p class="jlabel">From the journey to the vision</p>
      <h2 id="vision-title">Learning changes how we see the world</h2>
      <p class="vision-lead">Travel, education and the people I encounter keep widening my perspective. Each culture offers another way to understand the world; each question reminds me there is more to learn.</p>
      <div class="vision-columns">
        <p>I’m drawn to computer science and artificial intelligence, to history and the stories of human societies, and to the possibilities that innovation may open for the future.</p>
        <p>Life has also taught me resilience, independence, compassion and forgiveness. These are values I continue to learn from and carry into the future.</p>
      </div>
      <a class="vision-link" href="/about/#education-innovation">Education and innovation interests <span aria-hidden="true">↗</span></a>

      <div class="vision-vnm">
        <p class="vision-mark">Visio Nova Mundi</p>
        <p class="vision-statement">An expression of a lifelong aspiration to help others, bringing together compassion, education, technology and innovation to explore possibilities for a better future.</p>
        <h3 class="visually-hidden">Three distinct expressions of that curiosity</h3>
        <ul class="vision-projects">
          <li><a href="/unity-house/">Unity House</a><span>Community health and wellbeing research and development.</span></li>
          <li><a href="/admintrace/">AdminTrace</a><span>A concept in development, exploring clearer ways to follow complex administrative processes.</span></li>
          <li><a href="/project-clandestinus/">Project Clandestinus</a><span>An independent creative and publishing venture, separately owned and operated from Visio Nova Mundi CIC.</span></li>
        </ul>
        <p class="vision-small">Each has its own purpose, ownership and development stage; their progress is described on their own pages.</p>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="finale" aria-labelledby="finale-title" data-finale>
    <img {...responsiveImage(`${img}/cinematic/flensburg-night-wide.webp`)} class="finale-photo" alt="Night waterfront in Flensburg under a bright moon, with city lights reflected on the water" loading="eager" fetchpriority="low" decoding="async" />
    <div class="finale-copy">
      <h2 id="finale-title" class="jlabel">The journey continues</h2>
      <p class="finale-line">Travel opened my eyes.</p>
      <p class="finale-line">Education expanded my horizons.</p>
      <p class="finale-line">Compassion gave my dreams a purpose.</p>
      <p class="finale-line finale-line--last">The journey continues.</p>
      <p class="finale-brand">Visio Nova Mundi <span>A New Vision of the World</span></p>
      <p class="finale-actions"><a href="#journey-page-title">Return to the beginning <span aria-hidden="true">↑</span></a><a href="/about/">About the founder <span aria-hidden="true">↗</span></a></p>
    </div>
    <p class="finale-cap">Flensburg · 27 December 2025</p>
  </section>
</div>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const film = document.querySelector<HTMLElement>("[data-film]");
  if (film) {
    film.classList.add("film-js");
    if (!reduceMotion.matches) film.classList.add("film-motion");

    // Every calendar year has a place; only evidence-backed years jump to travel scenes.
    const yearlineStatus = film.querySelector<HTMLElement>("#yearline-status");
    const yearLinks = Array.from(film.querySelectorAll<HTMLAnchorElement>("[data-year-select]"));
    for (const link of yearLinks) {
      link.addEventListener("click", () => {
        const year = link.dataset.year || "";
        if (yearlineStatus) yearlineStatus.textContent = `${year} · ${link.dataset.note || "No dated travel chapter is included for this year."}`;
        for (const entry of yearLinks) {
          const selected = entry === link;
          entry.closest("li")?.classList.toggle("is-selected", selected);
          if (selected) entry.setAttribute("aria-current", "true"); else entry.removeAttribute("aria-current");
        }
      });
    }

    // Title sequence: slow crossfade between landscapes, pausable (WCAG 2.2.2).
    const sequence = film.querySelector<HTMLElement>("[data-title-sequence]");
    const slides = Array.from(film.querySelectorAll<HTMLElement>(".ts-slide"));
    const pauseButton = film.querySelector<HTMLButtonElement>("[data-ts-pause]");
    let slideIndex = 0;
    let slideTimer: number | undefined;
    let userPaused = reduceMotion.matches;
    let heroVisible = true;
    const stopSlides = () => { if (slideTimer) window.clearInterval(slideTimer); slideTimer = undefined; };
    const startSlides = () => {
      stopSlides();
      if (userPaused || !heroVisible || document.hidden || slides.length < 2) return;
      for (const image of Array.from(film.querySelectorAll<HTMLImageElement>(".ts-slide img[data-src]"))) { image.src = image.dataset.src || ""; image.srcset = image.dataset.srcset || ""; image.removeAttribute("data-src"); image.removeAttribute("data-srcset"); }
      slideTimer = window.setInterval(() => {
        slides[slideIndex].classList.remove("is-active");
        slideIndex = (slideIndex + 1) % slides.length;
        slides[slideIndex].classList.add("is-active");
      }, 6500);
    };
    const syncPause = () => {
      sequence?.classList.toggle("is-paused", userPaused);
      if (pauseButton) {
        pauseButton.setAttribute("aria-pressed", String(userPaused));
        pauseButton.textContent = userPaused ? "Play background" : "Pause background";
      }
    };
    pauseButton?.addEventListener("click", () => { userPaused = !userPaused; syncPause(); startSlides(); });
    document.addEventListener("visibilitychange", startSlides);
    if (sequence && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; startSlides(); }).observe(sequence);
    }
    syncPause();
    startSlides();

    // Scenes arrive gently as they enter the frame.
    const scenes = Array.from(film.querySelectorAll<HTMLElement>("[data-scene]"));
    if (!reduceMotion.matches && "IntersectionObserver" in window) {
      const sceneObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) { entry.target.classList.add("is-in-view"); sceneObserver.unobserve(entry.target); }
        }
      }, { threshold: 0.08, rootMargin: "0px 0px -8% 0px" });
      for (const scene of scenes) { scene.classList.add("cinematic-ready"); sceneObserver.observe(scene); }
    }

    // Let the year rail follow the chapter passing through the centre of the screen.
    // Keep this as a small opacity/colour cue so it remains calm on touch devices.
    if ("IntersectionObserver" in window && yearLinks.length) {
      const markCurrentYears = (scene: HTMLElement | undefined) => {
        const years = new Set((scene?.dataset.years || "").split(/\s+/).filter(Boolean));
        const firstYear = years.values().next().value;
        for (const link of yearLinks) {
          const current = years.has(link.dataset.year || "");
          link.closest("li")?.classList.toggle("is-selected", current);
          if (link.dataset.year === firstYear) link.setAttribute("aria-current", "location");
          else if (link.getAttribute("aria-current") === "location") link.removeAttribute("aria-current");
        }
      };
      const yearObserver = new IntersectionObserver(() => {
        const centre = window.innerHeight / 2;
        const current = scenes
          .map((scene) => ({ scene, rect: scene.getBoundingClientRect() }))
          .filter(({ rect }) => rect.top <= centre && rect.bottom >= centre)
          .sort((a, b) => Math.abs(a.rect.top + a.rect.height / 2 - centre) - Math.abs(b.rect.top + b.rect.height / 2 - centre))[0]?.scene;
        markCurrentYears(current);
      }, { rootMargin: "-49% 0px -49% 0px", threshold: 0 });
      for (const scene of scenes) yearObserver.observe(scene);
    }

    // Route map: draw the line on arrival; highlight a chapter on hover, focus or playback.
    const route = film.querySelector<HTMLElement>("[data-route]");
    const routeGroups = Array.from(film.querySelectorAll<SVGGElement>(".route-chapter"));
    const routeItems = Array.from(film.querySelectorAll<HTMLElement>("[data-route-item]"));
    const routeNow = film.querySelector<HTMLElement>("[data-route-now]");
    const playButton = film.querySelector<HTMLButtonElement>("[data-route-play]");
    const chapterIds = scenes.map((scene) => scene.id);
    const setActive = (id: string | null) => {
      for (const group of routeGroups) group.classList.toggle("is-active", group.dataset.chapter === id);
      for (const item of routeItems) item.classList.toggle("is-active", item.dataset.routeItem === id);
      route?.classList.toggle("has-active", Boolean(id));
    };
    if (route && "IntersectionObserver" in window) {
      const drawObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { route.classList.add("is-drawn"); drawObserver.disconnect(); }
      }, { threshold: 0.25 });
      drawObserver.observe(route);
    } else route?.classList.add("is-drawn");
    const hoverTargets = [...routeItems, ...routeGroups] as HTMLElement[];
    for (const target of hoverTargets) {
      const id = (target as HTMLElement).dataset.routeItem || (target as HTMLElement).dataset.chapter || null;
      target.addEventListener("pointerenter", () => { if (!playTimer) setActive(id); });
      target.addEventListener("focusin", () => { if (!playTimer) setActive(id); });
    }
    route?.querySelector(".route-stage")?.addEventListener("pointerleave", () => { if (!playTimer) setActive(null); });
    let playTimer: number | undefined;
    let playIndex = 0;
    const playLabel = playButton?.querySelector<HTMLElement>("[data-route-play-label]");
    const overlay = film.querySelector<SVGSVGElement>(".route-overlay");
    const comet = film.querySelector<SVGCircleElement>(".route-comet");
    const fullView = { x: 0, y: 0, w: 1000, h: 740 };
    let view = { ...fullView };
    let cameraFrame = 0;
    const applyView = (v: typeof view) => {
      overlay?.setAttribute("viewBox", `${v.x.toFixed(1)} ${v.y.toFixed(1)} ${v.w.toFixed(1)} ${v.h.toFixed(1)}`);
      overlay?.style.setProperty("--z", (v.w / 1000).toFixed(3));
    };
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const flyTo = (target: typeof view, duration = 1400) => {
      cancelAnimationFrame(cameraFrame);
      if (reduceMotion.matches) { view = { ...target }; applyView(view); return; }
      const from = { ...view };
      const started = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - started) / duration), k = ease(t);
        view = { x: from.x + (target.x - from.x) * k, y: from.y + (target.y - from.y) * k, w: from.w + (target.w - from.w) * k, h: from.h + (target.h - from.h) * k };
        applyView(view);
        if (t < 1) cameraFrame = requestAnimationFrame(tick);
      };
      cameraFrame = requestAnimationFrame(tick);
    };
    const frameFor = (points: number[][]) => {
      const xs = points.map((point) => point[0]), ys = points.map((point) => point[1]);
      const cx = (Math.min(...xs) + Math.max(...xs)) / 2, cy = (Math.min(...ys) + Math.max(...ys)) / 2;
      let w = Math.max(320, (Math.max(...xs) - Math.min(...xs)) * 1.5, (Math.max(...ys) - Math.min(...ys)) * 1.5 * (1000 / 740));
      w = Math.min(1000, w);
      const h = w * 0.74;
      return { x: Math.max(0, Math.min(1000 - w, cx - w / 2)), y: Math.max(0, Math.min(740 - h, cy - h / 2)), w, h };
    };
    let cometFrame = 0;
    const flyComet = (group: SVGGElement | undefined, duration = 1300) => {
      cancelAnimationFrame(cometFrame);
      const seg = group?.querySelector<SVGPathElement>(".route-seg");
      if (!seg || !comet || reduceMotion.matches) return;
      const length = seg.getTotalLength();
      if (!length) return;
      const started = performance.now();
      comet.classList.add("is-flying");
      const tick = (now: number) => {
        const t = Math.min(1, (now - started) / duration);
        const point = seg.getPointAtLength(length * ease(t));
        comet.setAttribute("cx", point.x.toFixed(1));
        comet.setAttribute("cy", point.y.toFixed(1));
        if (t < 1) cometFrame = requestAnimationFrame(tick); else comet.classList.remove("is-flying");
      };
      cometFrame = requestAnimationFrame(tick);
    };
    const visibleChapterIds = () => chapterIds.filter((id) => !document.getElementById(id)?.hidden);
    const stopPlay = (message?: string) => {
      const wasPlaying = Boolean(playTimer);
      if (playTimer) window.clearInterval(playTimer);
      playTimer = undefined;
      playButton?.setAttribute("aria-pressed", "false");
      route?.classList.remove("is-flying");
      if (playLabel) playLabel.textContent = "Fly the route";
      if (message !== undefined && routeNow) routeNow.textContent = message;
      if (wasPlaying || message !== undefined) flyTo(fullView, 1600);
    };
    const describe = (id: string) => {
      const item = routeItems.find((entry) => entry.dataset.routeItem === id);
      const year = item?.querySelector(".route-year")?.textContent || "";
      const name = item?.querySelector(".route-name")?.textContent || "";
      return `${year} · ${name}`;
    };
    playButton?.addEventListener("click", () => {
      if (playTimer) { stopPlay("Route paused."); return; }
      const ids = visibleChapterIds();
      if (!ids.length) return;
      playIndex = 0;
      playButton.setAttribute("aria-pressed", "true");
      route?.classList.add("is-flying", "is-drawn");
      if (playLabel) playLabel.textContent = "Pause the flight";
      let previous: number[] | null = null;
      const step = () => {
        if (playIndex >= ids.length) { stopPlay("End of the route. Choose a chapter to continue."); setActive(null); return; }
        const id = ids[playIndex++];
        const group = routeGroups.find((entry) => entry.dataset.chapter === id);
        const points: number[][] = JSON.parse(group?.dataset.bbox || "[]");
        setActive(id);
        if (points.length) flyTo(frameFor(previous ? [previous, ...points] : points));
        flyComet(group);
        previous = points[points.length - 1] || previous;
        if (routeNow) routeNow.textContent = describe(id);
      };
      step();
      playTimer = window.setInterval(step, reduceMotion.matches ? 2600 : 2300);
    });

    // Chapter rail: a discreet chronological indicator while the chapters are on screen.
    const rail = film.querySelector<HTMLElement>("[data-chapter-rail]");
    const railItems = Array.from(film.querySelectorAll<HTMLElement>("[data-rail-item]"));
    const journeyList = film.querySelector<HTMLElement>("[data-journey]");
    if (rail && journeyList && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => rail.classList.toggle("is-visible", entry.isIntersecting), { rootMargin: "-35% 0px -35% 0px" }).observe(journeyList);
      const currentObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const item of railItems) {
            const current = item.dataset.railItem === entry.target.id;
            item.classList.toggle("is-current", current);
            const link = item.querySelector("a");
            if (current) link?.setAttribute("aria-current", "location"); else link?.removeAttribute("aria-current");
          }
        }
      }, { rootMargin: "-45% 0px -50% 0px" });
      for (const scene of scenes) currentObserver.observe(scene);
    }

    // Filters (preserved): hide chapters and their markers that do not match.
    const yearFilter = film.querySelector<HTMLSelectElement>("#journey-year-filter");
    const countryFilter = film.querySelector<HTMLSelectElement>("#journey-country-filter");
    const continentFilter = film.querySelector<HTMLSelectElement>("#journey-continent-filter");
    const filterStatus = film.querySelector<HTMLElement>("#journey-filter-status");
    if (yearFilter && countryFilter && continentFilter && filterStatus) {
      const updateChapters = () => {
        stopPlay();
        const year = yearFilter.value, country = countryFilter.value, continent = continentFilter.value;
        const visibleIds = new Set<string>();
        for (const scene of scenes) {
          const has = (key: string, value: string) => value === "all" || (scene.dataset[key] || "").split(/\s+/).includes(value);
          const visible = has("years", year) && has("countries", country) && has("continents", continent);
          scene.hidden = !visible;
          if (visible) visibleIds.add(scene.id);
        }
        for (const item of routeItems) item.hidden = !visibleIds.has(item.dataset.routeItem || "");
        for (const item of railItems) item.hidden = !visibleIds.has(item.dataset.railItem || "");
        for (const group of routeGroups) group.classList.toggle("is-filtered", !visibleIds.has(group.dataset.chapter || ""));
        filterStatus.textContent = visibleIds.size
          ? `Showing ${visibleIds.size} of ${scenes.length} chapters. The record is selective; a missing match does not mean no travel occurred.`
          : "No chapter matches these filters. The current record is selective and does not establish that no travel occurred.";
      };
      yearFilter.addEventListener("change", updateChapters);
      countryFilter.addEventListener("change", updateChapters);
      continentFilter.addEventListener("change", updateChapters);
    }

    // Silent clips: load only near the viewport; autoplay only when motion is allowed.
    const motion = film.querySelector<HTMLElement>("[data-motion]");
    const videos = Array.from(film.querySelectorAll<HTMLVideoElement>("[data-clip]"));
    const motionToggle = film.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    let clipsWanted = !reduceMotion.matches;
    let clipsVisible = false;
    const visibleVideos = new Set<HTMLVideoElement>();
    const pendingPlays = new WeakSet<HTMLVideoElement>();
    const loadClip = (video: HTMLVideoElement) => {
      if (video.dataset.loaded) return;
      for (const source of Array.from(video.querySelectorAll<HTMLSourceElement>("source[data-src]"))) source.src = source.dataset.src || "";
      video.dataset.loaded = "true";
      video.load();
    };
    const playClip = (video: HTMLVideoElement) => {
      loadClip(video);
      if (!video.paused || pendingPlays.has(video)) return;
      pendingPlays.add(video);
      video.play().then(() => {
        delete video.dataset.playbackError;
        const figure = video.closest("figure");
        const status = figure?.querySelector<HTMLElement>("[data-clip-status]");
        const retry = figure?.querySelector<HTMLButtonElement>("[data-clip-retry]");
        if (status) status.hidden = true;
        if (retry) { retry.hidden = true; retry.disabled = false; }
      }).catch((error: unknown) => {
        if (error instanceof DOMException && error.name === "AbortError") return;
        const name = error instanceof DOMException ? error.name : "PlaybackError";
        video.dataset.playbackError = name;
        const figure = video.closest("figure");
        const status = figure?.querySelector<HTMLElement>("[data-clip-status]");
        const retry = figure?.querySelector<HTMLButtonElement>("[data-clip-retry]");
        if (status) { status.textContent = "This clip could not be played. The still image remains available."; status.hidden = false; }
        if (retry) { retry.hidden = false; retry.disabled = false; }
        document.dispatchEvent(new CustomEvent("journey:playback-error", {
          detail: { source: video.currentSrc || Array.from(video.querySelectorAll("source")).map(source => source.getAttribute("src")).find(Boolean) || "", name },
        }));
      }).finally(() => {
        pendingPlays.delete(video);
      });
    };
    const retryClip = (video: HTMLVideoElement) => {
      const figure = video.closest("figure");
      const status = figure?.querySelector<HTMLElement>("[data-clip-status]");
      const retry = figure?.querySelector<HTMLButtonElement>("[data-clip-retry]");
      pendingPlays.delete(video);
      video.pause();
      video.load();
      if (status) { status.textContent = "Retrying this clip…"; status.hidden = false; }
      if (retry) retry.disabled = true;
      playClip(video);
    };
    for (const video of videos) {
      video.addEventListener("error", () => {
        const figure = video.closest("figure");
        const status = figure?.querySelector<HTMLElement>("[data-clip-status]");
        const retry = figure?.querySelector<HTMLButtonElement>("[data-clip-retry]");
        video.dataset.playbackError = `MediaError-${video.error?.code || 0}`;
        if (status) { status.textContent = "This clip could not be played. The still image remains available."; status.hidden = false; }
        if (retry) { retry.hidden = false; retry.disabled = false; }
        document.dispatchEvent(new CustomEvent("journey:playback-error", {
          detail: { source: video.currentSrc || "", name: video.dataset.playbackError },
        }));
      });
      const retry = video.closest("figure")?.querySelector<HTMLButtonElement>("[data-clip-retry]");
      retry?.addEventListener("click", () => retryClip(video));
    }
    const syncClips = () => {
      for (const video of videos) {
        const play = clipsWanted && clipsVisible && visibleVideos.has(video);
        if (play) playClip(video); else video.pause();
      }
      motionToggle?.setAttribute("aria-pressed", String(clipsWanted));
      if (motionToggle) motionToggle.textContent = clipsWanted ? "Pause clips" : "Play clips";
    };
    motionToggle?.addEventListener("click", () => { clipsWanted = !clipsWanted; syncClips(); });
    if (motion && "IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => { clipsVisible = entry.isIntersecting; syncClips(); }, { threshold: 0.01 }).observe(motion);
    }
    if ("IntersectionObserver" in window) {
      const clipObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) visibleVideos.add(video);
          else visibleVideos.delete(video);
        }
        syncClips();
      }, { rootMargin: "160px 0px", threshold: 0.25 });
      for (const video of videos) clipObserver.observe(video);
    } else {
      for (const video of videos) visibleVideos.add(video);
    }
    syncClips();

    // Letter-by-letter reveals: the visible letters are decorative; the full text stays readable.
    const splitText = (element: Element, startDelay = 0, step = 0.028) => {
      const text = element.textContent || "";
      if (!text.trim() || element.querySelector(".char")) return;
      const words = text.split(/(\s+)/);
      let index = 0;
      const visual = document.createElement("span");
      visual.setAttribute("aria-hidden", "true");
      visual.className = "split";
      for (const word of words) {
        if (/^\s+$/.test(word)) { visual.append(document.createTextNode(" ")); continue; }
        const wordSpan = document.createElement("span");
        wordSpan.className = "word";
        for (const letter of word) {
          const charSpan = document.createElement("span");
          charSpan.className = "char";
          charSpan.textContent = letter;
          charSpan.style.setProperty("--d", `${(startDelay + index++ * step).toFixed(3)}s`);
          wordSpan.append(charSpan);
        }
        visual.append(wordSpan);
      }
      const hidden = document.createElement("span");
      hidden.className = "visually-hidden";
      hidden.textContent = text;
      element.replaceChildren(hidden, visual);
    };
    if (!reduceMotion.matches) {
      const heroLines = Array.from(film.querySelectorAll(".title-sequence h1 > span"));
      heroLines.forEach((line, lineIndex) => splitText(line, 0.45 + lineIndex * 0.38, 0.034));
      for (const heading of Array.from(film.querySelectorAll(".scene-place, .finale-line, .route-head h2, .motion-head h2, .vision h2"))) splitText(heading, 0.1, 0.022);
      film.classList.add("film-split");
      // Headings outside chapters reveal on arrival too.
      const headingObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add("is-in-view"); headingObserver.unobserve(entry.target); }
      }, { threshold: 0.3 });
      for (const section of Array.from(film.querySelectorAll(".route-head, .motion-head, .vision-inner"))) headingObserver.observe(section);

      // Coordinates count in as each chapter arrives, like an instrument settling.
      const format = (value: number, positive: string, negative: string) => `${Math.abs(value).toFixed(2)}° ${value >= 0 ? positive : negative}`;
      const coordObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          coordObserver.unobserve(entry.target);
          const coord = entry.target.querySelector<HTMLElement>(".scene-coord");
          if (!coord) continue;
          const lat = Number(coord.dataset.lat), lon = Number(coord.dataset.lon);
          const started = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - started) / 1600), k = 1 - Math.pow(1 - t, 4);
            coord.textContent = `${format(lat * k, "N", "S")} · ${format(lon * k, "E", "W")}`;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.2 });
      for (const scene of scenes) coordObserver.observe(scene);

      // Gentle depth in the title sequence, following the pointer.
      if (sequence && window.matchMedia("(pointer: fine)").matches) {
        let frame = 0;
        sequence.addEventListener("pointermove", (event) => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const bounds = sequence.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            sequence.style.setProperty("--px", x.toFixed(3));
            sequence.style.setProperty("--py", y.toFixed(3));
          });
        });
        sequence.addEventListener("pointerleave", () => { sequence.style.setProperty("--px", "0"); sequence.style.setProperty("--py", "0"); });
      }
    }

    // Finale: the closing lines arrive when the final scene is reached.
    const finale = film.querySelector<HTMLElement>("[data-finale]");
    if (finale && !reduceMotion.matches && "IntersectionObserver" in window) {
      finale.classList.add("finale-ready");
      const finaleObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { finale.classList.add("is-playing"); finaleObserver.disconnect(); }
      }, { threshold: 0.35 });
      finaleObserver.observe(finale);
    }
  }
</script>
</BaseLayout>

