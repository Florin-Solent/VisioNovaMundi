/* ---------- Chapter rail ---------- */
.chapter-rail{position:fixed;z-index:20;top:50%;right:clamp(10px,1.6vw,26px);transform:translateY(-50%);opacity:0;visibility:hidden;transition:opacity .45s ease,visibility .45s;}
