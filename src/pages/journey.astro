.scene-context p{margin:0;}
.scene-context a{color:#0f5e57;font-weight:700;text-underline-offset:3px;white-space:nowrap;}

/* Full-bleed scene with the title over the photograph */
.scene--full{display:grid;}
.scene--full .scene-visual{grid-area:1/1;height:clamp(560px,94svh,980px);}
.scene--full .scene-photo{height:100%;}
