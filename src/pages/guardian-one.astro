---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectUpdates from "../components/ProjectUpdates.astro";

const benefits = [
  {
    number: "01",
    title: "Personal space",
    text: "A compact shelter concept designed around the needs of one traveller.",
  },
  {
    number: "02",
    title: "Built for travel",
    text: "Focused on portability and the realities of moving between locations.",
  },
  {
    number: "03",
    title: "Practical security",
    text: "Exploring how a personal shelter could feel more secure while preserving emergency access.",
  },
  {
    number: "04",
    title: "Developed in stages",
    text: "Physical shelter validation comes before any more advanced connected features.",
  },
];
---

<BaseLayout
  title="Guardian One"
  description="Guardian One is a founder-led compact personal-shelter concept being developed around solo travel, portability and practical security."
>
  <section class="conceptHero">
    <div class="heroCopy">
      <p class="eyebrow">TradeVault Guardian System · Founder-led concept</p>
      <h1>GUARDIAN ONE</h1>
      <p class="heroMessage">More confidence when travelling alone.</p>
      <p class="lead">Guardian One is a founder-led shelter concept being developed for solo travellers, campers and people who want a more practical, secure-feeling personal space while away from home. The concept explores portability, shelter and thoughtful security-focused design.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current stage</p>
      <h2>Concept validation</h2>
      <p>Physical shelter validation is the next major step before any advanced connected features are considered.</p>
      <span class="stagePill">Concept validation</span>
    </aside>
  </section>

  <p class="ownershipNote">Founder-led concept developed alongside the wider Visio Nova Mundi ecosystem. It is not presented as a CIC-operated programme; a separate legal or operating entity is not established in the current public project record.</p>

  <p class="separateProjectNote"><strong>Separate project:</strong> Guardian Glide explores accessible shopping mobility. It is not part of Guardian One or the TradeVault Guardian System. <a href="/guardian-glide/">Explore Guardian Glide →</a></p>

  <section class="section introSection" aria-labelledby="traveller-heading">
    <div class="sectionHead">
      <p class="eyebrow">Designed around solo travel</p>
      <h2 id="traveller-heading">A personal shelter for people on the move.</h2>
      <p>Travelling alone can make practical shelter, personal space and peace of mind especially important. Guardian One explores a compact approach to overnight stays and time away from home.</p>
    </div>
  </section>

  <section class="section benefitsSection" aria-labelledby="benefits-heading">
    <div class="sectionHead">
      <p class="eyebrow">What the concept explores</p>
      <h2 id="benefits-heading">Portability, shelter and practical security</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard vnm-glass-card">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section futureSection" aria-labelledby="future-heading">
    <div class="sectionHead">
      <p class="eyebrow">Future Guardian System</p>
      <h2 id="future-heading">A foundation for future travel concepts.</h2>
      <p>Guardian One is intended to establish the foundation for a broader family of travel and personal-shelter concepts, with additional products introduced only as they move through validation.</p>
    </div>
  </section>

  <section class="developmentSection">
    <div>
      <p class="eyebrow">In development</p>
      <h2>Physical validation comes first.</h2>
      <p>Guardian One remains a developing concept. No security performance, certification or personal-safety guarantee is claimed.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href="/timeline">View the project timeline</a>
      <a class="btn" href="/projects">Back to Projects</a>
    </div>
  </section>

  <style>
    .conceptHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 9px;color:#475569;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:850}
    h1{margin:0 0 10px;color:var(--text);font-size:clamp(42px,7vw,66px);letter-spacing:-.045em}
    .heroMessage{margin:0 0 13px;color:var(--text);font-size:clamp(22px,3vw,30px);font-weight:750;letter-spacing:-.025em;line-height:1.25}
    .lead{margin:0;max-width:76ch;color:var(--muted);font-size:18px;line-height:1.8}
    .stageCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:20px;background:linear-gradient(135deg,rgba(148,163,184,.13),rgba(37,99,235,.065));border-color:rgba(71,85,105,.2)}
    .stageLabel{margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:12px;font-weight:850}
    .stageCard h2{margin:0 0 9px;color:var(--text);font-size:21px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.7}
    .stagePill{display:inline-flex;margin-top:14px;padding:7px 10px;border:1px solid rgba(71,85,105,.2);border-radius:999px;background:rgba(148,163,184,.1);color:#334155;font-size:12px;font-weight:850}
    .ownershipNote{margin:22px 0 0;padding:13px 16px;border-left:3px solid #64748b;background:rgba(148,163,184,.08);color:var(--muted);line-height:1.7}
    .separateProjectNote{margin:12px 0 0;padding:13px 16px;border:1px solid rgba(71,85,105,.13);border-radius:12px;background:rgba(255,255,255,.7);color:var(--muted);line-height:1.7}
    .separateProjectNote strong{color:var(--text)}
    .separateProjectNote a{color:#1d4ed8;font-weight:750;text-underline-offset:3px}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .sectionHead>p:not(.eyebrow),.developmentSection>div>p:not(.eyebrow){margin:0;max-width:82ch;color:var(--muted);line-height:1.8}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
    .benefitCard{min-height:170px;padding:20px;background:linear-gradient(135deg,rgba(148,163,184,.055),rgba(37,99,235,.045))}
    .benefitNumber{display:grid;place-items:center;width:34px;height:34px;margin-bottom:13px;border:1px solid rgba(71,85,105,.2);border-radius:50%;background:rgba(148,163,184,.1);color:#475569;font-size:12px;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:18px;letter-spacing:-.015em}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .futureSection,.developmentSection{padding:21px 22px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(148,163,184,.08),rgba(37,99,235,.045))}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-top:20px}
    .developmentSection>div:first-child{max-width:76ch}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(71,85,105,.22);border-radius:999px;background:white;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn.primary{background:linear-gradient(135deg,rgba(148,163,184,.13),rgba(37,99,235,.1))}
    .btn:hover{text-decoration:none;border-color:rgba(71,85,105,.4)}
    @media(max-width:800px){.conceptHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.futureSection,.developmentSection{padding:18px}.actions{flex-direction:column}.btn{width:100%;white-space:normal;text-align:center}}
  </style>
  <ProjectUpdates project="guardian-one" />
</BaseLayout>
