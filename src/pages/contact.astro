---
import BaseLayout from "../layouts/BaseLayout.astro";
const email = "visionovamundi@outlook.com";
---
<BaseLayout title="Contact" description="Contact Visio Nova Mundi CIC about partnerships, research collaboration and proposed pilot programmes.">
  <h1>Contact Visio Nova Mundi CIC</h1>
  <p class="lead">The current contact route for partnerships, research collaboration, sponsorship and social-value discussions, pilot enquiries and European consortium enquiries is email.</p>
  <section class="card contact"><p class="eyebrow">Current contact</p><a class="email" href={`mailto:${email}`}>{email}</a><p>Please include your organisation, the purpose of your enquiry and any relevant context. We normally respond in writing first; a structured online meeting can be arranged where it is genuinely useful.</p></section>
  <section class="grid"><article class="card"><h2>Partnerships</h2><p>Research, operational, technology, pilot and social-value partnerships.</p></article><article class="card"><h2>Research collaboration</h2><p>Evidence, evaluation, methodology and European consortium discussions.</p></article><article class="card"><h2>Proposed programmes</h2><p>Discovery-stage Circular Justice and proposed Unity House community programme enquiries.</p></article></section>
  <section class="card enquiry"><p class="eyebrow">Structured enquiry</p><h2>Help us route your message</h2><form id="enquiry-form"><label>Enquiry type<select name="type" required><option value="">Choose one</option><option>Research or evaluation</option><option>Pilot or innovation programme</option><option>Community partnership</option><option>Volunteering</option><option>Sponsorship or funding</option><option>Other</option></select></label><label>Organisation<input name="organisation" placeholder="Organisation name" required /></label><label>What would you like to discuss?<textarea name="message" rows="4" placeholder="Briefly describe the opportunity or question" required></textarea></label><button class="btn primary" type="submit">Prepare email enquiry</button><p class="note">This opens your email app with the details filled in. Please do not include confidential, personal or sensitive information.</p></form></section>
  <section class="bar"><div><h2>Before you write</h2><p>Visio Nova Mundi CIC is developing evidence-led public-benefit programmes. Please do not send confidential, personal or sensitive information by email unless an appropriate route and safeguards have first been agreed.</p></div><a class="btn" href="/governance">Governance and transparency</a></section>
  <style>h1{margin:0 0 12px;font-size:clamp(36px,5vw,48px);letter-spacing:-.02em;color:var(--text)}.lead{margin:0 0 20px;max-width:85ch;color:var(--muted);line-height:1.75;font-size:18px}.card,.bar{border:1px solid var(--border);border-radius:18px;padding:18px;background:white;box-shadow:0 6px 24px rgba(0,0,0,.05)}.contact{background:linear-gradient(135deg,rgba(39,99,235,.07),rgba(16,185,129,.07));max-width:760px}.eyebrow{margin:0 0 8px;color:#0f766e;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:800}.email{display:inline-block;margin-bottom:12px;color:#1d4ed8;font-size:20px;font-weight:800;text-decoration:none;overflow-wrap:anywhere}.email:hover{text-decoration:underline}.contact p,.card p,.bar p{margin:0;color:var(--muted);line-height:1.75}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:14px}h2{margin:0 0 8px;font-size:17px;color:var(--text)}.bar{margin-top:14px;display:flex;gap:16px;justify-content:space-between;align-items:center}.bar>div{max-width:75ch}.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 14px;border:1px solid var(--border);border-radius:14px;background:white;color:var(--text);text-decoration:none;font-weight:800;white-space:nowrap}.btn:hover{border-color:rgba(0,0,0,.18)}@media(max-width:800px){.grid{grid-template-columns:1fr}.bar{flex-direction:column;align-items:stretch}.btn{width:fit-content}}</style>
  <script is:inline>
    const form = document.querySelector('#enquiry-form');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const subject = `${data.get('type')} enquiry — ${data.get('organisation')}`;
      const body = `Organisation: ${data.get('organisation')}\nEnquiry type: ${data.get('type')}\n\n${data.get('message')}`;
      window.location.href = `mailto:visionovamundi@outlook.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
