---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectUpdates from "../components/ProjectUpdates.astro";

const benefits = [
  {
    number: "01",
    title: "Stay ready",
    text: "Keep everyday grooming essentials organised between journeys.",
  },
  {
    number: "02",
    title: "Travel lighter",
    text: "Explore a more compact way to carry common personal-care items.",
  },
  {
    number: "03",
    title: "Simpler packing",
    text: "Reduce the need to rebuild the same grooming kit before every trip.",
  },
  {
    number: "04",
    title: "Validation ahead",
    text: "The concept remains exploratory and requires practical testing before product decisions are made.",
  },
];
---

<BaseLayout
  title="Vialora Voyage"
  description="Vialora Voyage is a premium travel-grooming concept designed to stay packed between trips."
>
  <section class="conceptHero voyageHero">
    <div class="heroCopy">
      <p class="eyebrow">Founder-led concept · Early concept development</p>
      <h1>VIALORA <span>VOYAGE</span></h1>
      <p class="heroMessage">Travel grooming, kept ready.</p>
      <p class="lead">Vialora Voyage is a premium travel-grooming concept designed to stay packed between trips. It explores a simpler way to keep personal-care essentials together and ready between journeys.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current stage</p>
      <h2>Early concept development</h2>
      <p>The concept remains exploratory and requires practical testing before product decisions are made.</p>
      <span class="stagePill">Concept development</span>
    </aside>
  </section>

  <p class="ownershipNote">Founder-led concept developed alongside the wider Visio Nova Mundi ecosystem. It is not presented as a CIC-operated programme; a separate legal or operating entity is not established in the current public project record.</p>
  <p class="separationNote">Vialora Voyage is a separate concept from the Vialora fragrance project.</p>

  <section class="section benefitsSection" aria-labelledby="benefits-heading">
    <div class="sectionHead">
      <p class="eyebrow">What the concept explores</p>
      <h2 id="benefits-heading">A simpler routine between trips</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="developmentSection" aria-labelledby="next-step-heading">
    <div>
      <p class="eyebrow">Project timeline</p>
      <h2 id="next-step-heading">Follow the concept timeline.</h2>
      <p>Follow the documented steps as the travel-grooming idea develops.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href="/timeline/">View the project timeline</a>
      <a class="btn" href="/projects/">Back to Projects</a>
    </div>
  </section>

  <style>
    .conceptHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 10px;color:#0f766e;text-transform:uppercase;letter-spacing:.075em;font-size:.875rem;font-weight:850}
    h1{margin:0 0 12px;color:#102741;font-size:clamp(40px,7vw,68px);letter-spacing:-.05em;line-height:1.02}
    h1 span{display:block;color:#0f766e;font-size:.78em;letter-spacing:-.04em}
    .heroMessage{margin:0 0 14px;color:var(--text);font-size:clamp(23px,3vw,31px);font-weight:760;letter-spacing:-.03em;line-height:1.2}
    .lead{margin:0;max-width:76ch;color:var(--muted);font-size:18px;line-height:1.8}
    .stageCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:rgba(255,255,255,.88);box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:21px;background:linear-gradient(135deg,rgba(15,118,110,.09),rgba(37,99,235,.055));border-color:rgba(15,118,110,.2)}
    .stageLabel{margin:0 0 9px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:.875rem;font-weight:850}
    .stageCard h2{margin:0 0 10px;color:var(--text);font-size:22px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.75}
    .stagePill{display:inline-flex;margin-top:15px;padding:7px 11px;border:1px solid rgba(15,118,110,.23);border-radius:999px;background:rgba(16,185,129,.08);color:#0f766e;font-size:.875rem;font-weight:850}
    .ownershipNote,.separationNote{margin:20px 0 0;padding:13px 16px;color:var(--muted);line-height:1.7}
    .ownershipNote{border-left:3px solid #0f766e;background:rgba(15,118,110,.055)}
    .separationNote{margin-top:9px;border:1px solid rgba(37,99,235,.16);border-radius:14px;background:rgba(37,99,235,.045)}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
    .benefitCard{min-height:174px;padding:20px;background:linear-gradient(135deg,rgba(15,118,110,.045),rgba(37,99,235,.035))}
    .benefitNumber{display:grid;place-items:center;width:35px;height:35px;margin-bottom:13px;border:1px solid rgba(15,118,110,.2);border-radius:50%;background:rgba(15,118,110,.07);color:#0f766e;font-size:.875rem;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:19px;letter-spacing:-.015em;text-transform:uppercase}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-top:22px;padding:21px 22px;border:1px solid rgba(15,118,110,.16);border-radius:20px;background:linear-gradient(135deg,rgba(15,118,110,.055),rgba(37,99,235,.05))}
    .developmentSection>div:first-child{max-width:76ch}
    .developmentSection>div>p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.8}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(15,118,110,.22);border-radius:999px;background:white;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn.primary{background:linear-gradient(135deg,rgba(15,118,110,.1),rgba(37,99,235,.1))}
    .btn:hover{text-decoration:none;border-color:rgba(15,118,110,.42)}
    @media(max-width:800px){.conceptHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.developmentSection{padding:18px}.actions{flex-direction:column}.btn{width:100%;white-space:normal;text-align:center}}
  </style>
  <ProjectUpdates project="vialora-voyage" />
</BaseLayout>
