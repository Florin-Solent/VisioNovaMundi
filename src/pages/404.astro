---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you requested could not be found on Visio Nova Mundi.">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404 · Page not found</p>
    <h1 id="not-found-title">This page has moved beyond the map.</h1>
    <p>The address may have changed. Continue from the Visio Nova Mundi home page or explore the founder’s journey.</p>
    <nav aria-label="Helpful pages">
      <a class="btn primary" href="/">Visit the home page</a>
      <a class="btn" href="/journey/">Explore the journey</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found{max-width:720px;margin:clamp(50px,12vh,130px) auto;padding:clamp(24px,5vw,54px);border:1px solid #c9d8dd;border-radius:24px;background:rgba(248,250,252,.92);box-shadow:0 24px 64px rgba(17,43,56,.08)}
  .eyebrow{color:#1d4ed8;font-size:.78rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  h1{max-width:13ch;color:#112b38;font-size:clamp(2.4rem,7vw,4.5rem);line-height:1.02;letter-spacing:-.045em}
  p:not(.eyebrow){max-width:56ch;color:#3e5563;line-height:1.7}
  nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  nav a{display:inline-flex;align-items:center;min-height:44px;padding:10px 18px;border:1px solid #2563eb;border-radius:999px;color:#1d4ed8;text-decoration:none;font-weight:750}
  nav a.primary{background:#2563eb;color:#fff}
  nav a:focus-visible{outline:3px solid #1d4ed8;outline-offset:3px}
</style>
