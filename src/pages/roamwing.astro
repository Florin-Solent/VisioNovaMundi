---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectUpdates from "../components/ProjectUpdates.astro";

const benefits = [
  {
    number: "01",
    title: "Hands-free capture",
    text: "Exploring how people could capture content without continuously holding a phone or camera.",
  },
  {
    number: "02",
    title: "Built for movement",
    text: "Focused on the realities of travelling and creating on location.",
  },
  {
    number: "03",
    title: "Creator mobility",
    text: "Intended to help creators move more naturally while recording.",
  },
  {
    number: "04",
    title: "Developed in stages",
    text: "Mechanical feasibility comes before any more advanced powered or smart features.",
  },
];
---

<BaseLayout
  title="RoamWing"
  description="RoamWing is an independent creator-travel concept exploring wearable hands-free filming while moving. Mechanical feasibility and user validation remain future work."
>
  <section class="conceptHero">
    <div class="heroCopy">
      <p class="eyebrow">Founder-led concept · Mechanical feasibility</p>
      <h1>ROAMWING</h1>
      <p class="heroMessage">Hands-free filming for people on the move.</p>
      <p class="lead">RoamWing is a founder-led creator-travel concept exploring a wearable, robotic-arm-style direction for hands-free filming while walking, travelling or creating on location. It remains in concept and mechanical-feasibility development and has not been commercially released. Public information stays high-level; no unpublished design or performance details are presented.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current stage</p>
      <h2>Mechanical feasibility</h2>
      <p>The concept is being developed in stages, with the core wearable filming idea taking priority before more advanced features.</p>
      <span class="stagePill">Concept development</span>
    </aside>
  </section>

  <p class="ownershipNote">Founder-led concept developed alongside the wider Visio Nova Mundi ecosystem. It is not presented as a CIC-operated programme; a separate legal or operating entity is not established in the current public project record.</p>

  <section class="section introSection" aria-labelledby="creator-heading">
    <div class="sectionHead">
      <p class="eyebrow">For creators on the move</p>
      <h2 id="creator-heading">Move more naturally while capturing a moment.</h2>
      <p>Travellers and creators can find it difficult to record while also moving through and taking part in a place. RoamWing explores whether hands-free filming could make content capture feel more mobile and natural.</p>
    </div>
  </section>

  <section class="section futureSection" aria-labelledby="relevance-heading">
    <div class="sectionHead">
      <p class="eyebrow">Potential creative relevance</p>
      <h2 id="relevance-heading">More attention for the moment being captured.</h2>
      <p>Hands-free recording could be relevant to creators who find it difficult to hold a camera while moving. This is a potential use case only; accessibility, comfort and creator needs have not yet been validated with users.</p>
    </div>
  </section>

  <section class="section benefitsSection" aria-labelledby="benefits-heading">
    <div class="sectionHead">
      <p class="eyebrow">What the concept explores</p>
      <h2 id="benefits-heading">Creator travel, with greater freedom of movement</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard vnm-glass-card">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section futureSection" aria-labelledby="future-heading">
    <div class="sectionHead">
      <p class="eyebrow">The wider vision</p>
      <h2 id="future-heading">More natural ways to create on location.</h2>
      <p>The long-term aim is to explore a more mobile creator experience. Future features would only be considered after the core concept has progressed through mechanical-feasibility work.</p>
    </div>
  </section>

  <section class="developmentSection">
    <div>
      <p class="eyebrow">In development</p>
      <h2>Feasibility before advanced features.</h2>
      <p>RoamWing remains a developing concept and is not commercially available. Mechanical practicality, wearability and user experience require future validation. No performance or certification is claimed.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href="/timeline">View the project timeline</a>
      <a class="btn" href="/projects">Back to Projects</a>
    </div>
  </section>

  <style>
    .conceptHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 9px;color:#4f46e5;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:850}
    h1{margin:0 0 10px;color:var(--text);font-size:clamp(42px,7vw,66px);letter-spacing:-.045em}
    .heroMessage{margin:0 0 13px;color:var(--text);font-size:clamp(22px,3vw,30px);font-weight:750;letter-spacing:-.025em;line-height:1.25}
    .lead{margin:0;max-width:76ch;color:var(--muted);font-size:18px;line-height:1.8}
    .stageCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:white;box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:20px;background:linear-gradient(135deg,rgba(79,70,229,.085),rgba(37,99,235,.065));border-color:rgba(79,70,229,.2)}
    .stageLabel{margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:12px;font-weight:850}
    .stageCard h2{margin:0 0 9px;color:var(--text);font-size:21px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.7}
    .stagePill{display:inline-flex;margin-top:14px;padding:7px 10px;border:1px solid rgba(79,70,229,.2);border-radius:999px;background:rgba(79,70,229,.07);color:#4338ca;font-size:12px;font-weight:850}
    .ownershipNote{margin:22px 0 0;padding:13px 16px;border-left:3px solid #4f46e5;background:rgba(79,70,229,.055);color:var(--muted);line-height:1.7}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .sectionHead>p:not(.eyebrow),.developmentSection>div>p:not(.eyebrow){margin:0;max-width:82ch;color:var(--muted);line-height:1.8}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
    .benefitCard{min-height:170px;padding:20px;background:linear-gradient(135deg,rgba(79,70,229,.045),rgba(37,99,235,.045))}
    .benefitNumber{display:grid;place-items:center;width:34px;height:34px;margin-bottom:13px;border:1px solid rgba(79,70,229,.2);border-radius:50%;background:rgba(79,70,229,.07);color:#4338ca;font-size:12px;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:18px;letter-spacing:-.015em}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .futureSection,.developmentSection{padding:21px 22px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(79,70,229,.055),rgba(37,99,235,.05))}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-top:20px}
    .developmentSection>div:first-child{max-width:76ch}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(79,70,229,.22);border-radius:999px;background:white;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn.primary{background:linear-gradient(135deg,rgba(79,70,229,.1),rgba(37,99,235,.1))}
    .btn:hover{text-decoration:none;border-color:rgba(79,70,229,.4)}
    @media(max-width:800px){.conceptHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.futureSection,.developmentSection{padding:18px}.actions{flex-direction:column}.btn{width:100%;white-space:normal;text-align:center}}
  </style>
  <ProjectUpdates project="roamwing" />
</BaseLayout>
