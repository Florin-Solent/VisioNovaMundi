---
import BaseLayout from "../layouts/BaseLayout.astro";
import EngagementPackages from "../components/EngagementPackages.astro";
---
<BaseLayout title="Our Work" description="Bounded discovery, evaluation and circular-systems feasibility scopes from Visio Nova Mundi CIC.">
  <section class="institutional-hero"><p class="institutional-eyebrow">Evidence-led institutional engagements</p><h1>Our Work</h1><p class="institutional-lead">Understand a practical problem. Test a proportionate response. Measure what happens and decide what should happen next.</p><a class="btn" href="/commissioners-partners/">For Commissioners &amp; Partners</a></section>
  <section class="institutional-section"><h2>Three bounded engagement packages</h2><p>We begin with a written discovery conversation and agree a scope that fits the question, evidence, capacity and safeguards.</p><EngagementPackages /></section>
  <section class="institutional-panel"><h2>Discover → Pilot → Measure → Refine → Decide</h2><p>Evidence can support stopping, refining, continuing, evaluating further or scaling. Not every pilot should grow, and the next step is not predetermined.</p><div class="institutional-actions"><a href="/programmes/">Current programmes and proposed work →</a><a href="/governance/">Governance →</a><a href="/contact/">Discuss a scoped engagement →</a></div></section>
  <style>
    h1 {
      margin: 0 0 12px;
      font-size: 40px;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .lead {
      margin: 0 0 18px;
      color: var(--muted);
      line-height: 1.75;
      font-size: 18px;
      max-width: 90ch;
    }

    .grid {
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      background: white;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    }

    .card h2 {
      margin: 0 0 10px;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: var(--text);
    }

    .card p {
      margin: 0 0 12px;
      color: var(--muted);
      line-height: 1.75;
    }

    .card ul {
      margin: 0;
      padding-left: 18px;
      color: var(--muted);
      line-height: 1.85;
    }

    .link {
      display: inline-block;
      margin-top: 12px;
      font-weight: 850;
      color: rgba(39, 99, 235, 0.95);
      text-decoration: none;
    }

    .link:hover {
      text-decoration: underline;
    }

    .bar {
      margin-top: 14px;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      background: linear-gradient(135deg, rgba(39, 99, 235, 0.06), rgba(16, 185, 129, 0.06));
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
    }

    .bar h3 {
      margin: 0 0 6px;
      font-size: 16px;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .bar p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
      max-width: 80ch;
    }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      padding: 11px 14px;
      border: 1px solid var(--border);
      background: white;
      color: var(--text);
      text-decoration: none;
      font-weight: 850;
    }

    .btn.primary {
      background: linear-gradient(135deg, rgba(39, 99, 235, 0.10), rgba(16, 185, 129, 0.10));
      border-color: rgba(39, 99, 235, 0.25);
    }

    .btn:hover {
      border-color: rgba(0, 0, 0, 0.18);
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: 1fr;
      }
      .bar {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
