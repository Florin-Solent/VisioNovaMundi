    .gate-blueprint .label-lock { color: #2f7e83; }
    .book-ii-preview { background-image: linear-gradient(135deg,rgba(37,99,235,.10),rgba(16,185,129,.08)); background-color: var(--glass); }
    .tags span { border-color: rgba(37,99,235,.22); background: rgba(37,99,235,.07); color: #1d4ed8; }
    .archiveSide { background: linear-gradient(135deg,rgba(37,99,235,.08),rgba(16,185,129,.08)); }
  </style>

  <script is:inline>
    const threshold = document.querySelector("[data-threshold]");
    const thresholdMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (threshold && !thresholdMotion.matches && window.matchMedia("(pointer: fine)").matches) {
      const resetThreshold = () => {
        threshold.style.setProperty("--threshold-x", "0deg");
        threshold.style.setProperty("--threshold-y", "0deg");
      };

      threshold.addEventListener("pointermove", (event) => {
        const bounds = threshold.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        threshold.style.setProperty("--threshold-x", `${Math.max(-1, Math.min(1, y)) * -5}deg`);
        threshold.style.setProperty("--threshold-y", `${Math.max(-1, Math.min(1, x)) * 6}deg`);
      });

      threshold.addEventListener("pointerleave", resetThreshold);
    }
  </script>

  <script>
    import { mountCosmicWorld } from "../scripts/cosmic-world";

    mountCosmicWorld();
  </script>
</BaseLayout>
