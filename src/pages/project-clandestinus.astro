    .archive-hero .btn { border-color: rgba(37,99,235,.25); background: var(--glass); color: var(--text); box-shadow: inset 0 1px 0 rgba(255,255,255,.72); }
    .archive-hero .btn.primary { border-color: rgba(167,127,61,.72); background: linear-gradient(135deg,#d7bc7d,#b89456); color: #192d45; }
