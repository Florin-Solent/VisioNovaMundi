    .archive-hero .threshold-pin.pin-one { border-color: rgba(37,99,235,.28); background: rgba(255,255,255,.62); color: #1d4ed8; }
    .archive-hero .phase-badge { color: #1d4ed8 !important; }
    .archive-hero .phase-dot { background: #3b82f6; box-shadow: 0 0 0 5px rgba(59,130,246,.12); }
    .archive-hero .noncanonical-watermark { color: rgba(37,99,235,.68); }
