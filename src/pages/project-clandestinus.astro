    .threshold-visual::before { border-color: rgba(105,139,177,.38); box-shadow: inset 0 0 0 7px rgba(255,255,255,.18), inset 0 0 0 8px rgba(105,139,177,.12); }
    .threshold-visual::after { border-color: rgba(47,126,131,.38); }
    .threshold-engraving { color: rgba(77,105,137,.76); }
    .engraving-two { color: rgba(47,126,131,.76); }
    .blueprint-kicker, .blueprint-label { color: #476b91; }
    .label-lock { color: #99733a; }
    .threshold-stamp { background: rgba(255,255,255,.22); color: rgba(40,70,99,.82); border-color: rgba(78,116,151,.52); box-shadow: 0 0 22px rgba(87,151,197,.18), inset 0 0 16px rgba(255,255,255,.3); }
    .threshold-pin { background: rgba(255,255,255,.62); color: #55718f; border-color: rgba(83,124,163,.45); }
    .pin-two { color: #2f7e83; }
    .pin-three { color: #7563a3; }
    .phase-badge { color: #81642d !important; }
