255,255,255,.9))}.note{margin-top:12px!important;font-size:13px}.textLink{display:inline-block;margin-top:16px;color:#1d4ed8;font-weight:800;text-decoration:none}.sectionHead{margin-top:34px}.sectionHead p{margin:0;max-width:85ch}.benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:14px}.benefits article{border:1px solid var(--border);border-radius:18px;padding:17px;background:white}.benefits p{margin:0}.boundary{margin-top:34px;background:linear-gradient(135deg,rgba(37,99,235,.06),rgba(16,185,129,.08))}.boundary p{margin:0 0 12px;max-width:95ch}@media(max-width:800px){.grid,.benefits{grid-template-columns:1fr}.hero{padding:24px 18px}}
  </style>
</BaseLayout>
