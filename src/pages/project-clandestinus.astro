    .threshold-frame { position: absolute; z-index: 2; pointer-events: none; border: 1px solid rgba(215,193,139,.36); border-radius: 50%; }
    .threshold-frame-one { inset: 11%; transform: rotate(25deg) scaleY(.56); box-shadow: 0 0 18px rgba(198,155,86,.12); }
    .threshold-frame-two { inset: 16%; transform: rotate(-42deg) scaleY(.62); border-color: rgba(72,209,204,.34); border-style: dashed; }
    .threshold-stamp { position: absolute; top: 50%; left: 50%; z-index: 3; display: grid; place-items: center; width: 84px; height: 84px; border: 1px solid rgba(241,226,186,.62); border-radius: 50%; background: rgba(7,18,36,.24); color: rgba(242,226,183,.78); font-size: 18px; font-weight: 900; letter-spacing: .18em; text-indent: .18em; transform: translate(-50%,-50%); mix-blend-mode: screen; pointer-events: none; box-shadow: 0 0 22px rgba(32,178,170,.16), inset 0 0 16px rgba(72,209,204,.08); }
    .threshold-stamp::before { content: ""; position: absolute; inset: 10px; border: 1px solid rgba(215,193,139,.34); border-radius: 50%; }
    .cosmic-threshold .threshold-pin { z-index: 4; }

