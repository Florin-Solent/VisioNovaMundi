---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusGovernance from "../components/StatusGovernance.astro";
import ProjectUpdates from "../components/ProjectUpdates.astro";
---

<BaseLayout title="Project Clandestinus" description="Project Clandestinus is an independent creative and publishing venture in the Creative & Cultural Innovation branch of the Tree of Life ecosystem.">
  <section class="hero archive archive-hero vnm-glass-card">
    <div class="archive-copy">
      <p class="eyebrow"><span class="archive-eyebrow-mark" aria-hidden="true"></span>Creative &amp; Cultural Innovation · Tree of Life</p>
      <p class="archiveMark" aria-hidden="true">✦ ◇ ✦</p>
      <h1>A book. A code. A world built to be discovered.</h1>
      <p class="lead">Project Clandestinus is an independent creative and publishing venture built around mystery, hidden symbols, coded messages, reader participation and discovery.</p>
      <div class="actions"><a class="btn primary" href="https://projectclandestinus.com">Visit Project Clandestinus</a><a class="btn" href="/tree-of-life">Explore the Tree of Life</a></div>
    </div>

    <div class="threshold-panel">
      <div class="threshold-visual cosmic-threshold" data-threshold data-orrery aria-hidden="true">
        <canvas class="cosmic-canvas" data-cosmic-canvas></canvas>
      </div>
    </div>
  </section>

  <section class="panel tilt-card" data-tilt-card><h2>More than a traditional book</h2><p>Clandestinus invites readers to examine a story as well as follow it: looking for symbols, patterns, visual codes and layered mysteries; testing interpretations; and uncovering what may sit beneath the visible surface.</p><div class="tags"><span>Symbolic manuscripts</span><span>Hidden patterns</span><span>Visual codes</span><span>Decoding challenges</span><span>Shared discovery</span><span>Future artefacts &amp; experiences</span></div></section>

  <section class="grid book-i-grid">
    <article class="panel book-i-card tilt-card" data-tilt-card>
      <figure class="book-i-cover">
        <img
          src="/images/clandestinus-book-i-cover.webp"
          alt="Cover of Clandestinus Book I, The First Gate"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="book-i-purchase actions">
        <a
          class="btn primary"
          href="https://www.amazon.com/dp/B0GYS7TTGS"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Buy the Clandestinus Book I paperback on Amazon"
        >
          Buy the paperback
        </a>
      </div>
      <p class="eyebrow">Book I · Paperback available</p>
      <h2>The First Gate</h2>
      <p>The opening symbolic manuscript invites readers to study signs, patterns, placement and structure — and investigate whether a deeper message exists within the work.</p>
      <p class="format-note"><strong>Hardcover</strong> Future edition planned.</p>
      <a class="textLink" href="https://projectclandestinus.com/book">Discover Book I →</a>
    </article>
    <article class="panel archiveSide tilt-card" data-tilt-card>
      <p class="eyebrow">The wider world</p>
      <h2>A growing creative universe</h2>
      <p>Future possibilities include further books, deeper coded structures, physical artefacts, collector editions, verified discovery stages and carefully developed interactive or immersive experiences.</p>
      <p class="note">Each expansion is subject to its own development, feasibility, funding and legal requirements.</p>
    </article>
  </section>

  <section class="book-ii-preview panel" aria-labelledby="book-ii-preview-title">
    <div class="sectionHead book-ii-heading">
      <p class="eyebrow">Book II · Paperback + hardcover available</p>
      <h2 id="book-ii-preview-title">The Jade Eclipse in two editions</h2>
      <p>
        Book II is now available in paperback as the black-and-white Text Edition and in
        hardcover as the colour Photo Edition.
      </p>
      <p class="note">Prize and reward features are still under review. We have sought guidance from the relevant industry association and are awaiting legal confirmation before finalising this part of the project.</p>
    </div>

    <div class="book-ii-editions">
      <article class="book-ii-edition tilt-card" data-tilt-card>
        <figure class="book-ii-cover">
          <img
            src="/images/clandestinus-book-ii-text-cover.jpg"
            alt="Cover preview for The Jade Eclipse Book II Text Edition"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="eyebrow">Text Edition</p>
        <h3>The Jade Eclipse</h3>
        <p>Black-and-white paperback edition.</p>
        <div class="actions">
          <a class="btn primary" href="https://www.amazon.com/dp/9781066658008" target="_blank" rel="noopener noreferrer">Buy the paperback</a>
        </div>
      </article>

      <article class="book-ii-edition tilt-card" data-tilt-card>
        <figure class="book-ii-cover">
          <img
            src="/images/clandestinus-book-ii-photo-cover.jpg"
            alt="Cover preview for The Jade Eclipse Book II Photo Edition"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <p class="eyebrow">Photo Edition</p>
        <h3>The Jade Eclipse</h3>
        <p>Colour photo edition hardcover.</p>
        <div class="actions">
          <a class="btn primary" href="https://www.amazon.com/dp/B0HJM8KC2M" target="_blank" rel="noopener noreferrer" aria-label="Buy The Jade Eclipse hardcover on Amazon">Buy the hardcover</a>
        </div>
      </article>
    </div>
  </section>

  <section><div class="sectionHead"><p class="eyebrow">Why it belongs in Tree of Life</p><h2>Independent venture. Shared purpose.</h2><p>Project Clandestinus remains independently owned and operated. Its inclusion within Tree of Life reflects its place within the founder's wider innovation ecosystem; it does not create a financial, legal or operational dependency between Project Clandestinus and Visio Nova Mundi CIC.</p></div><div class="benefits"><article class="tilt-card" data-tilt-card><h3>Curiosity &amp; critical thinking</h3><p>Decoding encourages attention to detail, evidence and interpretation.</p></article><article class="tilt-card" data-tilt-card><h3>Active reading</h3><p>Readers are invited to interact with a book rather than consume it passively.</p></article><article class="tilt-card" data-tilt-card><h3>Shared discovery</h3><p>A mystery world can connect readers, puzzle-solvers, collectors and creative communities.</p></article></div></section>

  <StatusGovernance stage="Independent founder venture" operator="Independent of Visio Nova Mundi CIC; the canonical register does not establish a named legal trading entity." delivery="Independent creative and publishing activity; current offers are described on the venture's own site." funding="Separate finances; CIC grants or sponsorship do not automatically finance it." boundary="Ownership, IP, publishing activities, contracts, reward or prize obligations and legal responsibilities do not transfer to the CIC through Tree of Life." />
  <section class="development-panel" aria-labelledby="clandestinus-development-title">
    <p class="eyebrow">Current development</p>
    <h2 id="clandestinus-development-title">More of the world is taking shape.</h2>
    <ul>
      <li><strong>Secret App:</strong> a private communication experience in active private development; it has not been publicly released.</li>
      <li><strong>Connected Clothing:</strong> an NFC-first concept in development. Technical feasibility remains subject to further work and funding; no formal partnership is confirmed.</li>
      <li><strong>First Clandestinus Game:</strong> in early development as an interactive extension combining storytelling, learning and digital experiences.</li>
    </ul>
    <a class="textLink" href="/clandestinus-secret-app/">Explore the Secret App concept →</a>
  </section>

  <div class="actions"><a class="btn primary" href="https://projectclandestinus.com">Enter the archive</a><a class="btn" href="/ventures/">Independent Founder Ventures</a></div>
  <ProjectUpdates project="project-clandestinus" />

  <style>
    .development-panel{margin-top:28px;padding:23px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(135deg,rgba(37,99,235,.05),rgba(16,185,129,.06))}.development-panel h2{margin:0 0 11px}.development-panel ul{display:grid;gap:9px;margin:0;padding-left:22px;color:var(--muted);line-height:1.7}.development-panel li::marker{color:#0f766e}.development-panel strong{color:var(--text)}
    .hero{position:relative;overflow:hidden;padding:28px 24px;border:1px solid rgba(122,92,40,.25);border-radius:24px;background:linear-gradient(135deg,rgba(37,99,235,.08),rgba(16,185,129,.06)),radial-gradient(circle at 90% 12%,rgba(180,137,54,.14),transparent 30%)}.archive:before{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(135deg,transparent 0 18px,rgba(130,97,36,.025) 18px 19px)}.eyebrow{position:relative;margin:0 0 9px;color:#0f766e;text-transform:uppercase;letter-spacing:.08em;font-size:12px;font-weight:850}.archiveMark{position:relative;margin:0 0 12px;color:#9a7128;letter-spacing:.45em;font-size:18px}h1,h2,h3{position:relative;color:var(--text);letter-spacing:-.025em}h1{max-width:16ch;margin:0 0 14px;font-size:clamp(42px,6vw,64px);line-height:1.02}h2{margin:0 0 10px;font-size:clamp(24px,3vw,31px)}h3{margin:0 0 8px;font-size:17px}.lead,p{position:relative;color:var(--muted);line-height:1.75}.lead{max-width:75ch;margin:0;font-size:19px}.actions{position:relative;display:flex;gap:12px;flex-wrap:wrap;margin-top:19px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 14px;border:1px solid var(--border);border-radius:14px;background:white;color:var(--text);font-weight:800;text-decoration:none}.btn.primary{border-color:rgba(122,92,40,.36);background:linear-gradient(135deg,rgba(180,137,54,.18),rgba(16,185,129,.12))}.panel,.boundary{border:1px solid var(--border);border-radius:20px;padding:21px;background:rgba(255,255,255,.84);box-shadow:0 8px 26px rgba(0,0,0,.04)}.panel{margin-top:26px}.panel p{margin:0;max-width:90ch}.tags{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.tags span{padding:8px 10px;border:1px solid rgba(122,92,40,.2);border-radius:999px;background:rgba(180,137,54,.07);color:#68501f;font-size:13px;font-weight:750}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid .panel{margin-top:14px}.archiveSide{background:linear-gradient(135deg,rgba(180,137,54,.07),rgba(255,255,255,.9))}.note{margin-top:12px!important;font-size:13px}.textLink{display:inline-block;margin-top:16px;color:#1d4ed8;font-weight:800;text-decoration:none}.sectionHead{margin-top:34px}.sectionHead p{margin:0;max-width:85ch}.benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:14px}.benefits article{border:1px solid var(--border);border-radius:18px;padding:17px;background:white}.benefits p{margin:0}.boundary{margin-top:34px;background:linear-gradient(135deg,rgba(37,99,235,.06),rgba(16,185,129,.08))}.boundary p{margin:0 0 12px;max-width:95ch}@media(max-width:800px){.grid,.benefits{grid-template-columns:1fr}.hero{padding:24px 18px}}
  </style>

  <style>
    .archive-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(330px, .92fr);
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
      min-height: 590px;
      padding: clamp(32px, 5vw, 62px);
      border: 1px solid rgba(212, 175, 55, .18);
      border-radius: 29px;
      background:
        radial-gradient(130% 120% at 85% 15%, rgba(13, 37, 63, .72) 0%, rgba(5, 12, 24, .91) 100%),
        radial-gradient(circle at 15% 12%, rgba(212, 175, 55, .13), transparent 28%);
      -webkit-backdrop-filter: blur(24px) saturate(140%);
      backdrop-filter: blur(24px) saturate(140%);
      box-shadow:
        0 20px 50px rgba(2, 6, 15, .7),
        inset 0 1px 1px rgba(255, 255, 255, .12),
        inset 0 0 20px rgba(32, 178, 170, .06);
      color: #f5efdf;
    }

    .archive-hero::before {
      opacity: .28;
      background-image:
        linear-gradient(rgba(177, 203, 205, .08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(177, 203, 205, .08) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(90deg, black, transparent 88%);
    }

    .archive-hero::after {
      content: "";
      position: absolute;
      inset: auto -8% -42% 20%;
      height: 58%;
      background: radial-gradient(ellipse, rgba(19, 112, 121, .18), transparent 66%);
      filter: blur(18px);
      pointer-events: none;
    }

    .archive-copy { position: relative; z-index: 2; max-width: 650px; }

    .archive-hero .eyebrow {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      color: #a4bdc4;
    }

    .archive-eyebrow-mark {
      display: inline-block;
      width: 30px;
      height: 1px;
      background: linear-gradient(90deg, #d7c18b, rgba(215,193,139,0));
    }

    .archive-hero .archiveMark { color: #d7c18b; opacity: .9; }

    .archive-hero h1 {
      max-width: 12ch;
      color: #f8f2e6;
      font-size: clamp(42px, 5.8vw, 69px);
      line-height: .99;
      text-wrap: balance;
    }

    .archive-hero .lead { color: #b7c6c8; max-width: 62ch; }

    .archive-hero .btn {
      border-color: rgba(194, 214, 211, .22);
      background: rgba(255,255,255,.06);
      color: #f8f2e6;
    }

    .archive-hero .btn.primary {
      border-color: #d7c18b;
      background: linear-gradient(135deg, #d7c18b, #af9360);
      color: #0a1722;
    }

    .archive-hero .btn:hover { border-color: rgba(215,193,139,.72); }

    .threshold-panel { position: relative; z-index: 1; min-width: 0; }

    .threshold-topline {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin: 0 0 13px;
      color: #8ea9b0;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .threshold-topline span:last-child { color: #d7c18b; }

    .threshold-visual {
      --threshold-x: 0deg;
      --threshold-y: 0deg;
      position: relative;
      width: min(100%, 480px);
      aspect-ratio: 1;
      margin: 0 auto;
      overflow: hidden;
      border: 1px solid rgba(171, 206, 205, .28);
      border-radius: 50%;
      background:
        radial-gradient(circle at 50% 50%, rgba(52, 130, 133, .18), transparent 26%),
        radial-gradient(circle at 50% 50%, #18242c 0%, #0a151f 63%, #050d16 100%);
      box-shadow:
        0 0 0 12px rgba(166, 197, 194, .04),
        0 0 0 13px rgba(166, 197, 194, .1),
        0 24px 70px rgba(1,8,16,.42),
        inset 0 0 52px rgba(1,10,20,.74);
      transform: perspective(1100px) rotateX(var(--threshold-x)) rotateY(var(--threshold-y));
      transform-style: preserve-3d;
      transition: transform .65s cubic-bezier(.22,1,.36,1), box-shadow .65s ease;
      will-change: transform;
    }

    .threshold-visual::before,
    .threshold-visual::after {
      content: "";
      position: absolute;
      inset: 7%;
      border: 1px solid rgba(215,193,139,.38);
      border-radius: 50%;
      box-shadow: inset 0 0 0 7px rgba(7, 18, 36, .48), inset 0 0 0 8px rgba(215,193,139,.12);
    }

    .threshold-visual::after { inset: 18%; border-color: rgba(143,208,200,.25); transform: rotate(28deg) scaleY(.78); }

    .threshold-orbit { position: absolute; border: 1px solid rgba(215,193,139,.36); border-radius: 50%; pointer-events: none; }
    .threshold-orbit-one { inset: 12% 24%; transform: rotate(26deg); border-style: dashed; border-color: rgba(215,193,139,.52); }
    .threshold-orbit-two { inset: 24% 12%; transform: rotate(-31deg); border-color: rgba(143,208,200,.28); }
    .threshold-orbit-three { inset: 31% 16%; transform: rotate(67deg); border-style: dashed; border-color: rgba(181,163,223,.28); }

    .threshold-engraving {
      position: absolute;
      z-index: 1;
      color: rgba(215,193,139,.58);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .28em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .engraving-one { top: 16%; left: 50%; transform: translateX(-50%) rotate(-16deg); }
    .engraving-two { right: 13%; bottom: 24%; transform: rotate(-56deg); color: rgba(143,208,200,.48); }

    .threshold-seal {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 116px;
      height: 116px;
      border: 1px solid rgba(241,226,186,.72);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 25%, #e9d49b, #a47f43 45%, #453521 100%);
      box-shadow: 0 0 28px rgba(215,193,139,.26), inset 0 2px 9px rgba(255,248,217,.4);
      color: #1c241f;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: .18em;
      text-indent: .18em;
      transform: translate(-50%,-50%) translateZ(28px);
    }

    .threshold-seal::before,
    .threshold-seal::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(40,40,31,.35);
      border-radius: 50%;
    }

    .threshold-seal::before { inset: 12px; }
    .threshold-seal::after { inset: 21px; transform: rotate(45deg) scaleY(.62); }

    .threshold-pin {
      position: absolute;
      z-index: 3;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border: 1px solid rgba(215,193,139,.55);
      border-radius: 50%;
      background: rgba(4,16,28,.76);
      color: #d7c18b;
      font-size: 10px;
      font-weight: 800;
    }

    .pin-one { top: 19%; right: 22%; }
    .pin-two { bottom: 17%; left: 22%; color: #8fd0c8; }
    .pin-three { top: 45%; left: 12%; color: #b5a3df; }

    .phase-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 17px 0 0;
      color: #d8c79e !important;
      font-size: 12px !important;
      font-weight: 800;
      letter-spacing: .04em;
    }

    .phase-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #d7c18b; box-shadow: 0 0 0 5px rgba(215,193,139,.1); }
    .threshold-note { margin: 7px 0 0; color: #829ba1 !important; font-size: 12px !important; line-height: 1.55 !important; }

    .gate-blueprint {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: grid;
      place-items: center;
      color: #9fe5e0;
      background: radial-gradient(circle at center, rgba(9,38,58,.92), rgba(4,13,24,.97) 72%);
      opacity: 0;
      pointer-events: none;
      transition: opacity .8s ease;
    }

    .gate-blueprint svg { width: 78%; height: 78%; fill: none; stroke: rgba(143,208,200,.78); stroke-width: 1.2; filter: drop-shadow(0 0 7px rgba(32,178,170,.32)); }
    .gate-blueprint svg circle { stroke: rgba(215,193,139,.66); }
    .blueprint-kicker, .blueprint-label { position: absolute; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .12em; text-transform: uppercase; }
    .blueprint-kicker { top: 13%; color: #d7c18b; font-size: 10px; }
    .blueprint-label { color: rgba(159,229,224,.74); font-size: 8px; }
    .label-intake { left: 13%; top: 48%; }
    .label-lock { right: 14%; top: 30%; color: #d7c18b; }
    .label-exit { bottom: 13%; left: 50%; transform: translateX(-50%); white-space: nowrap; }
    .gate-complete .gate-blueprint { opacity: 1; }
    .noncanonical-watermark { position: absolute; right: 8%; bottom: 8%; z-index: 6; color: rgba(215,193,139,.54); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 8px; letter-spacing: .1em; text-align: right; pointer-events: none; }

    @media (max-width: 800px) {
      .archive-hero { grid-template-columns: 1fr; min-height: 0; padding: 29px 19px 34px; }
      .archive-copy { max-width: 720px; }
      .threshold-panel { width: min(100%, 540px); margin: 0 auto; }
      .threshold-visual { width: min(100%, 470px); }
    }

    @media (max-width: 430px) {
      .archive-hero h1 { font-size: clamp(39px, 12vw, 54px); }
      .threshold-topline { font-size: 9px; }
      .threshold-engraving { font-size: 7px; }
      .threshold-seal { width: 92px; height: 92px; font-size: 20px; }
      .threshold-seal::before { inset: 9px; }
      .threshold-seal::after { inset: 16px; }
      .noncanonical-watermark { right: 12%; bottom: 7%; max-width: 150px; font-size: 7px; line-height: 1.4; }
    }

    @media (prefers-reduced-motion: reduce) {
      .threshold-visual { transform: none; transition: none; }
      .gate-blueprint { transition: none; }
    }
  </style>

  <style>
    .book-ii-preview {
      margin-top: 26px;
      background: linear-gradient(135deg, rgba(180,137,54,.08), rgba(255,255,255,.92));
    }

    .book-ii-heading {
      margin-top: 0;
      max-width: 780px;
    }

    .book-ii-editions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 22px;
    }

    .book-ii-edition {
      border: 1px solid rgba(122,92,40,.2);
      border-radius: 18px;
      padding: 14px;
      background: rgba(255,255,255,.78);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .book-ii-edition:hover {
      transform: translateY(-3px);
      border-color: rgba(122,92,40,.42);
      box-shadow: 0 14px 30px rgba(0,0,0,.08);
    }

    .book-ii-cover {
      margin: 0 0 15px;
      overflow: hidden;
      aspect-ratio: 7 / 10;
      background: #102323;
    }

    .book-ii-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .book-ii-edition .eyebrow {
      margin-bottom: 6px;
    }

    .book-ii-edition p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 800px) {
      .book-ii-editions {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <style>
    .book-i-card {
      display: flex;
      flex-direction: column;
      background: linear-gradient(135deg, rgba(37,99,235,.07), rgba(255,255,255,.88));
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .book-i-card:hover {
      transform: translateY(-3px);
      border-color: rgba(122,92,40,.42);
      box-shadow: 0 14px 30px rgba(0,0,0,.08);
    }

    .book-i-cover {
      width: min(100%, 360px);
      margin: 0 0 15px;
      overflow: hidden;
      aspect-ratio: 2 / 3;
      border: 1px solid rgba(122,92,40,.24);
      background: #17130e;
      box-shadow: 0 16px 30px rgba(0,0,0,.12), 0 0 0 6px rgba(255,255,255,.32);
    }

    .book-i-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .book-i-purchase {
      margin: 0 0 19px;
    }

    .book-i-purchase .btn {
      width: fit-content;
    }

    .book-i-card .eyebrow {
      margin-bottom: 6px;
    }

    .format-note {
      margin-top: 16px !important;
      padding: 10px 12px;
      border: 1px solid rgba(37,99,235,.2);
      background: rgba(37,99,235,.06);
      color: #45627a !important;
      font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
      font-size: 12px;
      letter-spacing: .02em;
    }

    .format-note strong {
