---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projectGroups } from "../data/projects";

const projectOrder = new Map<string, number>();
projectGroups.forEach((group) => group.projects.forEach((project) => projectOrder.set(project.href, projectOrder.size)));
---

<BaseLayout
  title="Projects"
  description="A clear portfolio of Visio Nova Mundi public-benefit work, research and independent founder ventures, with project status and responsibilities identified."
>
  <div class="projects-page">
    <header class="projects-hero">
      <p class="eyebrow">Visio Nova Mundi · portfolio</p>
      <h1>Projects</h1>
      <p class="hero-copy">A portfolio of public-benefit work, research and independent founder ventures. Each project has its own status, development path and responsibilities.</p>
      <p class="framework-note"><strong>Tree of Life is VNM’s social-impact framework. Projects is the portfolio.</strong> A listing does not by itself establish CIC ownership, funding or operation. <a href="/tree-of-life/">Explore Tree of Life →</a></p>
    </header>

    {projectGroups.map((group, groupIndex) => (
      <section class="portfolio-group" id={group.id} aria-labelledby={`${group.id}-heading`}>
        <div class="group-heading">
          <p class="group-index">{String(groupIndex + 1).padStart(2, "0")}</p>
          <div>
            <h2 id={`${group.id}-heading`}>{group.title}</h2>
            <p>{group.intro}</p>
          </div>
        </div>
        <div class="project-list">
          {group.projects.map((project) => <ProjectCard project={project} order={projectOrder.get(project.href) ?? 0} />)}
        </div>
      </section>
    ))}

    <section class="portfolio-contact" aria-labelledby="portfolio-contact-heading">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2 id="portfolio-contact-heading">Have a project opportunity?</h2>
        <p>We welcome enquiries about community pilots, research, evaluation and responsible collaboration.</p>
      </div>
      <a class="contact-link" href="/contact/">Contact Visio Nova Mundi <span aria-hidden="true">→</span></a>
    </section>
  </div>

  <style>
    .projects-page { max-width: 1110px; margin: 0 auto; padding-bottom: 20px; }
    .projects-hero { padding: clamp(25px, 5vw, 58px); border: 1px solid var(--border); border-radius: 27px; background: linear-gradient(135deg, rgba(37, 99, 235, .075), rgba(16, 185, 129, .07)); }
    .eyebrow { margin: 0 0 9px; color: #0f766e; font-size: .78rem; font-weight: 850; letter-spacing: .09em; text-transform: uppercase; }
    h1 { margin: 0 0 14px; color: var(--text); font-size: clamp(2.6rem, 7vw, 4.5rem); letter-spacing: -.055em; line-height: .98; }
    .hero-copy { max-width: 76ch; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.75; }
    .framework-note { max-width: 100ch; margin: 21px 0 0; padding: 14px 17px; border-left: 3px solid #0f766e; background: rgba(255, 255, 255, .6); color: var(--muted); font-size: .94rem; line-height: 1.7; }
    .framework-note strong { color: var(--text); }
    .framework-note a { color: #1d4ed8; font-weight: 750; text-underline-offset: 3px; }

    .portfolio-group { margin-top: clamp(42px, 6vw, 68px); scroll-margin-top: 110px; }
    .group-heading { display: grid; grid-template-columns: 38px minmax(0, 1fr); align-items: start; gap: 12px; margin-bottom: 17px; }
    .group-index { margin: 5px 0 0; color: #0f766e; font-size: .77rem; font-weight: 850; letter-spacing: .08em; }
    .group-heading h2 { margin: 0 0 5px; color: var(--text); font-size: clamp(1.42rem, 2.6vw, 1.9rem); letter-spacing: -.035em; line-height: 1.2; }
    .group-heading p:not(.group-index) { max-width: 75ch; margin: 0; color: var(--muted); font-size: .94rem; line-height: 1.6; }
    .project-list { display: flex; flex-direction: column; }

    .portfolio-contact { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: clamp(46px, 7vw, 78px); padding: clamp(20px, 4vw, 34px); border: 1px solid var(--border); border-radius: 22px; background: linear-gradient(135deg, rgba(37, 99, 235, .055), rgba(16, 185, 129, .07)); }
    .portfolio-contact h2 { margin: 0 0 7px; color: var(--text); font-size: 1.5rem; letter-spacing: -.03em; }
    .portfolio-contact p:not(.eyebrow) { max-width: 70ch; margin: 0; color: var(--muted); line-height: 1.65; }
    .contact-link { display: inline-flex; min-height: 46px; flex: 0 0 auto; align-items: center; justify-content: center; gap: 10px; padding: 10px 15px; border: 1px solid rgba(37, 99, 235, .22); border-radius: 999px; background: white; color: #1d4ed8; font-weight: 800; text-decoration: none; }
    .contact-link:hover { text-decoration: underline; text-underline-offset: 4px; }

    @media (max-width: 640px) {
      .projects-hero { border-radius: 21px; }
      .group-heading { grid-template-columns: 27px minmax(0, 1fr); gap: 8px; }
      .portfolio-contact { align-items: stretch; flex-direction: column; }
      .contact-link { align-self: flex-start; }
    }
    @media (prefers-reduced-motion: reduce) { .contact-link { scroll-behavior: auto; } }
  </style>
</BaseLayout>
