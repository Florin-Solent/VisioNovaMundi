---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    tag: "CIC research and innovation",
    title: "Circular Justice",
    text: "A discovery-stage social-innovation concept examining whether institutional material flows can be managed more circularly, while exploring responsible opportunities for reuse, skills development, training and rehabilitation.",
    status: "Discovery stage",
    link: "/circular-justice",
  },
  {
    tag: "CIC-led programme",
    title: "Unity House",
    text: "A proposed public-benefit programme beginning with a hosted Waltham Forest pilot for surplus-food redistribution, community access and responsible evidence. Future branches would be added only when partners and evidence justify them.",
    status: "Pilot preparation",
    link: "/unity-house",
  },
  {
    tag: "Independent founder-led venture",
    title: "Project Clandestinus",
    text: "An independent creative and publishing venture built around books, hidden symbols, coded messages and reader discovery. It is the Creative & Cultural Innovation branch of the Tree of Life ecosystem.",
    status: "Independent venture",
    link: "/project-clandestinus",
  },
  {
    tag: "CIC research and innovation",
    title: "Service Systems Evaluation",
    text: "Research programme focused on identifying inefficiencies, duplication, and improvement opportunities across institutional workflows and community support systems.",
    status: "In development",
    link: "/work",
  },
  {
    tag: "Future advisory and innovation initiative",
    title: "Training & Implementation Support",
    text: "Workshops and structured support for organisations seeking measurable improvement, stronger governance, and sustainable delivery models.",
    status: "Future concept",
    link: "/contact",
  },
];
---

<BaseLayout title="Projects">
  <h1>Projects</h1>

  <p class="lead">
    We develop research and innovation projects that improve how systems serve people and communities.
    Projects may begin as controlled pilots and scale based on evidence. Classification identifies a project's relationship to
    the Tree of Life ecosystem; it does not by itself establish legal ownership.
  </p>

  <div class="statusLegend" aria-label="Project status guide">
    <strong>Status guide</strong>
    <span><i class="dot discovery"></i>Discovery stage</span>
    <span><i class="dot pilot"></i>Pilot preparation</span>
    <span><i class="dot development"></i>Under development</span>
    <span><i class="dot independent"></i>Independent venture</span>
    <span><i class="dot future"></i>Future concept</span>
  </div>

  <div class="cards">
    {projects.map((p) => (
      <article class="card">
        <div class="top">
          <span class="tag">{p.tag}</span>
          <span class={`status ${p.status.toLowerCase().replaceAll(" ", "-")}`}>{p.status}</span>
        </div>

        <h2>{p.title}</h2>
        <p>{p.text}</p>

        <a class="link" href={p.link}>View →</a>
      </article>
    ))}
  </div>

  <p class="ecosystemLink">Looking for the wider portfolio? <a href="/tree-of-life">Explore the Tree of Life ecosystem</a>.</p>

  <section class="bar">
    <div>
      <h3>Have a project opportunity?</h3>
      <p>
        We welcome enquiries from councils, public bodies, universities and
        community organisations about proposed pilots, evaluation or advisory support.
      </p>
    </div>

    <div class="actions">
      <a class="btn primary" href="/contact">Contact</a>
      <a class="btn" href="/work">Our Work</a>
    </div>
  </section>

  <style>
    h1 {
      margin: 0 0 12px;
      font-size: 40px;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .lead {
      margin: 0 0 18px;
      color: var(--muted);
      line-height: 1.75;
      font-size: 18px;
      max-width: 95ch;
    }

    .cards {
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .ecosystemLink { margin: 18px 0 0; color: var(--muted); }
    .ecosystemLink a { color: rgba(39, 99, 235, 0.95); font-weight: 800; }

    .card {
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      background: white;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    }

    .top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      margin-bottom: 10px;
    }

    .tag {
      font-size: 12px;
      font-weight: 850;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(39, 99, 235, 0.05);
      color: var(--muted);
    }

    .status {
      font-size: 13px;
      color: var(--text);
      font-weight: 700;
      border: 1px solid rgba(15, 118, 110, 0.18);
      background: rgba(16, 185, 129, 0.08);
      border-radius: 999px;
      padding: 6px 9px;
      white-space: nowrap;
    }

    .statusLegend { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin: 0 0 18px; color: var(--muted); font-size: 13px; }
    .statusLegend strong { color: var(--text); }
    .statusLegend span { display: inline-flex; align-items: center; gap: 6px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: #0f766e; display: inline-block; }
    .dot.discovery { background: #7c3aed; }
    .dot.pilot { background: #2563eb; }
    .dot.development { background: #0f766e; }
    .dot.independent { background: #d97706; }
    .dot.future { background: #64748b; }

    h2 {
      margin: 0 0 8px;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: var(--text);
    }

    .card p {
      margin: 0 0 10px;
      color: var(--muted);
      line-height: 1.75;
    }

    .link {
      font-weight: 850;
      text-decoration: none;
      color: rgba(39, 99, 235, 0.95);
    }

    .link:hover {
      text-decoration: underline;
    }

    .bar {
      margin-top: 14px;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      background: linear-gradient(
        135deg,
        rgba(39, 99, 235, 0.06),
        rgba(16, 185, 129, 0.06)
      );
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
    }

    .bar h3 {
      margin: 0 0 6px;
      font-size: 16px;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .bar p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
      max-width: 80ch;
    }

    .actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      padding: 11px 14px;
      border: 1px solid var(--border);
      background: white;
      color: var(--text);
      text-decoration: none;
      font-weight: 850;
    }

    .btn.primary {
      background: linear-gradient(
        135deg,
        rgba(39, 99, 235, 0.10),
        rgba(16, 185, 129, 0.10)
      );
      border-color: rgba(39, 99, 235, 0.25);
    }

    .btn:hover {
      border-color: rgba(0, 0, 0, 0.18);
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .cards {
        grid-template-columns: 1fr;
      }
      .bar {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</BaseLayout>
