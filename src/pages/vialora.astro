---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectUpdates from "../components/ProjectUpdates.astro";

const benefits = [
  {
    number: "01",
    title: "More choice",
    text: "Explore greater fragrance variety without several full-size bottles.",
  },
  {
    number: "02",
    title: "Made to travel",
    text: "Designed around portability and everyday convenience.",
  },
  {
    number: "03",
    title: "Refill-oriented",
    text: "Investigating a reusable and refill-focused product format.",
  },
  {
    number: "04",
    title: "Still evolving",
    text: "Naming, format and product architecture remain under evaluation.",
  },
];
---

<BaseLayout
  title="Vialora — Fragrance Concept"
  description="Vialora is exploring a compact, refill-oriented fragrance concept that offers more choice without relying on multiple full-size bottles."
>
  <figure class="project-concept-visual">
    <img src="/images/vialora-concept.webp" alt="Concept visual of luminous glass, citrus and botanicals evoking a refined fragrance atmosphere without depicting a final product." loading="eager" decoding="async" width="1536" height="1024" data-project-image />
    <figcaption>Concept visual · no final product depicted</figcaption>
  </figure>
  <section class="conceptHero fragranceHero">
    <div class="heroCopy">
      <p class="eyebrow">Founder-led concept · Early concept development</p>
      <h1>VIALORA</h1>
      <p class="conceptType">Fragrance Concept</p>
      <p class="lead">Vialora is exploring a compact, refill-oriented fragrance concept that offers more choice without relying on multiple full-size bottles. The product format and public naming remain under evaluation.</p>
    </div>
    <aside class="stageCard" aria-label="Current development stage">
      <p class="stageLabel">Current stage</p>
      <h2>Early concept development</h2>
      <p>The concept is being explored; no final product format or production decision is being claimed.</p>
      <span class="stagePill">Concept development</span>
    </aside>
  </section>

  <p class="ownershipNote">Founder-led concept developed alongside the wider Visio Nova Mundi ecosystem. It is not presented as a CIC-operated programme; a separate legal or operating entity is not established in the current public project record.</p>
  <p class="separationNote">This fragrance concept is separate from Vialora Voyage, the travel-grooming concept.</p>

  <section class="section benefitsSection" aria-labelledby="benefits-heading">
    <div class="sectionHead">
      <p class="eyebrow">What the concept explores</p>
      <h2 id="benefits-heading">More fragrance choice in a considered format</h2>
    </div>
    <div class="benefitGrid">
      {benefits.map((benefit) => (
        <article class="benefitCard">
          <span class="benefitNumber" aria-hidden="true">{benefit.number}</span>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="developmentSection" aria-labelledby="next-step-heading">
    <div>
      <p class="eyebrow">Project timeline</p>
      <h2 id="next-step-heading">Follow the concept timeline.</h2>
      <p>Follow the documented steps as the fragrance concept develops.</p>
    </div>
    <div class="actions">
      <a class="btn primary" href="/timeline/">View the project timeline</a>
      <a class="btn" href="/projects/">Back to Projects</a>
    </div>
  </section>

  <style>
    .conceptHero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:start}
    .heroCopy{max-width:820px}
    .eyebrow{margin:0 0 10px;color:#795324;text-transform:uppercase;letter-spacing:.075em;font-size:.875rem;font-weight:850}
    h1{margin:0;color:#1e293b;font-size:clamp(46px,8vw,76px);letter-spacing:.01em;line-height:1}
    .conceptType{margin:8px 0 18px;color:#795324;font-size:17px;font-weight:750;letter-spacing:.16em;text-transform:uppercase}
    .lead{margin:0;max-width:76ch;color:var(--muted);font-size:18px;line-height:1.85}
    .stageCard,.benefitCard{border:1px solid var(--border);border-radius:20px;background:rgba(255,255,255,.9);box-shadow:0 8px 28px rgba(15,23,42,.05)}
    .stageCard{padding:21px;background:linear-gradient(145deg,rgba(154,107,56,.095),rgba(100,116,139,.055));border-color:rgba(154,107,56,.2)}
    .stageLabel{margin:0 0 9px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;font-size:.875rem;font-weight:850}
    .stageCard h2{margin:0 0 10px;color:var(--text);font-size:22px;letter-spacing:-.02em}
    .stageCard>p:not(.stageLabel){margin:0;color:var(--muted);line-height:1.75}
    .stagePill{display:inline-flex;margin-top:15px;padding:7px 11px;border:1px solid rgba(154,107,56,.23);border-radius:999px;background:rgba(154,107,56,.08);color:#795324;font-size:.875rem;font-weight:850}
    .ownershipNote,.separationNote{margin:20px 0 0;padding:13px 16px;color:var(--muted);line-height:1.7}
    .ownershipNote{border-left:3px solid #9a6b38;background:rgba(154,107,56,.055)}
    .separationNote{margin-top:9px;border:1px solid rgba(100,116,139,.18);border-radius:14px;background:rgba(100,116,139,.05)}
    .section{margin-top:38px}
    .sectionHead h2,.developmentSection h2{margin:0 0 8px;color:var(--text);font-size:30px;letter-spacing:-.025em}
    .benefitGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}
    .benefitCard{min-height:174px;padding:20px;background:linear-gradient(145deg,rgba(154,107,56,.055),rgba(100,116,139,.035))}
    .benefitNumber{display:grid;place-items:center;width:35px;height:35px;margin-bottom:13px;border:1px solid rgba(154,107,56,.22);border-radius:50%;background:rgba(154,107,56,.075);color:#795324;font-size:.875rem;font-weight:850}
    .benefitCard h3{margin:0 0 7px;color:var(--text);font-size:19px;letter-spacing:-.015em;text-transform:uppercase}
    .benefitCard p{margin:0;color:var(--muted);line-height:1.75}
    .developmentSection{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-top:22px;padding:21px 22px;border:1px solid rgba(154,107,56,.17);border-radius:20px;background:linear-gradient(145deg,rgba(154,107,56,.06),rgba(100,116,139,.05))}
    .developmentSection>div:first-child{max-width:76ch}
    .developmentSection>div>p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.8}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 17px;border:1px solid rgba(154,107,56,.22);border-radius:999px;background:white;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}
    .btn.primary{background:linear-gradient(135deg,rgba(154,107,56,.1),rgba(100,116,139,.08))}
    .btn:hover{text-decoration:none;border-color:rgba(154,107,56,.42)}
    @media(max-width:800px){.conceptHero{grid-template-columns:1fr}.developmentSection{flex-direction:column;align-items:stretch}}
    @media(max-width:600px){.benefitGrid{grid-template-columns:1fr}.benefitCard{min-height:0}.developmentSection{padding:18px}.actions{flex-direction:column}.btn{width:100%;white-space:normal;text-align:center}}
  </style>
  <ProjectUpdates project="vialora" />
</BaseLayout>
