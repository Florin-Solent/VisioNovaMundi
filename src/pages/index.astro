---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectGroups, evidenceLadders, type PortfolioProject } from "../data/projects";
import { projectUpdates } from "../data/project-updates";

const allProjects = projectGroups.flatMap((group) => group.projects.map((project) => ({ ...project, group: group.id })));
const shortTitle = (project: PortfolioProject) => project.title.split(" — ")[0];

const ladders = evidenceLadders.map((ladder) => {
  const projects = allProjects.filter((project) => ladder.groups.includes(project.group));
  const stages = ladder.stages.map((stage) => ({
    ...stage,
    projects: projects.filter((project) => project.ladder === stage.name),
  }));
  const reached = stages.reduce((last, stage, index) => (stage.projects.length ? index : last), 0);
  return { ...ladder, stages, reached };
});

const latestUpdates = Object.entries(projectUpdates)
  .flatMap(([key, updates]) => {
    const project = allProjects.find((item) => item.href === `/${key}/`);
    return updates.map((update) => ({ ...update, projectTitle: project ? shortTitle(project) : key, href: project?.href ?? "/projects/" }));
  })
  .sort((a, b) => b.isoDate.localeCompare(a.isoDate))
  .slice(0, 3);

const steps = ["Identify problems", "Test ideas", "Learn from evidence", "Build what works"];

const sectors = [
  "Education", "Health", "Tourism", "Culture", "Finance", "Justice", "Defence", "Transport", "Agriculture",
  "Labour & Employment", "Trade", "Housing", "Environment", "Social Services", "Digital Government",
  "Public Administration", "Energy", "Emergency Services",
];
---

<BaseLayout
  title=""
  theme="dark"
  description="Visio Nova Mundi CIC develops and tests ideas that aim to help public institutions and communities improve how essential services work, and reports honestly on what each project has shown."
>
  <div class="home">
    <div class="world" data-home-world aria-hidden="true">
      <canvas class="world-canvas" data-home-canvas></canvas>
    </div>

    <section class="hero" aria-labelledby="home-title">
      <p class="hero-org">Visio Nova Mundi CIC</p>
      <h1 id="home-title">Building better systems for people, communities and the future.</h1>
      <div class="hero-actions">
        <a class="cta glow" href="/projects/">Explore our projects</a>
        <a class="cta glass" href="/contact/">Contact us</a>
      </div>
      <a class="scroll-cue" href="#where"><span class="scroll-line" aria-hidden="true"></span>Scroll</a>
    </section>

    <section class="panel ladders" id="where" aria-labelledby="ladder-title" data-reveal>
      <div class="panel-head">
        <h2 id="ladder-title">Where each project stands</h2>
        <p>Each project is shown at the stage its evidence supports.</p>
      </div>

      {ladders.map((ladder) => (
        <div class="ladder" style={`--stages:${ladder.stages.length};--reached:${ladder.reached}`}>
          <div class="ladder-head">
            <h3>{ladder.title}</h3>
            <p>{ladder.note}</p>
          </div>
          <ol class="ladder-track" aria-label={`${ladder.title}, by stage`}>
            {ladder.stages.map((stage, index) => (
              <li class:list={["rung", { reached: index <= ladder.reached, toward: index < ladder.reached, filled: stage.projects.length > 0 }]}>
                <span class="rung-dot" aria-hidden="true"></span>
                <p class="rung-name">{stage.name}</p>
                {stage.projects.length > 0 ? (
                  <ul class="rung-projects">
                    {stage.projects.map((project) => (
                      <li><a href={project.href}>{shortTitle(project)}</a></li>
                    ))}
                  </ul>
                ) : (
                  <p class="rung-empty">None yet</p>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="trio" aria-label="Framework, updates and method">
      <article class="tile" data-reveal>
        <h2>Tree of Life</h2>
        <p>One framework for every project: who runs it, how it is funded and who owns it.</p>
        <a class="tile-link" href="/tree-of-life/">Explore the framework</a>
      </article>

      <article class="tile" data-reveal>
        <h2>Latest</h2>
        <ol class="latest">
          {latestUpdates.map((update) => (
            <li>
              <time datetime={update.isoDate}>{update.date}</time>
              <a href={update.href}>{update.projectTitle}: {update.title}</a>
            </li>
          ))}
        </ol>
      </article>

      <article class="tile" data-reveal>
        <h2>How we work</h2>
        <ol class="steps">
          {steps.map((step) => <li>{step}</li>)}
        </ol>
        <a class="tile-link" href="/work/">Our approach</a>
      </article>
    </section>

    <section class="sectors" aria-labelledby="sectors-title" data-reveal>
      <h2 id="sectors-title">Eighteen public sectors. One connected vision.</h2>
      <div class="marquee">
        <ul class="marquee-track">
          {sectors.map((sector) => <li>{sector}</li>)}
        </ul>
        <ul class="marquee-track" aria-hidden="true">
          {sectors.map((sector) => <li>{sector}</li>)}
        </ul>
      </div>
    </section>

    <section class="panel closing" aria-labelledby="closing-title" data-reveal>
      <h2 id="closing-title">Working on a public service problem?</h2>
      <a class="cta glow" href="/contact/">Talk to us</a>
    </section>
  </div>

  <script>
    import { mountHomeWorld } from "../scripts/home-world";
    mountHomeWorld();
  </script>

  <style>
    .home {
      --cyan: #6fe0d3;
      --glass-bg: linear-gradient(140deg, rgba(20, 44, 66, 0.62), rgba(8, 22, 38, 0.5));
      --glass-edge: rgba(170, 225, 240, 0.16);
      --glass-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      color: var(--text);
    }

    /* The 3D world sits behind the whole page. */
    .world {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }

    .world::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 20% 45%, rgba(5, 12, 22, 0.72), transparent 60%);
    }

    .world-canvas {
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1.6s ease-out;
    }

    .world.is-ready .world-canvas,
    .world.webgl-unavailable .world-canvas { opacity: 1; }

    .world.webgl-unavailable {
      background:
        radial-gradient(circle at 72% 50%, rgba(56, 160, 220, 0.35), transparent 30%),
        radial-gradient(circle at 72% 50%, rgba(20, 70, 120, 0.6), transparent 45%);
    }

    .home h2 {
      margin: 0;
      font-size: clamp(1.5rem, 2.6vw, 2.1rem);
      font-weight: 760;
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: #fff;
    }

    .home a:not(.cta) { color: var(--cyan); text-underline-offset: 3px; }

    /* Hero */
    .hero {
      min-height: calc(100svh - 120px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: 24px 40px;
      position: relative;
    }

    .hero > * {
      animation: hero-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero > :nth-child(2) { animation-delay: 0.12s; }
    .hero > :nth-child(3) { animation-delay: 0.28s; }
    .hero > :nth-child(4) { animation-delay: 0.9s; }

    @keyframes hero-in {
      from { opacity: 0; transform: translateY(26px); filter: blur(6px); }
      to { opacity: 1; transform: none; filter: none; }
    }

    .hero-org {
      margin: 0 0 22px;
      color: var(--cyan);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .hero h1 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(2.8rem, 6.4vw, 5.6rem);
      font-weight: 780;
      letter-spacing: -0.045em;
      line-height: 0.98;
      color: #fff;
      text-wrap: balance;
      text-shadow: 0 4px 40px rgba(0, 0, 0, 0.45);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 36px;
    }

    .cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 24px;
      border-radius: 999px;
      font-weight: 750;
      text-decoration: none;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    }

    .cta.glow {
      color: #04222a;
      background: linear-gradient(120deg, #8ff0e4, #5ccfe6 55%, #7aa8ff);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25) inset, 0 10px 34px rgba(92, 207, 230, 0.35);
    }

    .cta.glass {
      color: #eaf4f7;
      border: 1px solid var(--glass-edge);
      background: rgba(255, 255, 255, 0.06);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }

    .cta:hover { transform: translateY(-2px); }
    .cta.glow:hover { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35) inset, 0 14px 44px rgba(92, 207, 230, 0.5); }
    .cta.glass:hover { background: rgba(255, 255, 255, 0.11); }

    .scroll-cue {
      position: absolute;
      bottom: 8px;
      left: 0;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: #9fbcc6 !important;
      font-size: 0.9rem;
      text-decoration: none;
    }

    .scroll-line {
      position: relative;
      width: 1px;
      height: 42px;
      overflow: hidden;
      background: rgba(170, 225, 240, 0.2);
    }

    .scroll-line::after {
      content: "";
      position: absolute;
      left: 0;
      top: -40%;
      width: 1px;
      height: 40%;
      background: var(--cyan);
      animation: scroll-drop 2.2s ease-in-out infinite;
    }

    @keyframes scroll-drop {
      to { top: 100%; }
    }

    /* Glass panels */
    .panel,
    .tile {
      position: relative;
      border: 1px solid var(--glass-edge);
      border-radius: 24px;
      background: var(--glass-bg);
      box-shadow: var(--glass-shadow);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      backdrop-filter: blur(22px) saturate(140%);
    }

    /* Glossy top highlight */
    .panel::before,
    .tile::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 38%);
    }

    .panel { padding: clamp(24px, 4vw, 44px); }

    .ladders { margin-top: clamp(40px, 8vw, 90px); }

    .panel-head {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 28px;
      align-items: baseline;
      justify-content: space-between;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }

    .panel-head p { margin: 0; color: var(--muted); }

    .ladder {
      display: grid;
      grid-template-columns: minmax(170px, 0.85fr) minmax(0, 4fr);
      gap: 24px;
      padding-block: 28px;
    }

    .ladder + .ladder { border-top: 1px solid var(--line); }

    .ladder-head h3 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 760;
      color: #fff;
    }

    .ladder-head p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .ladder-track {
      position: relative;
      display: grid;
      grid-template-columns: repeat(var(--stages), minmax(0, 1fr));
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ladder-track::before,
    .ladder-track::after {
      content: "";
      position: absolute;
      top: 7px;
      left: 7px;
      height: 2px;
      border-radius: 2px;
    }

    .ladder-track::before { right: 0; background: rgba(170, 225, 240, 0.16); }

    .ladder-track::after {
      width: calc((100% + 12px) * var(--reached) / var(--stages));
      background: linear-gradient(90deg, #5ccfe6, var(--cyan));
      box-shadow: 0 0 12px rgba(111, 224, 211, 0.7);
      transform-origin: left;
      transform: scaleX(0);
      transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.25s;
    }

    /* The progress line draws in when the panel is revealed. */
    :global(html:not(.motion-ready)) .ladder-track::after,
    .ladders:global(.is-visible) .ladder-track::after { transform: scaleX(1); }

    .rung {
      position: relative;
      min-width: 0;
      padding-top: 30px;
    }

    .rung-dot {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(170, 225, 240, 0.3);
      border-radius: 50%;
      background: #071425;
    }

    .rung.reached .rung-dot { border-color: var(--cyan); }

    .rung.filled .rung-dot {
      background: var(--cyan);
      box-shadow: 0 0 14px rgba(111, 224, 211, 0.85);
    }

    .rung-name {
      margin: 0;
      font-weight: 760;
      color: #fff;
    }

    .rung-projects {
      display: grid;
      gap: 6px;
      margin: 12px 0 0;
      padding: 0;
      list-style: none;
    }

    .rung-projects a {
      display: block;
      padding: 8px 10px;
      border: 1px solid rgba(170, 225, 240, 0.18);
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.05);
      color: #eaf4f7 !important;
      font-size: 0.93rem;
      font-weight: 650;
      line-height: 1.3;
      text-decoration: none;
      transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .rung-projects a:hover {
      border-color: rgba(111, 224, 211, 0.6);
      background: rgba(111, 224, 211, 0.1);
      transform: translateY(-1px);
    }

    .rung-empty {
      margin: 12px 0 0;
      padding: 8px 10px;
      border: 1px dashed rgba(170, 225, 240, 0.2);
      border-radius: 10px;
      color: #7f9aa5;
      font-size: 0.88rem;
    }

    /* Trio */
    .trio {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    .tile {
      display: flex;
      flex-direction: column;
      padding: 28px;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease;
    }

    .tile:hover {
      transform: translateY(-4px);
      border-color: rgba(111, 224, 211, 0.35);
    }

    .tile h2 { font-size: 1.3rem; }

    .tile > p {
      margin: 14px 0 0;
      color: var(--muted);
      line-height: 1.55;
    }

    .tile-link {
      margin-top: auto;
      padding-top: 20px;
      font-weight: 700;
    }

    .latest,
    .steps {
      display: grid;
      gap: 14px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
    }

    .latest time {
      display: block;
      color: #7f9aa5;
      font-size: 0.85rem;
    }

    .latest a {
      font-weight: 650;
      line-height: 1.35;
      text-decoration: none;
    }

    .latest a:hover { text-decoration: underline; }

    .steps { counter-reset: step; gap: 10px; }

    .steps li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 650;
      counter-increment: step;
    }

    .steps li::before {
      content: counter(step);
      display: grid;
      place-items: center;
      flex: 0 0 28px;
      height: 28px;
      border: 1px solid rgba(111, 224, 211, 0.45);
      border-radius: 50%;
      color: var(--cyan);
      font-size: 0.85rem;
      font-weight: 780;
    }

    /* Sectors marquee */
    .sectors {
      margin-top: clamp(56px, 9vw, 110px);
      text-align: center;
    }

    .marquee {
      display: flex;
      overflow: hidden;
      margin-top: 26px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    }

    .marquee-track {
      display: flex;
      flex: 0 0 auto;
      gap: 10px;
      margin: 0;
      padding: 0 10px 0 0;
      list-style: none;
      animation: marquee 60s linear infinite;
    }

    .marquee:hover .marquee-track { animation-play-state: paused; }

    .marquee-track li {
      padding: 9px 16px;
      border: 1px solid var(--glass-edge);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      color: #d5e6ec;
      white-space: nowrap;
    }

    @keyframes marquee {
      to { transform: translateX(-100%); }
    }

    /* Closing */
    .closing {
      display: flex;
      flex-wrap: wrap;
      gap: 20px 32px;
      align-items: center;
      justify-content: space-between;
      margin-block: clamp(56px, 9vw, 110px) 20px;
    }

    @media (max-width: 960px) {
      .ladder,
      .trio { grid-template-columns: 1fr; }
    }

    @media (max-width: 700px) {
      .world::after {
        background: linear-gradient(180deg, rgba(5, 12, 22, 0.75) 0%, rgba(5, 12, 22, 0.35) 55%, rgba(5, 12, 22, 0.1) 100%);
      }

      .hero {
        justify-content: flex-start;
        padding-top: 10vh;
      }

      .ladder-track {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .ladder-track::before,
      .ladder-track::after { display: none; }

      .rung { padding: 0 0 20px 32px; }

      .rung:not(:last-child)::before {
        content: "";
        position: absolute;
        top: 16px;
        bottom: 0;
        left: 7px;
        width: 2px;
        background: rgba(170, 225, 240, 0.16);
      }

      .rung.toward::before {
        background: var(--cyan);
        box-shadow: 0 0 10px rgba(111, 224, 211, 0.6);
      }

      .rung-projects { margin-top: 10px; }

      /* Empty stages collapse to their name on small screens. */
      .rung-empty { display: none; }
      .rung:not(.filled) .rung-name { color: #7f9aa5; font-weight: 650; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero > *,
      .scroll-line::after,
      .marquee-track { animation: none; }
      .world-canvas { transition: none; }
      .ladder-track::after { transition: none; transform: scaleX(1); }
      .marquee { flex-wrap: wrap; justify-content: center; -webkit-mask-image: none; mask-image: none; }
      .marquee-track { flex-wrap: wrap; justify-content: center; row-gap: 10px; padding: 0; }
      .marquee-track[aria-hidden="true"] { display: none; }
      .tile,
      .cta,
      .rung-projects a { transition: none; }
    }
  </style>
</BaseLayout>
