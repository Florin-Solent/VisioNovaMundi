---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgrammeCards from "../components/ProgrammeCards.astro";
import { programmes, discovery } from "../data/institutional";


const heroText =
  "Visio Nova Mundi is a London-based social innovation CIC helping public, community and research organisations understand practical challenges, test improvements, measure what happens and decide what should happen next.";


---

<BaseLayout title="" description="Visio Nova Mundi CIC is a London-based social innovation organisation advancing research, applied pilots and long-term community impact.">
  <section class="hero hero-orrery">
    <div class="hero-shell">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">
            <span class="eyebrow-mark" aria-hidden="true"></span>
            Social innovation <span aria-hidden="true">•</span> research <span aria-hidden="true">•</span> applied pilots
          </p>
          <h1>
            <span class="title-line">Helping organisations</span>
            <span class="title-line title-accent">test better ways</span>
            <span class="title-line">to serve people</span>
            <span class="title-line">and communities.</span>
          </h1>
          <p class="lead">{heroText}</p>

          <div class="actions">
            <a class="btn primary" href="/work/">Explore Our Work</a>
            <a class="btn btn-quiet" href="/commissioners-partners/">For Commissioners &amp; Partners</a>
          </div>

          <div class="trust" aria-label="Our working principles">
            <div class="chip">For public, community &amp; research organisations</div>
            <div class="chip">Evidence-led</div>
            <div class="chip">Pilot → measure → improve</div>
          </div>
        </div>

        <div class="home-index-panel">
          <div class="home-index-topline"><span>Field guide / 01</span></div>
          <div class="home-index-orb" aria-hidden="true"><span>VNM</span></div>
          <div class="home-index-copy">
            <h2>A clear path from local need to an informed decision.</h2>
            <p>Discover, pilot, measure and refine. Continue or scale only where evidence supports it.</p>
          </div>
          <div class="home-index-links">
            <a href="/work/"><span class="index-dot index-dot-teal"></span><span><strong>Our Work</strong><small>Tree of Life and pilots</small></span><span class="index-arrow">↗</span></a>
            <a href="/projects/"><span class="index-dot index-dot-gold"></span><span><strong>Projects</strong><small>Portfolio, delivery and proposals</small></span><span class="index-arrow">↗</span></a>
            <a href="/governance/"><span class="index-dot index-dot-violet"></span><span><strong>Governance</strong><small>Status, operators and responsibilities</small></span><span class="index-arrow">↗</span></a>
          </div>
        </div>
      </div>

      <div class="hero-foot">
        <span>Visio Nova Mundi CIC</span>
        <span class="hero-foot-rule"></span>
        <span>London / UK</span>
        <span class="hero-foot-mark" aria-hidden="true">⌁</span>
      </div>
    </div>
  </section>


  <section class="section"><div class="sectionHead"><p class="eyebrow">Who we help</p><h2>Public, community and research organisations</h2><p>Local authorities, universities, charities, community organisations and responsible private-sector partners seeking a practical, proportionate way to test an improvement. These are intended audiences, not a list of confirmed clients.</p></div></section>
  <section class="section subtle"><div class="sectionHead"><p class="eyebrow">How we work</p><h2>Discover → Pilot → Measure → Refine → Decide</h2><p>Start with a local need and a bounded question. Agree the pilot and safeguards, record what happens and use the evidence to stop, refine, continue, evaluate further or scale where justified.</p></div><div class="actions"><a class="btn" href="/work/">Explore the three engagement packages</a></div></section>
  <section class="section"><div class="sectionHead"><p class="eyebrow">Projects &amp; proposals</p><h2>Delivery first. Proposals clearly labelled.</h2></div><ProgrammeCards items={programmes} /><h3>Discovery and proposed work</h3><ProgrammeCards items={discovery} /><a class="link" href="/projects/">Explore the full Projects portfolio →</a></section>
  <section class="section subtle"><div class="twoCol"><div><p class="eyebrow">Evidence / current delivery</p><h2>Six hosted sessions, a bounded learning step</h2><p class="lead2">Unity House has a council award under the Waltham Forest Community Health Champions Microgrant Fund for six community health and wellbeing sessions in South Waltham Forest, within September 2026–March 2027.</p><p class="lead2">The award is evidence of funded scope, not proven outcomes. Learning and voluntary resident feedback will inform next steps; the permanent centre and wider circular-economy model remain future concepts.</p><a class="btn" href="/unity-house/">Current delivery and its boundaries</a></div><figure class="poster pilot-poster"><img src="/images/uhc-poster.png" alt="Long-term conceptual study of a Unity House community hub; not a current operating centre." loading="lazy" /><figcaption><strong>Long-term conceptual study.</strong> Phase 1 is hosted in existing community venues.</figcaption></figure></div></section>
  <section class="section"><div class="sectionHead"><p class="eyebrow">Governance / trust</p><h2>Public benefit with clear responsibility</h2><p>Visio Nova Mundi CIC is a London-based Community Interest Company, number 16947678. The asset lock protects community benefit. Programme scope, operator responsibilities and evidence matter alongside legal identity; registration does not prove outcomes.</p></div><div class="actions"><a class="btn" href="/governance/">Read governance and classifications</a><a class="btn" href="/work/">Our Work and pilots</a></div></section>
  <section class="section ctaBar"><div><h2>Have a question worth testing?</h2><p>Explore a discovery sprint, pilot evaluation or circular-systems feasibility review. Scope and capacity are agreed before work begins.</p></div><a class="btn primary" href="/commissioners-partners/">For Commissioners &amp; Partners</a></section>
  <section class="section ecosystem"><div class="sectionHead"><p class="eyebrow">Broader ecosystem</p><h2>Related purpose, distinct operators</h2><p>Tree of Life explains the relationships between public-benefit work, future concepts and independent founder ventures. Independent publishing and product ventures are accessible here without being presented as CIC services.</p></div><div class="actions"><a class="btn" href="/tree-of-life/">Tree of Life framework</a><a class="btn" href="/ventures/">Independent Founder Ventures</a><a class="btn" href="/research-future/">Research &amp; Future Concepts</a></div></section>
  <style>
    .hero { padding: 0 0 10px; }

    .hero-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.74);
      border-radius: 30px;
      background:
        radial-gradient(circle at 80% 16%, rgba(37, 99, 235, 0.2), transparent 31%),
        radial-gradient(circle at 16% 84%, rgba(16, 185, 129, 0.17), transparent 28%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(225, 242, 255, 0.82) 50%, rgba(197, 231, 239, 0.86) 100%);
      box-shadow: 0 26px 70px rgba(30, 87, 117, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      color: #102741;
      backdrop-filter: blur(18px) saturate(135%);
      isolation: isolate;
    }

    .hero-shell::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0.2;
      background-image:
        linear-gradient(rgba(30, 91, 125, 0.09) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30, 91, 125, 0.09) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(90deg, black, transparent 92%);
    }

    .hero-shell::after {
      content: "";
      position: absolute;
      inset: auto -10% -42% 12%;
      height: 55%;
      z-index: -1;
      background: radial-gradient(ellipse, rgba(37, 99, 235, 0.16), transparent 66%);
      filter: blur(16px);
      pointer-events: none;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
      gap: clamp(24px, 3.5vw, 46px);
      align-items: center;
      min-height: 570px;
      padding: clamp(28px, 4.2vw, 50px);
    }

    .hero-copy { position: relative; z-index: 2; max-width: 570px; }

    .eyebrow {
      margin: 0 0 10px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .hero-eyebrow {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 12px;
      color: #1e6077;
    }

    .eyebrow-mark {
      display: inline-block;
      width: 30px;
      height: 1px;
      background: linear-gradient(90deg, rgba(37, 99, 235, .68), rgba(37, 99, 235, 0));
    }

    h1 {
      margin: 0 0 10px;
      max-width: none;
      font-size: clamp(42px, 4.3vw, 60px);
      letter-spacing: -0.03em;
      line-height: 1.02;
      color: #102741;
      text-wrap: balance;
    }

    h1 .title-line {
      display: block;
    }

    h1 .title-accent {
      color: #1c6a84;
      text-shadow: none;
    }

    .lead {
      margin: 0;
      font-size: 18px;
      line-height: 1.7;
      color: #294e67;
      max-width: 70ch;
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      padding: 11px 14px;
      border: 1px solid rgba(30, 85, 118, 0.2);
      background: rgba(255, 255, 255, 0.42);
      color: #102741;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
      text-decoration: none;
      font-weight: 700;
    }

    .btn.primary {
      background-image: linear-gradient(135deg, rgba(37,99,235,.12), rgba(16,185,129,.10));
      background-color: var(--glass);
      border-color: rgba(37,99,235,.22);
      color: var(--text);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.64);
    }

    .btn-quiet {
      background: rgba(255, 255, 255, 0.22);
    }

    .btn:hover {
      border-color: rgba(37, 99, 235, 0.5);
      text-decoration: none;
    }

    .trust {
      margin-top: 18px;
      display: flex;
      flex-wrap: wrap;
      gap: 7px 16px;
    }

    .chip {
      position: relative;
      font-size: 12px;
      color: #476f83;
      border: 0;
      background: transparent;
      padding: 0;
      border-radius: 0;
    }

    .chip:not(:last-child)::after {
      content: "·";
      position: absolute;
      right: -11px;
      color: rgba(37, 99, 235, .48);
    }

    .orrery-wrap { position: relative; z-index: 1; min-width: 0; }

    .orrery-caption,
    .hero-foot,
    .stage-readout {
      display: flex;
      align-items: center;
      gap: 9px;
      color: #8ea9b0;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .orrery-caption,
    .hero-foot { color: #315b70; }

    .orrery-caption { padding: 0 8px 12px; }

    .signal-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #2f7e83;
      box-shadow: 0 0 0 5px rgba(47, 126, 131, 0.1), 0 0 16px rgba(47, 126, 131, 0.42);
    }

    .caption-rule { flex: 1; height: 1px; background: rgba(160, 193, 194, 0.2); }
    .caption-index { color: #1d4ed8; }

    .orrery-stage {
      --tilt-x: 0deg;
      --tilt-y: 0deg;
      --scene-lift: 0px;
      position: relative;
      width: 100%;
      max-width: 560px;
      aspect-ratio: 1 / 1;
      margin: 0 auto;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.76);
      border-radius: 50%;
      background:
        radial-gradient(circle at 50% 44%, rgba(93, 188, 207, 0.42), transparent 18%),
        radial-gradient(circle at 50% 50%, rgba(10, 47, 75, 0.98) 0%, rgba(11, 36, 64, 0.98) 57%, rgba(6, 23, 46, 0.99) 100%);
      box-shadow:
        0 0 0 10px rgba(255, 255, 255, 0.34),
        0 0 0 13px rgba(37, 99, 235, 0.18),
        0 28px 80px rgba(10, 65, 104, 0.26),
        inset 0 0 60px rgba(1, 15, 36, 0.82);
      transform: translateY(var(--scene-lift)) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
      transform-style: preserve-3d;
      transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.65s ease;
      will-change: transform;
    }

    .orrery-stage::before,
    .orrery-stage::after {
      content: "";
      position: absolute;
      inset: 5%;
      border: 1px solid rgba(188, 223, 236, 0.18);
      border-radius: 50%;
      pointer-events: none;
    }

    .orrery-stage::after { inset: 18%; border-color: rgba(123, 213, 223, 0.18); }

    .cosmic-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
    }

    .cosmic-fallback {
      position: absolute;
      inset: 50% auto auto 50%;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 112px;
      height: 112px;
      border: 1px solid rgba(215, 193, 139, .8);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 25%, #f8e8b6, #c09d5f 40%, #554128 100%);
      color: #1e241e;
      font-weight: 900;
      letter-spacing: .16em;
      transform: translate(-50%, -50%);
    }

    .is-webgl .cosmic-fallback { display: none; }

    .star-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-repeat: repeat;
      border-radius: 50%;
    }

    .star-layer-one {
      opacity: 0.68;
      background-image:
        radial-gradient(circle at 13% 29%, rgba(240, 229, 196, 0.92) 0 1px, transparent 1.7px),
        radial-gradient(circle at 27% 76%, rgba(179, 222, 218, 0.72) 0 1px, transparent 1.8px),
        radial-gradient(circle at 78% 24%, rgba(240, 229, 196, 0.84) 0 1px, transparent 1.8px),
        radial-gradient(circle at 83% 69%, rgba(179, 222, 218, 0.8) 0 1px, transparent 1.7px),
        radial-gradient(circle at 47% 11%, rgba(255, 255, 255, 0.78) 0 1px, transparent 1.8px);
    }

    .star-layer-two {
      opacity: 0.35;
      transform: rotate(32deg) scale(1.12);
      background-image: radial-gradient(circle, rgba(196, 224, 221, 0.65) 0 1px, transparent 1.6px);
      background-size: 71px 83px;
      animation: starfield-drift 18s linear infinite;
    }

    .orrery-map { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

    .orbit-line {
      fill: none;
      stroke: rgba(173, 210, 207, 0.25);
      stroke-width: 1;
      stroke-dasharray: 2 8;
      vector-effect: non-scaling-stroke;
    }

    .orbit-line-one { stroke: rgba(215, 193, 139, 0.48); stroke-dasharray: 1 9; }
    .orbit-line-two { stroke: rgba(155, 207, 204, 0.26); }
    .orbit-line-three { stroke: rgba(155, 207, 204, 0.2); stroke-dasharray: 1 12; }
    .connector-line { fill: none; stroke: rgba(205, 185, 135, 0.14); stroke-width: 1; stroke-dasharray: 4 8; }

    .orrery-core {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 126px;
      height: 126px;
      transform: translate(-50%, -50%) translateZ(35px);
      transform-style: preserve-3d;
    }

    .core-halo { position: absolute; inset: -32%; border-radius: 50%; background: radial-gradient(circle, rgba(207, 181, 124, 0.22), transparent 66%); filter: blur(8px); }
    .core-ring { position: absolute; inset: -12px; border: 1px solid rgba(215, 193, 139, 0.46); border-radius: 50%; transform: rotateX(68deg) rotateZ(-18deg); }
    .core-ring-two { inset: -22px; border-color: rgba(156, 204, 202, 0.26); transform: rotateX(66deg) rotateZ(47deg); }

    .core-disc {
      position: absolute;
      inset: 18px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(240, 225, 185, 0.8);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 28%, #f8e8b6, #c09d5f 34%, #755d3a 75%, #34291d 100%);
      box-shadow: 0 0 28px rgba(215, 193, 139, 0.34), inset 0 2px 8px rgba(255, 248, 217, 0.48);
      color: #1e241e;
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-indent: 0.16em;
    }

    .orbit-node { position: absolute; z-index: 4; transform: translateZ(45px); }
    .node-tree { left: 7%; top: 26%; }
    .node-unity { right: 7%; top: 15%; }
    .node-clandestinus { right: 4%; bottom: 18%; }

    .orbit-node a { display: flex; align-items: center; gap: 9px; color: #e8eee8; text-decoration: none; }
    .orbit-node a:hover .node-orb, .orbit-node a:focus-visible .node-orb { transform: scale(1.15); box-shadow: 0 0 0 5px rgba(214, 192, 139, 0.12), 0 0 30px currentColor; }

    .node-orb { display: grid; place-items: center; flex: 0 0 40px; width: 40px; height: 40px; border: 1px solid currentColor; border-radius: 50%; transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .node-orb span { width: 11px; height: 11px; border-radius: 50%; background: currentColor; box-shadow: 0 0 15px currentColor; }
    .node-orb-teal { color: #8fd0c8; }
    .node-orb-gold { color: #3b82f6; }
    .node-orb-violet { color: #b5a3df; }

    .node-label { display: grid; gap: 2px; min-width: 112px; padding: 8px 10px; border: 1px solid rgba(177, 207, 205, 0.18); border-radius: 9px; background: rgba(4, 16, 28, 0.78); backdrop-filter: blur(8px); }
    .node-label strong { color: #f3ead6; font-size: 13px; letter-spacing: -0.01em; }
    .node-label small { color: #91adb1; font-size: 11px; }

    .stage-readout { position: absolute; right: 12%; bottom: 9%; left: 12%; z-index: 4; justify-content: space-between; font-size: 9px; letter-spacing: 0.1em; }
    .stage-readout span:last-child { color: #1d4ed8; }

    .hero-foot { gap: 12px; padding: 0 clamp(28px, 5vw, 60px) 22px; color: rgba(166, 193, 194, 0.68); }
    .hero-foot-rule { width: 38px; height: 1px; background: rgba(30, 85, 118, 0.24); }
    .hero-foot-mark { margin-left: auto; color: #1d4ed8; font-size: 18px; }

    @keyframes starfield-drift { from { transform: rotate(32deg) translate3d(-2%, -1%, 0) scale(1.12); } to { transform: rotate(32deg) translate3d(2%, 1%, 0) scale(1.12); } }

    .section { margin-top: 34px; }

    .ecosystem {
      border-left: 3px solid rgba(16, 185, 129, 0.55);
      padding: 4px 0 4px 18px;
    }

    .sectionHead h2 {
      margin: 0 0 8px;
      font-size: 26px;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .sectionHead p { margin: 0; color: var(--muted); line-height: 1.7; max-width: 90ch; }

    .cards {
      margin-top: 14px;
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .card {
      border: 1px solid var(--border);
      background: white;
      border-radius: 18px;
      padding: 16px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    }

    .card h3 { margin: 0 0 8px; font-size: 16px; letter-spacing: -0.01em; color: var(--text); }
    .card p { margin: 0 0 10px; color: var(--muted); line-height: 1.7; }

    .link {
      font-weight: 800;
      text-decoration: none;
      color: rgba(39, 99, 235, 0.95);
    }
    .link:hover { text-decoration: underline; }

    .subtle {
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 18px;
      background: linear-gradient(135deg, rgba(39, 99, 235, 0.05), rgba(16, 185, 129, 0.05));
    }

    .twoCol {
      display: grid;
      gap: 18px;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }

    .lead2 { color: var(--muted); line-height: 1.7; margin: 0 0 12px; }

    .list { margin: 0; padding-left: 18px; color: var(--muted); line-height: 1.8; }

    .poster {
      margin: 0;
      position: relative;
      isolation: isolate;
      border: 1px solid var(--border);
      background:
        radial-gradient(circle at 28% 18%, rgba(16, 185, 129, 0.22), transparent 28%),
        radial-gradient(circle at 82% 66%, rgba(37, 99, 235, 0.2), transparent 34%),
        white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 14px 34px rgba(15, 118, 110, 0.14), 0 10px 30px rgba(0, 0, 0, 0.08);
      transform: perspective(900px) rotateX(1deg) rotateY(-1deg);
      transition: transform 0.45s ease, box-shadow 0.45s ease;
    }

    .pilot-poster::after {
      content: "";
      position: absolute;
      z-index: 2;
      pointer-events: none;
    }

    .pilot-poster::after {
      inset: -30% -48%;
      background: linear-gradient(112deg, transparent 43%, rgba(255, 255, 255, 0.46) 50%, transparent 57%);
      transform: translateX(-32%) rotate(6deg);
      animation: pilot-light-sweep 8.5s ease-in-out infinite;
    }

    .poster img {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      height: auto;
      transform: translateZ(18px) scale(1.01);
      animation: pilot-image-float 7s ease-in-out infinite;
    }

    .poster:hover {
      transform: perspective(900px) translateY(-6px) rotateX(2deg) rotateY(-2deg);
      box-shadow: 0 22px 48px rgba(15, 118, 110, 0.2), 0 12px 34px rgba(0, 0, 0, 0.08);
    }

    .poster figcaption {
      position: relative;
      z-index: 3;
      padding: 10px 12px;
      font-size: 13px;
      color: var(--muted);
      background: rgba(255, 255, 255, 0.9);
      border-top: 1px solid var(--border);
    }

    @keyframes pilot-image-float {
      0%, 100% { transform: translate3d(0, 0, 18px) scale(1.01); }
      50% { transform: translate3d(0, -5px, 28px) scale(1.025); }
    }

    @keyframes pilot-light-sweep {
      0%, 35% { transform: translateX(-45%) rotate(6deg); opacity: 0; }
      50% { opacity: 0.72; }
      68%, 100% { transform: translateX(45%) rotate(6deg); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .poster,
      .poster:hover,
      .poster img,
      .pilot-poster::after {
        animation: none;
        transform: none;
      }

      .pilot-poster::after {
        display: none;
      }
    }

    .note { margin-top: 12px; font-size: 13px; color: var(--muted); }

    .ctaBar {
      margin-top: 14px;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      background: white;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      box-shadow: 0 8px 26px rgba(0, 0, 0, 0.06);
    }

    .ctaBar h3 { margin: 0 0 6px; font-size: 16px; letter-spacing: -0.01em; color: var(--text); }
    .ctaBar p { margin: 0; color: var(--muted); line-height: 1.6; }

    @media (max-width: 900px) {
      .hero-grid, .twoCol { grid-template-columns: 1fr; }
      .hero-grid { min-height: 0; }
      .hero-copy { max-width: 720px; }
      .orrery-wrap { width: min(100%, 560px); margin: 0 auto; }
