---
import BaseLayout from "../layouts/BaseLayout.astro";

const sectors = [
  "Education",
  "Health",
  "Tourism",
  "Culture",
  "Finance",
  "Justice",
  "Defence",
  "Transport",
  "Agriculture",
  "Labour & Employment",
  "Trade",
  "Housing",
  "Environment",
  "Social Services",
  "Digital Government",
  "Public Administration",
  "Energy",
  "Emergency Services",
];
---

<BaseLayout
  title=""
  description="Visio Nova Mundi develops and tests ideas that aim to help public institutions and communities improve how essential services work."
>
  <div class="manifesto-home">
    <section class="home-hero" aria-labelledby="home-title">
      <p class="home-kicker"><span aria-hidden="true"></span> Visio Nova Mundi</p>
      <h1 id="home-title">
        Building better systems{" "}<span>for people, communities and the future.</span>
      </h1>
      <div class="home-introduction">
        <p>
          Visio Nova Mundi is a social innovation organisation developing and testing ideas that aim to help governments,
          public institutions and communities improve how essential services work.
        </p>
        <p>
          Through research, pilots, technology and collaboration, our long-term ambition is to contribute to stronger
          public systems across the world.
        </p>
      </div>
      <a class="home-scroll-cue" href="#systems-window">
        <span>Scroll to explore</span>
        <span class="home-scroll-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <section
      class="home-window-scroll"
      id="systems-window"
      data-scroll-window
      aria-labelledby="window-title"
    >
      <div class="home-window-sticky">
        <div class="home-window-panel" data-window-panel>
          <div class="home-window-content">
            <div class="window-intro">
              <p class="window-kicker">A shared horizon</p>
              <h2 id="window-title">One vision. Every part of society.</h2>
              <p class="window-support">
                We explore how better ideas, evidence and technology could contribute to stronger public services and
                institutions.
              </p>
            </div>

            <ul class="sector-list" aria-label="Sectors and public systems">
              {sectors.map((sector) => <li>{sector}</li>)}
            </ul>

            <p class="window-closing">and the systems that connect them.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="home-next" aria-labelledby="next-title">
      <div class="home-next-content">
        <p class="home-kicker"><span aria-hidden="true"></span> How we move forward</p>
        <h2 id="next-title">We identify problems. We test ideas. We learn from evidence. We build what works.</h2>
        <nav class="home-destinations" aria-label="Explore Visio Nova Mundi">
          <a href="/work/">Our Work <span aria-hidden="true">↗</span></a>
          <a href="/projects/">Projects <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="home-about-link" href="/about/">About Visio Nova Mundi</a>
      </div>
    </section>
  </div>

  <style>
    .manifesto-home {
      --home-ink: #123448;
      --home-teal: #0f766e;
      color: var(--home-ink);
    }

    .home-hero {
      min-height: clamp(600px, 78svh, 880px);
      padding-block: clamp(38px, 6vh, 72px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .home-kicker,
    .window-kicker {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 11px;
      color: var(--home-teal);
      font-size: 0.78rem;
      font-weight: 750;
      letter-spacing: 0.15em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .home-kicker > span {
      width: 28px;
      height: 1px;
      flex: 0 0 28px;
      background: currentColor;
    }

    .home-hero h1 {
      max-width: 980px;
      margin: clamp(22px, 3.2vw, 42px) 0 0;
      color: var(--home-ink);
      font-size: clamp(3.35rem, 6.4vw, 6.8rem);
      font-weight: 640;
      letter-spacing: -0.075em;
      line-height: 0.94;
      text-wrap: balance;
    }

    .home-hero h1 span {
      color: #176d73;
    }

    .home-introduction {
      max-width: 76ch;
      display: grid;
      gap: 11px;
      margin-top: clamp(24px, 3vw, 38px);
    }

    .home-introduction p {
      margin: 0;
      color: #385363;
      font-size: clamp(1rem, 1.25vw, 1.18rem);
      line-height: 1.65;
      text-wrap: pretty;
    }

    .home-scroll-cue {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 13px;
      margin-top: clamp(28px, 4.5vh, 46px);
      color: var(--home-ink);
      font-size: 0.83rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .home-scroll-arrow {
      display: grid;
      width: 34px;
      height: 34px;
      place-items: center;
      border: 1px solid rgba(18, 52, 72, 0.22);
      border-radius: 50%;
      font-size: 1.1rem;
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .home-scroll-cue:hover .home-scroll-arrow {
      transform: translateY(3px);
      border-color: var(--home-teal);
    }

    .home-window-scroll {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      position: relative;
    }

    .home-window-sticky {
      min-height: 78svh;
      padding: clamp(12px, 3vw, 38px);
      display: grid;
      place-items: center;
    }

    .home-window-panel {
      position: relative;
      isolation: isolate;
      width: 100%;
      min-height: 76svh;
      overflow: hidden;
      border-radius: clamp(22px, 3vw, 42px);
      border: 1px solid rgba(15, 118, 110, 0.16);
      color: var(--home-ink);
      background:
        radial-gradient(ellipse at 51% 48%, rgba(69, 166, 153, 0.2), transparent 53%),
        radial-gradient(ellipse at 12% 88%, rgba(69, 130, 183, 0.13), transparent 39%),
        linear-gradient(138deg, rgba(246, 251, 255, 0.94) 0%, rgba(222, 241, 243, 0.88) 53%, rgba(232, 247, 239, 0.94) 100%);
      box-shadow: 0 18px 56px rgba(31, 91, 105, 0.09);
      -webkit-backdrop-filter: blur(12px) saturate(118%);
      backdrop-filter: blur(12px) saturate(118%);
    }

    .home-window-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0.36;
      background:
        linear-gradient(rgba(31, 92, 107, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(31, 92, 107, 0.045) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: linear-gradient(135deg, #000, transparent 72%);
    }

    .home-window-content {
      box-sizing: border-box;
      width: min(100%, 1500px);
      min-height: 76svh;
      margin-inline: auto;
      padding: clamp(27px, 5.4vw, 82px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: clamp(20px, 3.2vh, 34px);
    }

    .window-intro {
      max-width: 1040px;
    }

    .window-kicker {
      color: #0b5e58;
      font-size: 0.72rem;
    }

    .window-intro h2 {
      max-width: 14ch;
      margin: 17px 0 13px;
      color: #123448;
      font-size: clamp(2.8rem, 5.7vw, 5.7rem);
      font-weight: 560;
      letter-spacing: -0.065em;
      line-height: 0.98;
      text-wrap: balance;
    }

    .window-support {
      max-width: 64ch;
      margin: 0;
      color: #385363;
      font-size: clamp(0.96rem, 1.2vw, 1.15rem);
      line-height: 1.65;
    }

    .sector-list {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 5px 15px;
      margin: 0;
      padding: 0;
      list-style: none;
      color: #244858;
      font-size: clamp(1.05rem, 2vw, 1.9rem);
      font-weight: 480;
      letter-spacing: -0.035em;
      line-height: 1.28;
    }

    .sector-list li {
      white-space: nowrap;
    }

    .sector-list li:not(:first-child)::before {
      content: "·";
      margin-right: 15px;
      color: #0f766e;
    }

    .window-closing {
      align-self: flex-end;
      max-width: 22ch;
      margin: auto 0 0;
      color: #0b5e58;
      font-size: clamp(1.35rem, 2.35vw, 2.15rem);
      font-weight: 520;
      letter-spacing: -0.04em;
      line-height: 1.12;
      text-align: right;
      text-wrap: balance;
    }

    .home-window-scroll[data-scroll-enhanced] {
      height: 230svh;
    }

    .home-window-scroll[data-scroll-enhanced] .home-window-sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      padding: 0;
      overflow: clip;
    }

    .home-window-scroll[data-scroll-enhanced] .home-window-panel {
      position: absolute;
      inset: 0;
      width: auto;
      height: 100%;
      min-height: 0;
      border-radius: 0;
      clip-path: inset(var(--window-inset-y, 14%) var(--window-inset-x, 9%) round var(--window-radius, 38px));
    }

    .home-window-scroll[data-scroll-enhanced] .home-window-content {
      width: 100%;
      height: 100%;
      min-height: 0;
      opacity: var(--window-content-opacity, 1);
    }

    .home-next {
      min-height: 74svh;
      padding-block: clamp(88px, 14vh, 170px);
      display: grid;
      align-items: center;
    }

    .home-next-content {
      width: 100%;
    }

    .home-next h2 {
      max-width: 17ch;
      margin: 25px 0 0;
      color: var(--home-ink);
      font-size: clamp(2.8rem, 5.8vw, 5.8rem);
      font-weight: 560;
      letter-spacing: -0.065em;
      line-height: 0.99;
      text-wrap: balance;
    }

    .home-destinations {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(24px, 4.5vw, 62px);
      margin-top: clamp(36px, 5vh, 58px);
    }

    .home-destinations a {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(15, 118, 110, 0.4);
      color: var(--home-ink);
      font-size: clamp(1.2rem, 1.8vw, 1.55rem);
      font-weight: 690;
      text-decoration: none;
      transition: color 180ms ease, border-color 180ms ease;
    }

    .home-destinations a:hover {
      color: var(--home-teal);
      border-color: currentColor;
    }

    .home-destinations a span {
      color: var(--home-teal);
      font-size: 0.92em;
    }

    .home-about-link {
      display: inline-block;
      margin-top: 26px;
      color: #4d6874;
      font-size: 0.93rem;
      text-underline-offset: 4px;
    }

    @media (max-width: 700px) {
      .home-hero {
        min-height: clamp(610px, 80svh, 760px);
      }

      .home-hero h1 {
        max-width: 12.5ch;
        font-size: clamp(3.15rem, 12.8vw, 4.55rem);
        line-height: 0.98;
      }

      .home-introduction {
        margin-top: 23px;
        gap: 9px;
      }

      .home-introduction p {
        font-size: 1rem;
        line-height: 1.55;
      }

      .home-scroll-cue {
        margin-top: 25px;
      }

      .home-window-sticky {
        min-height: 0;
        padding: 0;
      }

      .home-window-panel {
        min-height: 82svh;
        border-radius: 0;
      }

      .home-window-content {
        min-height: 82svh;
        padding: 26px 23px;
        gap: 18px;
      }

      .window-intro h2 {
        max-width: 12ch;
        margin: 13px 0 9px;
        font-size: clamp(2.15rem, 9.1vw, 3.1rem);
        line-height: 0.99;
      }

      .window-support {
        font-size: 0.91rem;
        line-height: 1.48;
      }

      .sector-list {
        gap: 4px 10px;
        font-size: clamp(0.93rem, 4.2vw, 1.15rem);
        line-height: 1.28;
      }

      .sector-list li:not(:first-child)::before {
        margin-right: 10px;
      }

      .window-closing {
        align-self: flex-start;
        max-width: 24ch;
        font-size: 1.3rem;
        text-align: left;
      }

      .home-window-scroll[data-scroll-enhanced] .home-window-content {
        padding: 25px 22px;
        gap: 13px;
      }

      .home-next {
        min-height: 68svh;
        padding-block: 88px;
      }

      .home-next h2 {
        max-width: 15ch;
        margin-top: 21px;
        font-size: clamp(2.55rem, 11vw, 4.15rem);
        line-height: 1.01;
      }

      .home-destinations {
        gap: 22px 30px;
        margin-top: 32px;
      }
    }

    @media (max-width: 360px) {
      .home-window-content {
        padding-inline: 18px;
      }

      .home-window-scroll[data-scroll-enhanced] .home-window-content {
        padding-inline: 18px;
      }

      .window-intro h2 {
        font-size: 2rem;
      }

      .sector-list {
        font-size: 0.88rem;
        gap: 3px 8px;
      }

      .sector-list li:not(:first-child)::before {
        margin-right: 8px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-scroll-arrow,
      .home-destinations a {
        transition: none;
      }

      .home-window-scroll[data-scroll-enhanced] {
        height: auto;
      }

      .home-window-scroll[data-scroll-enhanced] .home-window-sticky {
        position: relative;
        height: auto;
        min-height: 0;
        overflow: visible;
        padding: 0;
      }

      .home-window-scroll[data-scroll-enhanced] .home-window-panel {
        position: relative;
        inset: auto;
        height: auto;
        min-height: 82svh;
        clip-path: none;
      }

      .home-window-scroll[data-scroll-enhanced] .home-window-content {
        height: auto;
        min-height: 82svh;
        opacity: 1;
      }
    }
  </style>

  <script>
    const scrollWindow = document.querySelector<HTMLElement>("[data-scroll-window]");
    const windowPanel = scrollWindow?.querySelector<HTMLElement>("[data-window-panel]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (scrollWindow && windowPanel) {
      let frame = 0;

      const clamp = (value: number) => Math.max(0, Math.min(1, value));
      const clearProgress = () => {
        windowPanel.style.removeProperty("--window-inset-y");
        windowPanel.style.removeProperty("--window-inset-x");
        windowPanel.style.removeProperty("--window-radius");
        windowPanel.style.removeProperty("--window-content-opacity");
      };

      const updateProgress = () => {
        frame = 0;
        if (reducedMotion.matches) return;

        const bounds = scrollWindow.getBoundingClientRect();
        const travel = Math.max(1, scrollWindow.offsetHeight - window.innerHeight);
        const progress = clamp(-bounds.top / travel);

        windowPanel.style.setProperty("--window-inset-y", (14 * (1 - progress)).toFixed(2) + "%");
        windowPanel.style.setProperty("--window-inset-x", (9 * (1 - progress)).toFixed(2) + "%");
        windowPanel.style.setProperty("--window-radius", (38 * (1 - progress)).toFixed(1) + "px");
        windowPanel.style.setProperty("--window-content-opacity", clamp(progress / 0.76).toFixed(3));
      };

      const scheduleUpdate = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(updateProgress);
      };

      const applyMotionPreference = () => {
        if (reducedMotion.matches) {
          scrollWindow.removeAttribute("data-scroll-enhanced");
          clearProgress();
          return;
        }

        scrollWindow.setAttribute("data-scroll-enhanced", "");
        scheduleUpdate();
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
      reducedMotion.addEventListener("change", applyMotionPreference);
      applyMotionPreference();
    }
  </script>
</BaseLayout>
