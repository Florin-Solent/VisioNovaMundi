---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectGroups, evidenceLadders, type PortfolioProject } from "../data/projects";
import { projectUpdates } from "../data/project-updates";

const allProjects = projectGroups.flatMap((group) => group.projects.map((project) => ({ ...project, group: group.id })));
const shortTitle = (project: PortfolioProject) => project.title.split(" — ")[0];

const ladders = evidenceLadders.map((ladder) => {
  const projects = allProjects.filter((project) => ladder.groups.includes(project.group));
  const stages = ladder.stages.map((stage) => ({
    ...stage,
    projects: projects.filter((project) => project.ladder === stage.name),
  }));
  const reached = stages.reduce((last, stage, index) => (stage.projects.length ? index : last), 0);
  return { ...ladder, stages, reached };
});

const latestUpdates = Object.entries(projectUpdates)
  .flatMap(([key, updates]) => {
    const project = allProjects.find((item) => item.href === `/${key}/`);
    return updates.map((update) => ({ ...update, projectTitle: project ? shortTitle(project) : key, href: project?.href ?? "/projects/" }));
  })
  .sort((a, b) => b.isoDate.localeCompare(a.isoDate))
  .slice(0, 5);

const steps = [
  { title: "Identify problems", text: "Start from a real need in a public service or a community." },
  { title: "Test ideas", text: "Run small, bounded pilots with safeguards agreed first." },
  { title: "Learn from evidence", text: "Report what happened, including what did not work." },
  { title: "Build what works", text: "Grow only what the evidence supports." },
];

const sectors = [
  "Education", "Health", "Tourism", "Culture", "Finance", "Justice", "Defence", "Transport", "Agriculture",
  "Labour & Employment", "Trade", "Housing", "Environment", "Social Services", "Digital Government",
  "Public Administration", "Energy", "Emergency Services",
];
---

<BaseLayout
  title=""
  description="Visio Nova Mundi CIC develops and tests ideas that aim to help public institutions and communities improve how essential services work, and reports honestly on what each project has shown."
>
  <div class="home">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="hero-org">Visio Nova Mundi CIC · Community Interest Company 16947678</p>
        <h1 id="home-title">Building better systems for people, communities and the future.</h1>
        <p class="hero-lead">
          We develop and test ideas that could help public institutions and communities improve how essential services
          work. Every project below is shown at the stage its evidence supports, and no further.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/work/">How we work</a>
          <a class="button" href="/contact/">Contact us</a>
        </div>
      </div>

      <aside class="now" aria-labelledby="now-title">
        <p class="now-label">Our framework</p>
        <h2 id="now-title">The Tree of Life</h2>
        <p>
          Tree of Life is how we organise every project. Each one is classified by who runs it, how it is funded, who owns
          its IP and how it is governed, so CIC programmes stay clearly separate from independent founder ventures.
        </p>
        <a class="now-link" href="/tree-of-life/">Explore the framework</a>
      </aside>
    </section>

    <section class="ladders" aria-labelledby="ladder-title">
      <div class="section-head">
        <h2 id="ladder-title">Where each project stands</h2>
        <p>A project moves up only when there is documented evidence for it. Empty stages are empty on purpose.</p>
      </div>

      {ladders.map((ladder) => (
        <div class="ladder" style={`--stages:${ladder.stages.length};--reached:${ladder.reached}`}>
          <div class="ladder-head">
            <h3>{ladder.title}</h3>
            <p>{ladder.note}</p>
          </div>
          <ol class="ladder-track" aria-label={`${ladder.title}, by stage`}>
            {ladder.stages.map((stage, index) => (
              <li class:list={["rung", { reached: index <= ladder.reached, toward: index < ladder.reached, filled: stage.projects.length > 0 }]}>
                <span class="rung-dot" aria-hidden="true"></span>
                <p class="rung-name">{stage.name}</p>
                <p class="rung-meaning">{stage.meaning}</p>
                {stage.projects.length > 0 ? (
                  <ul class="rung-projects">
                    {stage.projects.map((project) => (
                      <li><a href={project.href}>{shortTitle(project)}</a></li>
                    ))}
                  </ul>
                ) : (
                  <p class="rung-empty">None yet</p>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
      <p class="ladder-more"><a href="/projects/">See every project in detail</a></p>
    </section>

    <section class="pair">
      <div class="updates" aria-labelledby="updates-title">
        <h2 id="updates-title">Latest updates</h2>
        <ol class="update-list">
          {latestUpdates.map((update) => (
            <li>
              <time datetime={update.isoDate}>{update.date}</time>
              <h3><a href={update.href}>{update.projectTitle}</a>: {update.title}</h3>
              <p>{update.text}</p>
            </li>
          ))}
        </ol>
        <p class="pair-more"><a href="/timeline/">Unity House timeline</a></p>
      </div>

      <div class="method" aria-labelledby="method-title">
        <h2 id="method-title">How we move forward</h2>
        <ol class="steps">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="pair-more"><a href="/governance/">Governance and evidence principles</a></p>
      </div>
    </section>

    <section class="sectors" aria-labelledby="sectors-title">
      <h2 id="sectors-title">Eighteen public sectors, and the systems that connect them</h2>
      <ul class="sector-list">
        {sectors.map((sector) => <li>{sector}</li>)}
      </ul>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">Working on a public service problem?</h2>
        <p>Councils, researchers, charities and community groups can reach us by email. We usually reply in writing first.</p>
      </div>
      <div class="closing-actions">
        <a class="button primary" href="/contact/">Contact us</a>
        <a class="button" href="/commissioners-partners/">Engagement packages</a>
      </div>
    </section>
  </div>

  <style>
    .home {
      --gap: clamp(56px, 8vw, 104px);
      color: var(--text);
    }

    .home h2 {
      margin: 0;
      font-size: clamp(1.6rem, 2.6vw, 2.1rem);
      font-weight: 760;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .home a:not(.button) {
      color: var(--teal);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .home a:not(.button):hover { text-decoration-thickness: 2px; }

    /* Hero */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr);
      gap: clamp(28px, 5vw, 64px);
      align-items: end;
      padding-block: clamp(24px, 6vw, 72px) 0;
    }

    .hero-org {
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .hero h1 {
      margin: 0;
      max-width: 17ch;
      font-size: clamp(2.6rem, 5.6vw, 4.9rem);
      font-weight: 780;
      letter-spacing: -0.045em;
      line-height: 0.98;
      text-wrap: balance;
    }

    .hero-lead {
      max-width: 58ch;
      margin: 28px 0 0;
      color: var(--muted);
      font-size: 1.15rem;
      line-height: 1.65;
    }

    .hero-actions,
    .closing-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 20px;
      border: 1.5px solid var(--ink);
      border-radius: 10px;
      color: var(--ink);
      background: transparent;
      font-weight: 700;
      text-decoration: none;
    }

    .button:hover { background: rgba(17, 43, 56, 0.06); }
    .button.primary { color: #fff; background: var(--ink); }
    .button.primary:hover { background: var(--teal); border-color: var(--teal); }

    .now {
      padding: 26px;
      border: 1px solid var(--line);
      border-top: 4px solid var(--teal);
      border-radius: 14px;
      background: #fff;
    }

    .now-label {
      margin: 0 0 6px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .now h2 { font-size: 1.4rem; }

    .now > p:not(.now-label) {
      margin: 14px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .now-link {
      display: inline-block;
      margin-top: 16px;
      font-weight: 700;
    }

    .stage-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 14px 0 0;
      padding: 5px 12px 5px 10px;
      border-radius: 999px;
      background: rgba(166, 90, 7, 0.1);
      color: #7a4205;
      font-size: 0.9rem;
      font-weight: 700;
    }

    .stage-pill span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--amber);
    }

    /* Evidence ladders */
    .ladders { margin-top: var(--gap); }

    .section-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
      align-items: end;
      padding-bottom: 22px;
      border-bottom: 1.5px solid var(--ink);
    }

    .section-head p {
      max-width: 52ch;
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .ladder {
      display: grid;
      grid-template-columns: minmax(180px, 0.9fr) minmax(0, 4fr);
      gap: 24px;
      padding-block: 30px;
      border-bottom: 1px solid var(--line);
    }

    .ladder-head h3 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 760;
      line-height: 1.3;
    }

    .ladder-head p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .ladder-track {
      position: relative;
      display: grid;
      grid-template-columns: repeat(var(--stages), minmax(0, 1fr));
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* The line connecting the stages, filled up to the highest stage reached. */
    .ladder-track::before,
    .ladder-track::after {
      content: "";
      position: absolute;
      top: 7px;
      left: 7px;
      height: 2px;
      border-radius: 2px;
    }

    .ladder-track::before {
      right: 0;
      background: var(--line);
    }

    .ladder-track::after {
      width: calc((100% + 12px) * var(--reached) / var(--stages));
      background: var(--teal);
      transform-origin: left;
      animation: ladder-fill 900ms cubic-bezier(0.22, 0.61, 0.36, 1) 200ms both;
    }

    @keyframes ladder-fill {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }

    .rung {
      position: relative;
      min-width: 0;
      padding-top: 30px;
    }

    .rung-dot {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      width: 16px;
      height: 16px;
      border: 2px solid var(--line);
      border-radius: 50%;
      background: var(--bg);
    }

    .rung.reached .rung-dot { border-color: var(--teal); }
    .rung.filled .rung-dot { background: var(--teal); }

    .rung-name {
      margin: 0;
      font-weight: 760;
      line-height: 1.25;
    }

    .rung-meaning {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .rung-projects {
      display: grid;
      gap: 6px;
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
    }

    .rung-projects a {
      display: block;
      padding: 8px 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      color: var(--ink) !important;
      font-size: 0.95rem;
      font-weight: 650;
      line-height: 1.3;
      text-decoration: none;
    }

    .rung-projects a:hover { border-color: var(--teal); }

    .rung-empty {
      margin: 14px 0 0;
      padding: 8px 10px;
      border: 1px dashed var(--line);
      border-radius: 8px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .ladder-more { margin: 22px 0 0; font-weight: 700; }

    /* Updates and method */
    .pair {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(32px, 6vw, 80px);
      margin-top: var(--gap);
    }

    .pair h2 {
      padding-bottom: 18px;
      border-bottom: 1.5px solid var(--ink);
    }

    .update-list,
    .steps {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .update-list li {
      padding-block: 20px;
      border-bottom: 1px solid var(--line);
    }

    .update-list time {
      color: var(--muted);
      font-size: 0.9rem;
      font-variant-numeric: tabular-nums;
    }

    .update-list h3,
    .steps h3 {
      margin: 6px 0 0;
      font-size: 1.05rem;
      font-weight: 760;
      line-height: 1.35;
    }

    .update-list p,
    .steps p {
      max-width: 64ch;
      margin: 6px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .steps { counter-reset: step; }

    .steps li {
      position: relative;
      padding: 20px 0 20px 48px;
      border-bottom: 1px solid var(--line);
      counter-increment: step;
    }

    .steps li::before {
      content: counter(step);
      position: absolute;
      top: 22px;
      left: 0;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--mist);
      color: var(--teal);
      font-weight: 780;
      font-variant-numeric: tabular-nums;
    }

    .steps h3 { margin-top: 0; }

    .pair-more { margin: 18px 0 0; font-weight: 700; }

    /* Sectors */
    .sectors {
      margin-top: var(--gap);
      padding: clamp(28px, 4vw, 44px);
      border-radius: 16px;
      background: var(--ink);
      color: #e6f0f2;
    }

    .sectors h2 {
      max-width: 22ch;
      color: #fff;
    }

    .sector-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 10px;
      margin: 26px 0 0;
      padding: 0;
      list-style: none;
    }

    .sector-list li {
      padding: 6px 12px;
      border: 1px solid rgba(230, 240, 242, 0.28);
      border-radius: 999px;
      font-size: 0.95rem;
    }

    /* Closing */
    .closing {
      display: flex;
      flex-wrap: wrap;
      gap: 20px 40px;
      align-items: center;
      justify-content: space-between;
      margin-block: var(--gap) 16px;
    }

    .closing p {
      max-width: 56ch;
      margin: 10px 0 0;
      color: var(--muted);
      line-height: 1.6;
    }

    .closing-actions { margin-top: 0; }

    @media (max-width: 960px) {
      .hero,
      .pair,
      .section-head,
      .ladder { grid-template-columns: 1fr; }
      .hero { align-items: start; }
      .ladder { gap: 18px; }
    }

    /* On narrow screens the ladder runs top to bottom. */
    @media (max-width: 700px) {
      .ladder-track {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .ladder-track::before,
      .ladder-track::after { display: none; }

      /* Each rung draws the segment down to the next one. */
      .rung:not(:last-child)::before {
        content: "";
        position: absolute;
        top: 16px;
        bottom: 0;
        left: 7px;
        width: 2px;
        background: var(--line);
      }

      .rung.toward::before { background: var(--teal); }

      .rung {
        padding: 0 0 22px 32px;
      }

      .rung-projects,
      .rung-empty { margin-top: 10px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .ladder-track::after { animation: none; }
    }
  </style>
</BaseLayout>
