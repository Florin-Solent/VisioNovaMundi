---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusGovernance from "../components/StatusGovernance.astro";

const hubModules = [
  {
    number: "01",
    name: "Digital access",
    text: "A place to get online, use a shared terminal and receive practical help with digital information.",
  },
  {
    number: "02",
    name: "Tourism & local information",
    text: "A digital gateway to local attractions, routes, accommodation, events, transport and businesses.",
  },
  {
    number: "03",
    name: "Public information",
    text: "Guidance and signposting to relevant online public services, subject to the arrangements in place.",
  },
  {
    number: "04",
    name: "Community connection",
    text: "A shared point for agreed activities and scheduled connections with participating villages.",
  },
  {
    number: "05",
    name: "Education",
    text: "A possible setting for school-approved learning access and supplementary educational activities.",
  },
  {
    number: "06",
    name: "Video connection",
    text: "Camera and audio equipment could support scheduled, controlled sessions between participating hubs.",
  },
  {
    number: "07",
    name: "Local services",
    text: "Practical community services could be considered where local need, permissions and operating capacity support them.",
  },
  {
    number: "08",
    name: "Accessibility",
    text: "Access needs should shape the space, equipment and support from the first stage of local planning.",
  },
];

const pilotSteps = [
  {
    number: "01",
    name: "Understand local need",
    text: "Confirm community priorities, a suitable place, infrastructure, local roles and operating requirements.",
  },
  {
    number: "02",
    name: "Agree a small pilot",
    text: "Define a modest service set, permissions, safeguarding, privacy, procurement and a realistic budget.",
  },
  {
    number: "03",
    name: "Measure and learn",
    text: "Agree proportionate measures with local participants, using only the information needed to understand use and value.",
  },
  {
    number: "04",
    name: "Refine the model",
    text: "Use evidence and community feedback to adjust the service, responsibilities and operating model.",
  },
  {
    number: "05",
    name: "Consider replication",
    text: "Explore other localities only if results, local interest, agreements, eligibility and financing support a next step.",
  },
];

const ukResponses = [
  {
    organisation: "Association for Science Education",
    acronym: "ASE",
    status: "Response received",
    date: "1 October 2026",
    detail:
      "ASE outlined paid consultancy and strategic input that could cover pedagogy, curriculum alignment, SEND and accessibility, and focus groups or prototype testing. Any ASE Evaluated route would depend on its standards. ASE states that it does not endorse products; no consultancy or assessment has been agreed.",
  },
  {
    organisation: "Royal Society of Chemistry",
    acronym: "RSC",
    status: "Response received",
    date: "2 October 2026",
    detail:
      "RSC described the concept as interesting, explained its case-by-case permissions process for reproducing its materials, and said a formal proposal could be shared internally for consideration. RSC does not review or recommend third-party materials; no review, partnership or endorsement is in place.",
  },
  {
    organisation: "Education Endowment Foundation",
    acronym: "EEF",
    status: "Guidance received",
    date: "29 September 2026",
    detail:
      "EEF said the current early-stage project would be most suited to its innovation stage and shared resources on programme development, monitoring and evaluation. This was initial guidance: no funding, independent evaluation, partnership or endorsement was offered.",
  },
];

const romaniaResponses = [
  {
    organisation: "Secretariatul General al Guvernului",
    acronym: "SGG",
    reference: "15D/14040/2026",
    status: "Referred for consideration",
    date: "1 October 2026",
    detail:
      "SGG forwarded the memorandum for competent consideration by the Ministry of Economy, Digitalization, Entrepreneurship and Tourism (Ministerul Economiei, Digitalizării, Antreprenoriatului și Turismului) and the Ministry of Development, Public Works and Administration (Ministerul Dezvoltării, Lucrărilor Publice și Administrației). Substantive ministry responses are pending.",
  },
  {
    organisation: "Ministry of European Investments and Projects",
    acronym: "MIPE",
    reference: "G2026-126328",
    status: "Formally redirected to MADR",
    date: "2 October 2026",
    detail:
      "MIPE replied with general signposting to funding information and formally forwarded the rural-funding petition to the Ministry of Agriculture and Rural Development (MADR) for resolution. A substantive MADR response is pending; the correspondence is not a funding decision.",
  },
];
---

<BaseLayout
  title="Satul Conectat România | Connected Village Romania"
  description="Satul Conectat România is Visio Nova Mundi's proposed Connected Village model combining rural digital inclusion, community connection, tourism, educational access and locally adapted infrastructure."
>
  <section class="sc-hero" aria-labelledby="sc-title">
    <div class="hero-copy">
      <p class="eyebrow">Rural community infrastructure · Romania</p>
      <p class="concept-badge"><span aria-hidden="true"></span>Concept / proposed pilot</p>
      <h1 id="sc-title"><span>SATUL CONECTAT</span><span>ROMÂNIA</span></h1>
      <p class="translation">Connected Village Romania</p>
      <p class="hero-lead">
        A proposed model for connecting rural communities through digital access, local information, education, tourism and human connection.
      </p>
      <p class="hero-context">
        Developed by Visio Nova Mundi as a modular rural inclusion concept. It begins with local needs and a practical community hub—not a promised national rollout.
      </p>
      <div class="hero-actions">
        <a class="sc-button primary" href="#concept">Explore the model <span aria-hidden="true">↓</span></a>
        <a class="sc-button" href="#dialogue">Dialogue to date <span aria-hidden="true">↘</span></a>
      </div>
      <p class="hero-footnote">Proposed first location for discussion: Reci, Covasna County. No pilot agreement, site, funding or deployment is confirmed.</p>
    </div>

    <figure class="network-visual" aria-labelledby="network-caption">
      <div class="visual-header"><span>VISIO NOVA MUNDI / FIELD CONCEPT</span><span>SC · 01</span></div>
      <svg viewBox="70 130 560 330" role="img" aria-labelledby="network-title network-desc">
        <title id="network-title">Connected Village concept network</title>
        <desc id="network-desc">An original schematic of a rural community hub linking homes, local information and learning nodes. It represents a proposed model, not a live network.</desc>
        <defs>
          <linearGradient id="sc-route" x1="0" x2="1" y1="1" y2="0">
            <stop offset="0" stop-color="#2563eb" />
            <stop offset="1" stop-color="#0f9f86" />
          </linearGradient>
          <radialGradient id="sc-hub-glow">
            <stop offset="0" stop-color="#49b9bd" stop-opacity=".3" />
            <stop offset="1" stop-color="#49b9bd" stop-opacity="0" />
          </radialGradient>
        </defs>
        <path class="contour contour-one" d="M25 330c79-40 132-31 199-8s127 18 190-15 144-46 261-11" />
        <path class="contour contour-two" d="M6 373c88-39 154-31 218-7s117 16 179-10 163-39 292-4" />
        <path class="contour contour-three" d="M36 414c76-23 139-17 204 1s118 17 174-4 159-24 258 2" />
        <path class="road" d="M18 284c93 32 142 11 222 31s130 38 218 13 146-35 218-14" />
        <path class="route route-one" d="M130 220c70 1 92 72 174 83" />
        <path class="route route-two" d="M524 181c-78 24-98 76-220 122" />
        <path class="route route-three" d="M534 337c-85 8-130-14-230-34" />
        <path class="route route-four" d="M128 220c4 74 29 101 119 109" />
        <circle class="route-dot dot-a" cx="224" cy="273" r="4" />
        <circle class="route-dot dot-b" cx="430" cy="253" r="4" />
        <circle class="route-dot dot-c" cx="411" cy="319" r="4" />
        <circle class="home-node" cx="127" cy="220" r="32" />
        <circle class="home-node" cx="525" cy="180" r="31" />
        <circle class="home-node" cx="536" cy="337" r="31" />
        <g class="home home-left" transform="translate(112 207)">
          <path d="M0 13 15 0l15 13v20H0z" />
          <path d="M11 33V20h8v13M4 15h22" />
        </g>
        <g class="home home-upper" transform="translate(510 168)">
          <path d="M0 13 15 0l15 13v20H0z" />
          <path d="M11 33V20h8v13M4 15h22" />
        </g>
        <g class="home home-lower" transform="translate(521 325)">
          <path d="M0 13 15 0l15 13v20H0z" />
          <path d="M11 33V20h8v13M4 15h22" />
        </g>
        <circle class="hub-halo" cx="350" cy="309" r="110" fill="url(#sc-hub-glow)" />
        <circle class="hub-orbit" cx="350" cy="309" r="83" />
        <circle class="hub-orbit orbit-inner" cx="350" cy="309" r="62" />
        <circle class="hub-core" cx="350" cy="309" r="44" />
        <path class="hub-building" d="M331 313v-21l19-15 19 15v34h-38z" />
        <path class="hub-door" d="M346 326v-13h9v13" />
        <circle class="module-point point-tourism" cx="350" cy="226" r="7" />
        <circle class="module-point point-learning" cx="420" cy="309" r="7" />
        <circle class="module-point point-info" cx="350" cy="392" r="7" />
        <circle class="module-point point-community" cx="280" cy="309" r="7" />
        <path class="signal signal-one" d="M325 254c15-15 36-15 51 0" />
        <path class="signal signal-two" d="M316 245c20-21 50-21 70 0" />
        <text class="svg-label label-village" x="127" y="274" text-anchor="middle">COMMUNITY</text>
        <text class="svg-label label-hub" x="350" y="380" text-anchor="middle">PROPOSED HUB</text>
        <text class="svg-label label-village label-right" x="530" y="390" text-anchor="middle">LOCAL CONNECTION</text>
      </svg>
      <figcaption id="network-caption"><span class="legend-dot"></span> Schematic concept · connections depend on future local agreements</figcaption>
    </figure>

    <div class="hero-flow" aria-label="Concept flow">
      <span>Village</span><b aria-hidden="true">→</b><span>Hub</span><b aria-hidden="true">→</b><span>People &amp; services</span><b aria-hidden="true">→</b><span>Learning</span><b aria-hidden="true">→</b><span>Connected villages</span>
    </div>
  </section>

  <StatusGovernance stage="Concept / proposed pilot" operator="VNM-developed proposal; future delivery operator and local roles remain to be agreed." delivery="No operating hub or confirmed pilot. Reci is the first proposed location for discussion." funding="No confirmed pilot funding." partnership="Documented correspondence and referrals only; not approval, endorsement or formal partnership." boundary="Local participation, permissions, safeguarding, governance and resources must be agreed before delivery. Clandestinus remains a separate founder venture." />

  <section class="sc-section journey-section" aria-labelledby="journey-title">
    <div class="section-heading">
      <p class="eyebrow">The proposed journey</p>
      <h2 id="journey-title">Pilot first. Validate locally. Expand responsibly.</h2>
      <p>The idea grows in stages: begin with a place, build only what local partners can support, learn from use and consider wider reach only after evidence and agreement.</p>
    </div>
    <ol class="journey-track">
      <li><span class="journey-number">01</span><h3>A village</h3><p>Understand local priorities and barriers.</p></li>
      <li><span class="journey-number">02</span><h3>A hub</h3><p>Shape a modest, accessible shared space.</p></li>
      <li><span class="journey-number">03</span><h3>People &amp; services</h3><p>Connect residents with useful information and support.</p></li>
      <li><span class="journey-number">04</span><h3>Village to village</h3><p>Explore scheduled connections between participating places.</p></li>
      <li><span class="journey-number">05</span><h3>Education</h3><p>Consider school-approved routes to shared learning.</p></li>
      <li><span class="journey-number">06</span><h3>UK + Romania</h3><p>Proposed Phase 1 pilot exploration at equal level.</p></li>
      <li class="future-step"><span class="journey-number">07</span><h3>Potential Europe</h3><p>A future possibility only after validation.</p></li>
    </ol>
  </section>

  <section class="sc-section concept-section" id="concept" aria-labelledby="concept-title">
    <div class="section-heading">
      <p class="eyebrow">01 / The community hub</p>
      <h2 id="concept-title">One local place. Several practical ways to connect.</h2>
      <p>Satul Conectat România proposes a physical community hub with digital tools and locally relevant information. The first discussion is centred on using an existing public space and a small, clearly defined service set.</p>
    </div>
    <div class="hub-layout">
      <div class="hub-core-panel">
        <div class="hub-index">HUB MODEL / CONCEPT 01</div>
        <div class="hub-orbit-art" aria-hidden="true">
          <span class="orbit orbit-a"></span><span class="orbit orbit-b"></span><span class="orbit orbit-c"></span>
          <span class="orbit-node node-a"></span><span class="orbit-node node-b"></span><span class="orbit-node node-c"></span><span class="orbit-node node-d"></span>
          <div class="hub-core-symbol"><span class="core-roof"></span><span class="core-body"></span><span class="core-door"></span></div>
        </div>
        <h3>Connected Village Hub</h3>
        <p>A proposed shared access point—not an assumed building, service or public-system integration.</p>
        <div class="core-tags"><span>Local need</span><span>Agreed access</span><span>Clear operation</span></div>
      </div>
      <div class="hub-module-grid">
        {hubModules.map((module) => (
          <article class="hub-module">
            <span class="module-number">{module.number}</span>
            <div><h3>{module.name}</h3><p>{module.text}</p></div>
          </article>
        ))}
      </div>
    </div>
    <div class="scope-note"><strong>Local configuration matters.</strong> The exact mix would depend on community needs, the chosen location, available infrastructure, permissions, budget, funding rules, procurement and an agreed operating plan. Not every hub would include every module.</div>
    <div class="optional-strip"><span class="optional-label">Possible later options, if suitable</span><p>Vending, showers, laundry, EV charging or additional visitor facilities are not part of the minimum pilot by default. Each would need separate evidence of need, feasibility, permissions, costs and funding eligibility.</p></div>
  </section>

  <section class="sc-section connection-section" aria-labelledby="connection-title">
    <div class="section-heading">
      <p class="eyebrow">02 / Human connection</p>
      <h2 id="connection-title">Distance should not mean disconnection.</h2>
      <p>A distinctive proposal is a “Sat la Sat” connection: people in one participating village could arrange a controlled video session with relatives, friends or community members in another.</p>
    </div>
    <ol class="connection-flow" aria-label="Proposed village-to-village video session">
      <li><span class="flow-icon home-icon" aria-hidden="true">⌂</span><strong>Village A</strong><small>Residents choose to take part</small></li>
      <li><span class="flow-arrow" aria-hidden="true">→</span></li>
      <li><span class="flow-icon hub-icon" aria-hidden="true">◎</span><strong>Connected hub</strong><small>Local access point</small></li>
      <li><span class="flow-arrow" aria-hidden="true">→</span></li>
      <li class="session-node"><span class="flow-icon video-icon" aria-hidden="true">↔</span><strong>Scheduled video</strong><small>Agreed time · controlled access</small></li>
      <li><span class="flow-arrow" aria-hidden="true">→</span></li>
      <li><span class="flow-icon hub-icon" aria-hidden="true">◎</span><strong>Connected hub</strong><small>Participating community</small></li>
      <li><span class="flow-arrow" aria-hidden="true">→</span></li>
      <li><span class="flow-icon home-icon" aria-hidden="true">⌂</span><strong>Village B</strong><small>People meet across distance</small></li>
    </ol>
    <p class="connection-boundary"><strong>This is a proposed service, not an operating network.</strong> Sessions would be scheduled and access-controlled. The concept does not propose a permanent public livestream or continuous video surveillance.</p>
  </section>

  <section class="sc-section learning-section" aria-labelledby="learning-title">
    <div class="section-heading">
      <p class="eyebrow">03 / Education &amp; continuity</p>
      <h2 id="learning-title">Keep learning connected when attendance is interrupted.</h2>
      <p>A possible school-connected model could help a pupil stay linked to learning during a temporary absence, with the school deciding what is appropriate and how it is recognised.</p>
    </div>
    <div class="learning-map" aria-label="Possible school-approved learning pathways">
      <div class="learning-path">
        <div class="learner-node"><span class="person-icon" aria-hidden="true">●</span><strong>Class at school</strong><small>Teacher-led, school-approved activity</small></div>
        <span class="learning-link" aria-hidden="true">↔</span>
        <div class="learning-hub"><span aria-hidden="true">◎</span><strong>Agreed digital access</strong><small>Class space or shared hub, if approved</small></div>
      </div>
      <div class="learning-path">
        <div class="learner-node absent-node"><span class="person-icon" aria-hidden="true">●</span><strong>Pupil temporarily absent</strong><small>At home, in hospital or affected by travel or severe weather</small></div>
        <span class="learning-link" aria-hidden="true">↔</span>
        <div class="learning-hub"><span aria-hidden="true">◎</span><strong>Learning connection</strong><small>Subject to school agreement and available access</small></div>
      </div>
    </div>
    <div class="learning-copy-grid">
      <article class="learning-copy-card">
        <span class="eyebrow">A possible classroom model</span>
        <p>Participating schools could explore secure spaces for classes or year groups where pupils may study together, complete assignments, revise, communicate and take part in approved activities.</p>
      </article>
      <article class="learning-copy-card safeguard-card">
        <span class="eyebrow">School-led safeguards</span>
        <p>Any school connection requires school agreement, appropriate teacher participation, safeguarding, parental or guardian permissions where required, privacy controls and compliance with applicable Romanian education rules. Online activity does not automatically count as attendance or recognised school hours.</p>
      </article>
    </div>

    <div class="clandestinus-panel">
      <div class="education-sequence" aria-hidden="true">
        <span>HUB</span><b>→</b><span>SCHOOL</span><b>→</b><span>CLANDESTINUS</span><b>→</b><span>LEARNING</span>
      </div>
      <div class="clandestinus-copy">
        <p class="eyebrow">A separate educational programme</p>
        <h3>Clandestinus Educational Game &amp; World Academy</h3>
        <p>Being developed as a supplementary learning experience, the proposed programme brings together academic subjects, assignments, tests, examinations, progression, collaborative learning, mystery and investigation. A participating school would decide whether and how any resource is used.</p>
        <p class="separation-note"><strong>Separate projects, separate decisions.</strong> Satul Conectat România is a rural community-infrastructure concept. Clandestinus is an independent creative and educational venture; any school use would require its own agreement and safeguards.</p>
        <div class="clandestinus-actions">
          <a class="sc-button primary" href="https://projectclandestinus.com/project/" target="_blank" rel="noopener noreferrer">Explore Clandestinus Educational Game <span aria-hidden="true">↗</span></a>
          <span>Opens in a new tab</span>
        </div>
      </div>
      <div class="device-note"><span class="device-symbol" aria-hidden="true">▭</span><p><strong>Devices are not promised.</strong> Laptops, connectivity or accessible learning technology could only be explored through an eligible, available and approved funding or partnership route.</p></div>
    </div>
  </section>

  <section class="sc-section pilot-section" aria-labelledby="pilot-title">
    <div class="section-heading">
      <p class="eyebrow">04 / Proposed Romania pilot</p>
      <h2 id="pilot-title">Start small enough to learn well.</h2>
      <p>The first step is to test whether the model answers a real local need and can operate responsibly. A pilot would proceed only after the necessary local decisions, agreements, funding and safeguards.</p>
    </div>
    <div class="pilot-location">
      <div class="location-mark" aria-hidden="true"><span>R</span><i></i></div>
      <div><p class="location-kicker">First proposed location for discussion</p><h3>Reci · Covasna County</h3><p>Reci is identified in the concept materials as the first proposed pilot location—not a confirmed site or participating commune.</p></div>
      <span class="location-status">PROPOSED</span>
    </div>
    <ol class="pilot-steps">
      {pilotSteps.map((step) => (
        <li class="pilot-step">
          <span class="pilot-step-number">{step.number}</span>
          <div><h3>{step.name}</h3><p>{step.text}</p></div>
        </li>
      ))}
    </ol>
    <p class="expansion-note">A later 3–5 locality exploration appears only as a possible future step, subject to evaluation, local agreements, eligibility and financing. The concept does not confirm a national network, a budget or an approved funding route.</p>
  </section>

  <section class="sc-section phase-section" aria-labelledby="phase-title">
    <div class="section-heading">
      <p class="eyebrow">05 / Shared Phase 1</p>
      <h2 id="phase-title">United Kingdom + Romania, at the same level.</h2>
      <p>Clandestinus Educational Game is being explored with a proposed pilot-first approach involving both countries. Neither side is presented as a live or approved pilot.</p>
    </div>
    <div class="phase-nodes">
      <article class="phase-node" data-tilt-card>
        <span class="phase-node-index">01</span>
        <p class="phase-label">Phase 1 · proposed pilot exploration</p>
        <h3>United Kingdom</h3>
        <p>Explore potential educational use with appropriate schools and partners, subject to agreement, evidence, safeguarding and funding.</p>
      </article>
      <div class="phase-join" aria-hidden="true"><span></span><b>SHARED VALIDATION</b><span></span></div>
      <article class="phase-node" data-tilt-card>
        <span class="phase-node-index">02</span>
        <p class="phase-label">Phase 1 · proposed pilot exploration</p>
        <h3>Romania</h3>
        <p>Explore education alongside the proposed rural hub model, subject to local participation, school decisions and the required approvals.</p>
      </article>
    </div>
    <div class="validation-journey" aria-label="Proposed approach to expansion">
      <span>Validate</span><b aria-hidden="true">→</b><span>Refine</span><b aria-hidden="true">→</b><span>Replicable model</span><b aria-hidden="true">→</b><span class="potential">Potential wider EU exploration</span>
    </div>
    <p class="phase-caveat">The Romanian rural hub could become one practical setting for later educational testing, but only with local agreement, school approval, safeguarding, privacy, funding and a defined operating model.</p>
  </section>

  <section class="sc-section dialogue-section" id="dialogue" aria-labelledby="dialogue-title">
    <div class="section-heading">
      <p class="eyebrow">06 / Institutional &amp; sector engagement</p>
      <h2 id="dialogue-title">Dialogue to date</h2>
      <p>The entries below are limited to documented replies. Outreach without a verified response is not shown as institutional engagement.</p>
    </div>
    <div class="response-region">
      <div class="region-heading"><span class="region-marker uk-marker" aria-hidden="true"></span><h3>United Kingdom</h3><span class="region-count">3 documented replies</span></div>
      <div class="response-grid">
        {ukResponses.map((response) => (
          <article class="response-card">
            <div class="response-card-top"><span class="response-acronym">{response.acronym}</span><span class="response-status">{response.status}</span></div>
            <h4>{response.organisation}</h4>
            <p class="response-date">{response.date}</p>
            <p>{response.detail}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="response-region romania-region">
      <div class="region-heading"><span class="region-marker ro-marker" aria-hidden="true"></span><h3>Romania</h3><span class="region-count">2 documented replies</span></div>
      <div class="response-grid romanian-grid">
        {romaniaResponses.map((response) => (
          <article class="response-card">
            <div class="response-card-top"><span class="response-acronym">{response.acronym}</span><span class="response-status referred-status">{response.status}</span></div>
            <h4>{response.organisation}</h4>
            <p class="response-reference">Reference {response.reference}</p>
            <p class="response-date">{response.date}</p>
            <p>{response.detail}</p>
          </article>
        ))}
      </div>
    </div>
    <p class="engagement-boundary">Correspondence, referral, guidance or expressions of interest do not constitute project approval, endorsement, procurement, funding or formal partnership. Formal participation would require separate agreements with the relevant organisations.</p>
  </section>

  <section class="sc-section outcomes-section" aria-labelledby="outcomes-title">
    <div class="section-heading">
      <p class="eyebrow">07 / What a pilot could test</p>
      <h2 id="outcomes-title">Measure practical value before talking about scale.</h2>
      <p>These are intended areas of learning, not results already achieved. Measures would be agreed with local partners and designed to collect only the information needed.</p>
    </div>
    <div class="outcome-grid">
      <article><span>01</span><h3>Digital inclusion</h3><p>Can a shared access point help residents find information or use digital tools with greater confidence?</p></article>
      <article><span>02</span><h3>Connection</h3><p>Do scheduled community links create useful contact without introducing unnecessary data collection?</p></article>
      <article><span>03</span><h3>Education</h3><p>Can school-approved access support learning continuity for pupils who temporarily cannot attend?</p></article>
      <article><span>04</span><h3>Local visibility</h3><p>Could accurate visitor information help residents, local businesses and nearby communities?</p></article>
      <article><span>05</span><h3>Resilient access</h3><p>What access arrangements are useful during severe weather or disruption, and what is feasible to maintain?</p></article>
