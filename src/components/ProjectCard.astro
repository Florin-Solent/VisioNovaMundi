---
import type { PortfolioProject } from "../data/projects";

interface Props {
  project: PortfolioProject;
  order: number;
}

const { project, order } = Astro.props;
const reversed = order % 2 === 1;
---

<article class="project-card" data-reversed={reversed ? "true" : "false"}>
  <a class="project-visual" href={project.href} aria-label={`Explore ${project.title}`}>
    {project.image ? (
      <div class="image-frame" data-has-image="true" data-fit={project.imageFit ?? "contain"}>
        <img src={project.image} alt={project.imageAlt ?? ""} loading={order === 0 ? "eager" : "lazy"} decoding="async" width={project.imageFit === "cover" ? 1536 : undefined} height={project.imageFit === "cover" ? 1024 : undefined} data-project-image />
        {project.imageLabel && <span class="image-label" aria-hidden="true">{project.imageLabel}</span>}
      </div>
    ) : (
      <div class="abstract-visual" data-tone={project.relationship.toLowerCase().includes("cic") || project.relationship.toLowerCase().includes("vnm") ? "community" : project.relationship.toLowerCase().includes("future") ? "future" : "venture"} aria-hidden="true">
        <span class="visual-kicker">Visio Nova Mundi · project</span>
        <span class="visual-mark">{project.visualMark}</span>
        <span class="visual-label">{project.visualLabel}</span>
        <span class="visual-orbit"></span>
      </div>
    )}
  </a>
  <div class="project-copy">
    <p class="project-relationship">{project.relationship}</p>
    <h3><a href={project.href}>{project.title}</a></h3>
    <p class="project-summary">{project.summary}</p>
    <p class="project-relevance"><strong>Potential societal relevance</strong> · {project.relevance}</p>
    <span class="project-status">{project.status}</span>
    <a class="project-link" href={project.href} aria-label={`Explore ${project.title}`}>
      Explore project <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(26px, 5vw, 66px);
    padding: clamp(27px, 4vw, 46px) 0;
    border-bottom: 1px solid var(--border);
  }

  .project-card:first-child { padding-top: 8px; }
  .project-card[data-reversed="true"] .project-visual { order: 2; }
  .project-card[data-reversed="true"] .project-copy { order: 1; }

  .project-visual {
    display: block;
    overflow: hidden;
    aspect-ratio: 1.42;
    border: 1px solid rgba(15, 23, 42, .08);
    border-radius: 22px;
    background: #eef4f8;
    box-shadow: 0 14px 38px rgba(15, 23, 42, .08);
    text-decoration: none;
  }

  .image-frame { position: relative; display: grid; width: 100%; height: 100%; place-items: center; padding: 18px; background: radial-gradient(circle at center, #203651, #091525 76%); }
  .image-frame img { display: block; width: 100%; height: 100%; object-fit: contain; border-radius: 5px; }
  .image-frame[data-fit="cover"] { padding: 0; background: #e8f0f2; }
  .image-frame[data-fit="cover"] img { object-fit: cover; border-radius: 0; }
  .image-label { position: absolute; right: 14px; bottom: 14px; padding: 6px 10px; border: 1px solid rgba(255,255,255,.62); border-radius: 999px; background: rgba(248,252,252,.88); color: #164e56; font-size: .72rem; font-weight: 800; letter-spacing: .015em; line-height: 1.2; backdrop-filter: blur(8px); }

  .abstract-visual {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 230px;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(20px, 3vw, 34px);
    isolation: isolate;
    background: linear-gradient(138deg, #e6f3f2, #f7fafc 57%, #e8effb);
    color: #0f3f55;
  }

  .abstract-visual[data-tone="community"] { background: linear-gradient(138deg, #e2f2ef, #f5faf8 57%, #d9ebf5); color: #0e5a5b; }
  .abstract-visual[data-tone="future"] { background: linear-gradient(138deg, #eeecfb, #faf9fe 57%, #e2eafb); color: #5147a8; }
  .abstract-visual::before, .abstract-visual::after { position: absolute; z-index: -1; content: ""; pointer-events: none; }
  .abstract-visual::before { width: 76%; aspect-ratio: 1; right: -14%; top: -42%; border: 1px solid currentColor; border-radius: 50%; opacity: .17; box-shadow: 0 0 0 24px rgba(255,255,255,.2), 0 0 0 48px rgba(255,255,255,.16), 0 0 0 72px rgba(255,255,255,.12); }
  .abstract-visual::after { width: 65%; height: 1px; right: -4%; bottom: 30%; background: currentColor; opacity: .17; transform: rotate(-29deg); transform-origin: right; }
  .visual-kicker { font-size: .72rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; opacity: .72; }
  .visual-mark { margin-top: auto; font-size: clamp(4.8rem, 11vw, 9rem); font-weight: 800; letter-spacing: -.09em; line-height: .95; opacity: .12; }
  .visual-label { max-width: 23ch; margin-top: -5px; font-size: clamp(1rem, 2vw, 1.28rem); font-weight: 750; letter-spacing: -.025em; }

  .project-copy { min-width: 0; padding: 4px 0; }
  .project-relationship { margin: 0 0 10px; color: #0f766e; font-size: .76rem; font-weight: 850; letter-spacing: .07em; line-height: 1.5; text-transform: uppercase; }
  h3 { margin: 0 0 13px; font-size: clamp(1.55rem, 3vw, 2.2rem); line-height: 1.17; letter-spacing: -.04em; }
  h3 a { color: var(--text); text-decoration: none; text-underline-offset: 5px; }
  h3 a:hover { color: #0f766e; text-decoration: underline; }
  .project-summary, .project-relevance { max-width: 70ch; margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.72; }
  .project-relevance { margin-top: 12px; font-size: .94rem; }
  .project-relevance strong { color: var(--text); font-weight: 750; }
  .project-status { display: inline-flex; max-width: 100%; margin: 18px 12px 0 0; padding: 7px 11px; border: 1px solid rgba(15, 118, 110, .2); border-radius: 999px; background: rgba(15, 118, 110, .055); color: #0f5e58; font-size: .82rem; font-weight: 750; line-height: 1.4; }
  .project-link { display: inline-flex; min-height: 44px; align-items: center; gap: 9px; margin-top: 18px; color: #1d4ed8; font-weight: 800; text-decoration: none; text-underline-offset: 4px; }
  .project-link:hover { text-decoration: underline; }
  .project-link:focus-visible, .project-visual:focus-visible, h3 a:focus-visible { outline: 3px solid #0f766e; outline-offset: 4px; border-radius: 5px; }

  @media (max-width: 720px) {
    .project-card { grid-template-columns: 1fr; gap: 20px; padding: 30px 0 34px; }
    .project-card:first-child { padding-top: 2px; }
    .project-card[data-reversed="true"] .project-visual, .project-card[data-reversed="true"] .project-copy { order: initial; }
    .project-visual { aspect-ratio: 1.55; border-radius: 18px; }
    .abstract-visual { min-height: 200px; padding: 20px; }
    .visual-mark { font-size: 6rem; }
    .project-copy { padding: 0 2px; }
  }

  @media (prefers-reduced-motion: reduce) { .project-visual { scroll-behavior: auto; } }
</style>
