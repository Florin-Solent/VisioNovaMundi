---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectUpdates from "./ProjectUpdates.astro";

interface ProjectSection {
  id: string;
  title: string;
  text: string;
}

interface ProjectLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  title: string;
  description: string;
  statement: string;
  category: string;
  status: string;
  projectKey: string;
  sections: ProjectSection[];
  links: ProjectLink[];
}

const { title, description, statement, category, status, projectKey, sections, links } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="project-detail">
    <header class="detail-hero">
      <p class="detail-category">{category}</p>
      <h1>{title}</h1>
      <p class="detail-statement">{statement}</p>
      <span class="detail-status">{status}</span>
    </header>

    <nav class="section-nav" aria-label={`${title} page sections`}>
      {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
      <a href="#updates">Updates</a>
    </nav>

    <div class="detail-sections">
      {sections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-heading`}>
          <h2 id={`${section.id}-heading`}>{section.title}</h2>
          <p>{section.text}</p>
        </section>
      ))}
    </div>

    <div id="updates"><ProjectUpdates project={projectKey} /></div>

    <nav class="detail-links" aria-label={`${title} related links`}>
      <h2>Relevant links</h2>
      <div class="link-list">
        {links.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>
            {link.label} <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </nav>
  </article>

  <style>
    .project-detail { max-width: 1040px; margin: 0 auto; padding-bottom: 20px; }
    .detail-hero { padding: clamp(27px, 5vw, 55px); border: 1px solid var(--border); border-radius: 26px; background: linear-gradient(135deg, rgba(37,99,235,.075), rgba(16,185,129,.07)); }
    .detail-category { margin: 0 0 10px; color: #0f766e; font-size: .78rem; font-weight: 850; letter-spacing: .09em; text-transform: uppercase; }
    h1 { margin: 0 0 12px; color: var(--text); font-size: clamp(2.4rem, 7vw, 4.3rem); letter-spacing: -.055em; line-height: 1; }
    .detail-statement { max-width: 74ch; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.75; }
    .detail-status { display: inline-flex; margin-top: 21px; padding: 7px 11px; border: 1px solid rgba(15,118,110,.22); border-radius: 999px; background: rgba(255,255,255,.72); color: #0f5e58; font-size: .85rem; font-weight: 800; }
    .section-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; }
    .section-nav a { display: inline-flex; min-height: 40px; align-items: center; padding: 7px 12px; border: 1px solid var(--border); border-radius: 999px; background: rgba(255,255,255,.8); color: var(--text); font-size: .86rem; font-weight: 750; text-decoration: none; }
    .section-nav a:hover, .link-list a:hover { color: #0f766e; text-decoration: underline; text-underline-offset: 4px; }
    .detail-sections { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; margin-top: clamp(26px, 4vw, 42px); }
    .detail-sections section { min-width: 0; padding: 21px; border: 1px solid var(--border); border-radius: 18px; background: rgba(255,255,255,.83); }
    .detail-sections h2, .detail-links h2 { margin: 0 0 8px; color: var(--text); font-size: 1.22rem; letter-spacing: -.025em; }
    .detail-sections p { margin: 0; color: var(--muted); line-height: 1.72; }
    .detail-links { margin-top: 30px; padding: 22px; border: 1px solid var(--border); border-radius: 18px; background: rgba(255,255,255,.75); }
    .link-list { display: flex; flex-wrap: wrap; gap: 12px 22px; }
    .link-list a { color: #1d4ed8; font-weight: 800; text-underline-offset: 4px; }
    @media (max-width: 680px) {
      .detail-hero { border-radius: 21px; }
      .detail-sections { grid-template-columns: 1fr; }
      .detail-sections section { padding: 18px; }
    }
    @media (prefers-reduced-motion: reduce) { .section-nav { scroll-behavior: auto; } }
  </style>
</BaseLayout>
