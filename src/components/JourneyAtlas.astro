---
import countryData from "../data/world-countries-50m.json";
import atlasData from "../data/journey-atlas-destinations.json";
import cityStories from "../data/journey-cultural-stories.json";

const width = 1200;
const height = 620;
const project = (coordinate: number[]) => {
  const [longitude, latitude] = coordinate;
  const lambda = (longitude * Math.PI) / 180;
  const phi = (latitude * Math.PI) / 180;
  const theta = phi;
  const theta2 = theta * theta;
  const theta4 = theta2 * theta2;
  const theta6 = theta4 * theta2;
  const x = lambda * (0.8707 - 0.131979 * theta2 + theta6 * (-0.013791 + theta2 * (0.003971 - 0.001529 * theta2)));
  const y = theta * (1.007226 + theta2 * (0.015085 + theta2 * (-0.044475 + theta2 * (0.028874 - 0.005916 * theta2))));
  // Natural Earth projection x/y units share one scale. The 5.5-unit world extent
  // keeps the full 360° longitude range inside the SVG without stretching.
  return [((x + 2.75) / 5.5) * width, ((1.42 - y) / 2.84) * height];
};

const ringPath = (ring: number[][]) => ring.map((coordinate, index) => {
  const [x, y] = project(coordinate);
  return `${index === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(" ") + " Z";

const geometryPath = (geometry: any) => {
  const polygons = geometry.type === "Polygon" ? [geometry.coordinates] : geometry.coordinates;
  return polygons.flatMap((polygon: number[][][]) => polygon.map(ringPath)).join(" ");
};

const destinations = atlasData.destinations.map((destination: any) => ({
  ...destination,
  xy: project(destination.coordinates),
  years: destination.years || [],
  evidenceSummary: [
    ...(destination.archive?.albumEvidence || []).map((item: any) => item.captureDate ? `photo capture ${item.captureDate}` : item.photoRecordDate ? `Facebook photo record ${item.photoRecordDate}` : item.dateRange ? `album ${item.dateRange}` : ""),
    ...(destination.archive?.mediaPostEvidence || []).flatMap((item: any) => [item.postDate && `post ${item.postDate}`, item.captureDate && `photo ${item.captureDate}`].filter(Boolean)),
  ].filter(Boolean).join("; "),
  searchable: `${destination.name} ${destination.continent} ${destination.countryCode} ${(destination.archive?.checkInLabels || []).join(" ")} ${(destination.archive?.albumEvidence || []).map((item: any) => item.album).join(" ")}`.toLowerCase(),
}));
const recordedCountries = new Set(destinations.map((destination: any) => destination.countryCode));
const countryNames = new Map(countryData.features.map((feature: any) => [feature.properties.iso3, feature.properties.name]));
const countries = countryData.features.map((feature: any) => ({
  ...feature.properties,
  d: geometryPath(feature.geometry),
  recorded: recordedCountries.has(feature.properties.iso3),
}));
const countryLabels = atlasData.countryLabels.map((label: any) => ({ ...label, xy: project(label.coordinates) }));
const years = Array.from({ length: 17 }, (_, index) => 2010 + index);
const countryOptions = [...new Map(destinations.map((destination: any) => [destination.countryCode, destination.countryLabel || (destination.countryCode === "TUR" ? "Türkiye" : countryNames.get(destination.countryCode)) || destination.countryCode])).entries()]
  .sort((a, b) => String(a[1]).localeCompare(String(b[1])));
const oceans = [
  { name: "ARCTIC OCEAN", at: [-35, 72] },
  { name: "NORTH PACIFIC", at: [-145, 20] },
  { name: "SOUTH PACIFIC", at: [150, -35] },
  { name: "ATLANTIC OCEAN", at: [-34, 4] },
  { name: "INDIAN OCEAN", at: [82, -23] },
  { name: "SOUTHERN OCEAN", at: [25, -62] },
].map((label) => ({ ...label, xy: project(label.at) }));
const graticules = [
  ...[-60, -30, 0, 30, 60].map((latitude) => Array.from({ length: 121 }, (_, index) => [index * 3 - 180, latitude])),
  ...[-120, -60, 0, 60, 120].map((longitude) => Array.from({ length: 61 }, (_, index) => [longitude, index * 3 - 90])),
].map((line) => line.map((coordinate, index) => {
  const [x, y] = project(coordinate);
  return `${index === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(" "));
---

<section class="journey-atlas" id="journey-map" aria-labelledby="atlas-title" data-journey-atlas>
  <header class="atlas-heading">
    <p class="atlas-eyebrow">A personal archive · 2010–2026</p>
    <h2 id="atlas-title">Places, held in memory</h2>
        <p class="atlas-intro">Explore places recorded in the archive, with each date identified as a post date, a photo date or a location label.</p>
  </header>

  <div class="atlas-toolbar" aria-label="Filter places in the archive">
    <label class="atlas-control atlas-search" for="atlas-search">
      <span>Find a place</span>
      <input id="atlas-search" type="search" placeholder="Try Trieste, Marrakech or Lisbon" list="atlas-destination-options" autocomplete="off" />
      <datalist id="atlas-destination-options">
        {destinations.map((destination: any) => <option value={destination.name} />)}
      </datalist>
    </label>
    <label class="atlas-control" for="atlas-year">
      <span>Year</span>
      <select id="atlas-year">
        <option value="all">All years</option>
        <option value="undated">Undated archive places</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </label>
    <label class="atlas-control" for="atlas-country">
      <span>Country</span>
      <select id="atlas-country">
        <option value="all">All countries</option>
        {countryOptions.map(([code, name]) => <option value={code}>{name}</option>)}
      </select>
    </label>
    <label class="atlas-control" for="atlas-continent">
      <span>Region</span>
      <select id="atlas-continent">
        <option value="all">All regions</option>
        <option value="Europe">Europe</option>
        <option value="Africa">Africa</option>
        <option value="Asia">Asia</option>
        <option value="North America">North America</option>
      </select>
    </label>
  </div>

  <div class="atlas-main">
    <div class="atlas-map-panel">
      <div class="atlas-map-frame">
        <svg class="atlas-map" viewBox={`0 0 ${width} ${height}`} role="group" aria-labelledby="atlas-map-title atlas-map-description" data-atlas-map>
          <title id="atlas-map-title">World map of places recorded in the travel archive</title>
          <desc id="atlas-map-description">A Natural Earth projection with country outlines and individual location markers. Select a marker or a place in the index to zoom to its location. Archive dates are not automatically treated as visit dates.</desc>
          <rect class="atlas-ocean" x="0" y="0" width={width} height={height} />
          <g class="atlas-graticules" aria-hidden="true">{graticules.map((d) => <path d={d} />)}</g>
          <g class="atlas-country-layer" aria-label="Country boundaries">
            {countries.map((country: any) => <path class:list={["atlas-country", { "is-recorded": country.recorded }]} d={country.d} data-country={country.iso3} aria-label={country.name}><title>{country.name}</title></path>)}
          </g>
          <g class="atlas-ocean-labels" aria-hidden="true">
            {oceans.map((ocean) => <text x={ocean.xy[0]} y={ocean.xy[1]}>{ocean.name}</text>)}
          </g>
          <g class="atlas-country-labels" aria-hidden="true">
            {countryLabels.map((label: any) => <text x={label.xy[0]} y={label.xy[1]} data-country-label={label.countryCode}>{label.name}</text>)}
          </g>
          <g class="atlas-marker-layer" aria-label="Archive place markers">
            {destinations.map((destination: any) => (
              <a class="atlas-marker" href={`#atlas-story-${destination.id}`} aria-label={`Select ${destination.name}, ${destination.years.length ? `archive years ${destination.years.join(", ")}` : "date not available"}`} data-atlas-marker={destination.id} data-name={destination.name} data-search={destination.searchable} data-country-code={destination.countryCode} data-continent={destination.continent} data-years={destination.years.join(" ")} data-evidence={destination.evidenceSummary || destination.archive?.dateBasis || "Location reference only; date not confirmed"} data-x={destination.xy[0].toFixed(1)} data-y={destination.xy[1].toFixed(1)}>
                <circle class="atlas-marker-hit" cx={destination.xy[0]} cy={destination.xy[1]} r="14" />
                <circle class="atlas-marker-glow" cx={destination.xy[0]} cy={destination.xy[1]} r="7" />
                <circle class="atlas-marker-dot" cx={destination.xy[0]} cy={destination.xy[1]} r="3.2" />
                <title>{destination.name} · {destination.years.length ? destination.years.join(", ") : "date not available"}</title>
              </a>
            ))}
          </g>
        </svg>
        <div class="atlas-zoom" aria-label="Map zoom controls">
          <button type="button" data-atlas-zoom-in aria-label="Zoom in">+</button>
          <button type="button" data-atlas-zoom-out aria-label="Zoom out">−</button>
          <button type="button" data-atlas-reset aria-label="Show the whole world">World</button>
        </div>
        <label class="atlas-country-label-toggle"><input type="checkbox" data-atlas-country-labels /> <span>Country labels</span></label>
      </div>
      <p class="atlas-map-caption">The map uses the Natural Earth projection and locally bundled Natural Earth 1:50m country outlines. Pins are place references from the archive, not precise photo locations. No route lines are drawn between places.</p>
    </div>

    <aside class="atlas-selected" aria-live="polite" aria-atomic="true" data-atlas-selected>
      <p class="atlas-eyebrow">Selected place</p>
      <h3 data-atlas-selected-name>Choose a marker</h3>
      <p class="atlas-selected-meta" data-atlas-selected-meta>Use a map marker or browse the destination index.</p>
      <p data-atlas-selected-note>Archive post dates and photo capture dates are shown separately. A location tag by itself does not establish a visit date.</p>
      <a class="atlas-story-link" data-atlas-story-link href="#atlas-stories" hidden>Read this city chapter <span aria-hidden="true">↗</span></a>
    </aside>
  </div>

  <div class="atlas-bottom-row">
    <details class="atlas-index-details">
      <summary>Browse the {destinations.length}-place archive index</summary>
      <div class="atlas-index-tools"><p>Choose a place to zoom in and review its archive evidence.</p><p class="atlas-results-count" data-atlas-count aria-live="polite"></p></div>
      <ul class="atlas-index" data-atlas-index>
        {destinations.map((destination: any) => (
          <li data-atlas-index-item data-name={destination.name} data-search={destination.searchable} data-country-code={destination.countryCode} data-continent={destination.continent} data-years={destination.years.join(" ")}>
            <button type="button" data-atlas-select={destination.id}>
              <span>{destination.name}</span>
              <small>{destination.years.length ? destination.years.join(" · ") : "date not available"}</small>
            </button>
          </li>
        ))}
      </ul>
      <p class="atlas-empty" data-atlas-empty hidden>No places match those filters.</p>
    </details>
    <p class="atlas-evidence-note"><strong>Reading the dates:</strong> years beside markers refer to archive evidence. For videos without capture timestamps, the map uses the Facebook post date and labels it as such. Dates in the index do not by themselves prove the exact day of a visit.</p>
  </div>

  <section class="atlas-stories" id="atlas-stories" aria-labelledby="atlas-stories-title">
    <div class="atlas-stories-heading">
      <p class="atlas-eyebrow">Cultural chapters · places and perspectives</p>
      <h3 id="atlas-stories-title">The archive opens a door</h3>
      <p>Each chapter begins with what my archive records. Place history adds context; I leave memories, meals and moments the files cannot prove to my own recollection.</p>
    </div>
    {cityStories.map((story: any, index: number) => (
      <article class="atlas-story" id={`atlas-story-${story.id}`}>
        <span class="atlas-story-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <details class="atlas-story-detail">
          <summary><span class="atlas-story-name">{story.name}</span><span class="atlas-story-year">{story.yearLabel}</span></summary>
          <div class="atlas-story-body">
            <p class="atlas-story-archive">{story.firstPerson || story.archiveSummary}</p>
            {story.sections?.map((section: any) => <section class="atlas-story-section"><h5>{section.heading}</h5><p>{section.text}</p></section>)}
            {!story.sections?.length && story.narrative && <section class="atlas-story-section"><h5>Place context</h5><p>{story.narrative}</p></section>}
            {story.sources?.length > 0 && <div class="atlas-sources" aria-label={`Cultural sources for ${story.name}`}>
              {story.sources.map((source: any) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span aria-hidden="true">↗</span></a>)}
            </div>}
            <button class="atlas-story-map-link" type="button" data-atlas-select={story.mapId || story.id}>
              Locate on the world map <span aria-hidden="true">↗</span>
            </button>
          </div>
        </details>
      </article>
    ))}
  </section>

  <p class="atlas-attribution">Cartographic data: <a href="https://www.naturalearthdata.com/downloads/50m-cultural-vectors/" target="_blank" rel="noreferrer">Natural Earth 1:50m Admin 0 Countries</a>, shown with its de facto cartographic boundaries; <a href="https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-populated-places/" target="_blank" rel="noreferrer">Natural Earth populated places</a> supplies city reference coordinates. Map data is bundled locally. The map is an orientation tool, not street navigation or a record of travel routes.</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-journey-atlas]");
  if (root) {
    const map = root.querySelector<SVGSVGElement>("[data-atlas-map]");
    const search = root.querySelector<HTMLInputElement>("#atlas-search");
    const year = root.querySelector<HTMLSelectElement>("#atlas-year");
    const country = root.querySelector<HTMLSelectElement>("#atlas-country");
    const continent = root.querySelector<HTMLSelectElement>("#atlas-continent");
    const countryLabelsToggle = root.querySelector<HTMLInputElement>("[data-atlas-country-labels]");
    const markers = Array.from(root.querySelectorAll<SVGAElement>("[data-atlas-marker]"));
    const indexItems = Array.from(root.querySelectorAll<HTMLElement>("[data-atlas-index-item]"));
    const selectedName = root.querySelector<HTMLElement>("[data-atlas-selected-name]");
    const selectedMeta = root.querySelector<HTMLElement>("[data-atlas-selected-meta]");
    const selectedLink = root.querySelector<HTMLAnchorElement>("[data-atlas-story-link]");
    const count = root.querySelector<HTMLElement>("[data-atlas-count]");
    const empty = root.querySelector<HTMLElement>("[data-atlas-empty]");
    const total = markers.length;
    const full = { x: 0, y: 0, width: 1200, height: 620 };
    let current = { ...full };

    const applyFilters = () => {
      const query = (search?.value || "").trim().toLowerCase();
      const selectedYear = year?.value || "all";
      const selectedCountry = country?.value || "all";
      const selectedContinent = continent?.value || "all";
      let shown = 0;
      const visible = (element: HTMLElement | SVGAElement) => {
        const names = `${element.getAttribute("data-name") || ""} ${element.getAttribute("data-search") || ""}`.toLowerCase();
        const countryCode = element.getAttribute("data-country-code");
        const region = element.getAttribute("data-continent");
        const years = (element.getAttribute("data-years") || "").split(/\s+/).filter(Boolean);
        return (!query || names.includes(query))
          && (selectedYear === "all" || (selectedYear === "undated" ? years.length === 0 : years.includes(selectedYear)))
          && (selectedCountry === "all" || countryCode === selectedCountry)
          && (selectedContinent === "all" || region === selectedContinent);
      };
      markers.forEach((marker) => {
        const show = visible(marker);
        marker.classList.toggle("is-filtered-out", !show);
        if (show) shown += 1;
      });
      indexItems.forEach((item) => {
        const show = visible(item);
        item.hidden = !show;
      });
      const visibleCountries = new Set(markers.filter((marker) => !marker.classList.contains("is-filtered-out")).map((marker) => marker.getAttribute("data-country-code")));
      root.querySelectorAll<SVGPathElement>("[data-country]").forEach((shape) => shape.classList.toggle("is-filtered-out", !visibleCountries.has(shape.getAttribute("data-country"))));
      if (count) count.textContent = `${shown} of ${total} places`;
      if (empty) empty.hidden = shown !== 0;
    };

    const setViewBox = (next: typeof full) => {
      if (!map) return;
      current = { ...next };
      map.setAttribute("viewBox", `${next.x.toFixed(1)} ${next.y.toFixed(1)} ${next.width.toFixed(1)} ${next.height.toFixed(1)}`);
      root.classList.toggle("is-zoomed", next.width < full.width * 0.92);
    };

    const zoomAround = (x: number, y: number, factor: number) => {
      const width = Math.max(165, Math.min(full.width, current.width / factor));
      const height = Math.max(86, Math.min(full.height, current.height / factor));
      const xRatio = (x - current.x) / current.width;
      const yRatio = (y - current.y) / current.height;
      let nextX = x - xRatio * width;
      let nextY = y - yRatio * height;
      nextX = Math.max(0, Math.min(full.width - width, nextX));
      nextY = Math.max(0, Math.min(full.height - height, nextY));
      setViewBox({ x: nextX, y: nextY, width, height });
    };

    const selectPlace = (id: string, zoom = true) => {
      const marker = markers.find((item) => item.dataset.atlasMarker === id);
      if (!marker) return;
      markers.forEach((item) => item.classList.toggle("is-selected", item === marker));
      const name = marker.dataset.name || "Selected place";
      const years = marker.dataset.years?.split(/\s+/).filter(Boolean) || [];
      const countryName = root.querySelector<HTMLOptionElement>(`#atlas-country option[value="${marker.dataset.countryCode}"]`)?.textContent || "";
      if (selectedName) selectedName.textContent = name;
      const evidence = marker.dataset.evidence || "Archive date not available";
      if (selectedMeta) selectedMeta.textContent = `${countryName}${years.length ? ` · archive years ${years.join(", ")}` : " · archive date not available"} · ${evidence}`;
      if (years.length && year) { year.value = years[0]; applyFilters(); document.dispatchEvent(new CustomEvent("vnm:atlas-year-selected", { detail: { year: years[0] } })); }
      if (selectedLink) {
        selectedLink.href = `#atlas-story-${id}`;
        selectedLink.hidden = !root.querySelector(`#atlas-story-${id}`);
      }
      if (zoom && marker.dataset.x && marker.dataset.y) zoomAround(Number(marker.dataset.x), Number(marker.dataset.y), 3.2);
    };

    search?.addEventListener("input", applyFilters);
    search?.addEventListener("change", () => {
      const match = markers.find((marker) => marker.dataset.name?.toLowerCase() === search.value.trim().toLowerCase());
      if (match?.dataset.atlasMarker) selectPlace(match.dataset.atlasMarker);
    });
    year?.addEventListener("change", applyFilters);
    year?.addEventListener("change", () => document.dispatchEvent(new CustomEvent("vnm:atlas-year-selected", { detail: { year: year.value } })));
    country?.addEventListener("change", applyFilters);
    continent?.addEventListener("change", applyFilters);
    countryLabelsToggle?.addEventListener("change", () => root.classList.toggle("show-country-labels", Boolean(countryLabelsToggle.checked)));

    markers.forEach((marker) => marker.addEventListener("click", (event) => {
      event.preventDefault();
      if (marker.dataset.atlasMarker) selectPlace(marker.dataset.atlasMarker);
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-atlas-select]").forEach((button) => button.addEventListener("click", () => {
      const id = button.dataset.atlasSelect;
      if (id) selectPlace(id);
    }));
    root.querySelector<HTMLButtonElement>("[data-atlas-zoom-in]")?.addEventListener("click", () => zoomAround(current.x + current.width / 2, current.y + current.height / 2, 1.35));
    root.querySelector<HTMLButtonElement>("[data-atlas-zoom-out]")?.addEventListener("click", () => zoomAround(current.x + current.width / 2, current.y + current.height / 2, 1 / 1.35));
    root.querySelector<HTMLButtonElement>("[data-atlas-reset]")?.addEventListener("click", () => setViewBox(full));

    applyFilters();
    document.addEventListener("vnm:year-selected", ((event: CustomEvent<{ year: string }>) => {
      if (year && year.value !== event.detail.year) { year.value = event.detail.year; applyFilters(); }
    }) as EventListener);
  }
</script>

<style>
  .journey-atlas{--atlas-ink:#f8fafc;--atlas-muted:#c9d8dd;--atlas-accent:#2563eb;--atlas-deep:#102741;--atlas-land:#244858;--atlas-land-hot:#2563eb;--atlas-line:#385363;position:relative;padding:clamp(5rem,10vw,10rem) clamp(1.15rem,5vw,5rem);background:radial-gradient(ellipse at 53% 34%,#112b38 0%,#112b38 47%,#102741 100%);color:var(--atlas-ink);overflow:hidden}
  .journey-atlas:before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,#2563eb06 62%,transparent 78%);pointer-events:none}
  .atlas-heading,.atlas-toolbar,.atlas-main,.atlas-bottom-row,.atlas-stories,.atlas-attribution{position:relative;z-index:1;max-width:1440px;margin-inline:auto}
  .atlas-heading{max-width:900px;margin-bottom:2.5rem}
  .atlas-eyebrow{margin:0 0 .8rem;color:var(--atlas-accent);font-size:.7rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase}
  .atlas-heading h2{max-width:780px;margin:0;color:var(--atlas-ink);font-family:var(--font-display,Georgia,serif);font-size:clamp(2.8rem,7vw,6.4rem);font-weight:400;line-height:.95;letter-spacing:-.04em}
  .atlas-intro{max-width:760px;margin:1.35rem 0 0;color:#c9d8dd;font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.75}
  .atlas-toolbar{display:grid;grid-template-columns:minmax(220px,2fr) repeat(3,minmax(130px,1fr));gap:.75rem;margin-bottom:1rem;padding:1rem;border:1px solid #c9d8dd24;background:#2563eb06;backdrop-filter:blur(14px)}
  .atlas-control{display:grid;gap:.4rem;color:var(--atlas-muted);font-size:.72rem;letter-spacing:.11em;text-transform:uppercase}
  .atlas-control input,.atlas-control select{width:100%;min-height:44px;border:1px solid #c9d8dd30;border-radius:2px;background:#112b38;color:var(--atlas-ink);padding:.65rem .75rem;font:inherit;font-size:.9rem;letter-spacing:normal;text-transform:none}
  .atlas-control input::placeholder{color:#3e556380}
  .atlas-control input:focus-visible,.atlas-control select:focus-visible,.atlas-zoom button:focus-visible,.atlas-country-label-toggle input:focus-visible,.atlas-index button:focus-visible,.atlas-story-map-link:focus-visible{outline:2px solid var(--atlas-accent);outline-offset:3px}
  .atlas-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,320px);gap:1rem;align-items:stretch}
  .atlas-map-panel{min-width:0}
  .atlas-map-frame{position:relative;overflow:hidden;border:1px solid #c9d8dd3a;background:#102741;box-shadow:0 30px 90px #0007}
  .atlas-map{display:block;width:100%;height:auto;aspect-ratio:1200/620;touch-action:pan-y;user-select:none}
  .atlas-ocean{fill:#102741}
  .atlas-graticules path{fill:none;stroke:#c9d8dd;stroke-opacity:.075;stroke-width:.8;vector-effect:non-scaling-stroke}
  .atlas-country{fill:var(--atlas-land);stroke:var(--atlas-line);stroke-opacity:.54;stroke-width:.55;vector-effect:non-scaling-stroke;transition:fill .35s ease,opacity .2s ease}
  .atlas-country.is-recorded{fill:var(--atlas-land-hot);stroke:#e3eef0;stroke-opacity:.7}
  .atlas-country.is-filtered-out{opacity:.18}
  .atlas-ocean-labels text{fill:#c9d8dd;fill-opacity:.52;font-size:9px;letter-spacing:2px;text-anchor:middle;pointer-events:none}
