# Fingerprinted build assets can be cached for repeat visits.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable media URLs may be updated in future releases, so use a shorter cache.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Keep non-production Pages previews out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
